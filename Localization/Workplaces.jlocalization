    {
      "Name": "AutomaticNodeRefreshExtension_Description",
      "Strings": [
        {
          "Culture": "en",
          "Value": "Automatically refreshes current node, and all its opened child nodes in the workplace, and also tables to the right of the tree with specified frequency."
