{
  "Alias": "FileSignatures",
  "Caption": "NewView{202dd85c-45f5-4967-a92a-303af094d1a1}",
  "GroupName": "Testing",
  "ID": "202dd85c-45f5-4967-a92a-303af094d1a1",
  "JsonMetadataSource::txt": "FileSignatures JSONMETA",
  "MsQuerySource::txt": "FileSignatures MSSQL",
  "PgQuerySource::txt": "FileSignatures PGSQL"
}

[TEXTPART FileSignatures JSONMETA]
{
  "Alias": "FileSignatures",
  "Caption": "NewView{202dd85c-45f5-4967-a92a-303af094d1a1}",
  "Columns": [
    {
      "Alias": "ID",
      "Type": "$FileSignatures.ID"
    },
    {
      "Alias": "RowID",
      "Type": "$FileSignatures.RowID"
    },
    {
      "Alias": "VersionRowID",
      "Type": "$FileSignatures.VersionRowID"
    },
    {
      "Alias": "SerialNumber",
      "Type": "$FileSignatures.SerialNumber"
    },
    {
      "Alias": "IssuerName",
      "Type": "$FileSignatures.IssuerName"
    },
    {
      "Alias": "UserName",
      "Type": "$FileSignatures.UserName"
    },
    {
      "Alias": "Signed",
      "Type": "$FileSignatures.Signed"
    },
    {
      "Alias": "FileName",
      "Type": "$Files.Name"
    },
    {
      "Alias": "EventID",
      "Type": "$FileSignatures.EventID"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART FileSignatures MSSQL]


[TEXTPART FileSignatures PGSQL]
select
	fs."ID",
	fs."RowID",
	fs."VersionRowID",
	fs."SerialNumber",
	fs."IssuerName",
	fs."UserName",
	fs."Signed",
	f."Name",
	fs."EventID"
from
	"FileSignatures" as fs, "Files" as f
where
	fs."ID"=f."RowID" 
	and f."ID"='9c2b0bed-f6f0-42d7-9939-300cb50fe6c4'
	--f."VersionRowID"='adc4d661-f84d-4956-8efa-9c0ce11cf723'
	--and fs."SerialNumber"='00F3CE4735A7E3E7F1B0D9334E44FBAFD2'
	and fs."Signed">'22.02.2024'
limit 20
