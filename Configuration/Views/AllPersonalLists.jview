{
  "Alias": "AllPersonalLists",
  "Caption": "Личные списки",
  "GroupName": "Junicsoft",
  "ID": "6d6458ac-06f3-4268-981f-ffd1b23d8aa3",
  "JsonMetadataSource::txt": "AllPersonalLists JSONMETA",
  "MsQuerySource::txt": "AllPersonalLists MSSQL",
  "PgQuerySource::txt": "AllPersonalLists PGSQL"
}

[TEXTPART AllPersonalLists JSONMETA]
{
  "Alias": "AllPersonalLists",
  "Caption": "Личные списки",
  "Columns": [
    {
      "Alias": "PLID",
      "Caption": "ID",
      "Hidden": true,
      "Type": "$PersonalList.ID"
    },
    {
      "Alias": "PLTitle",
      "Caption": "Наименование",
      "SortBy": "PLTitle",
      "Type": "$PersonalList.Title"
    },
    {
      "Alias": "PLOwnerID",
      "Hidden": true,
      "Type": "$PersonalList.OwnerID"
    },
    {
      "Alias": "PLOwnerName",
      "Caption": "Владелец",
      "SortBy": "PLOwnerName",
      "Type": "$PersonalList.OwnerName"
    },
    {
      "Alias": "PLStatus",
      "Caption": "Статус",
      "SortBy": "PLStatus",
      "Type": "String(Max) Null"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "PLTitle",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "PageLimit": 40,
  "Paging": "Optional",
  "Parameters": [
    {
      "Alias": "Title",
      "Caption": "Наименование",
      "Multiple": false,
      "RefSection": [
        "MyPersonalLists"
      ],
      "Type": "$PersonalList.Title"
    },
    {
      "Alias": "Status",
      "Caption": "Показать не активные списки",
      "Multiple": false,
      "Type": "Boolean Not Null"
    },
    {
      "Alias": "CheckLinkedStatic",
      "Caption": "Показать списки без статической роли",
      "Multiple": false,
      "Type": "Boolean Not Null"
    },
    {
      "Alias": "Owner",
      "Caption": "Владелец",
      "Multiple": false,
      "RefSection": [
        "PersonalRoles"
      ],
      "Type": "$PersonalList.OwnerID"
    }
  ],
  "QuickSearchParam": "Status",
  "References": [
    {
      "ColPrefix": "PL",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "AllPersonalLists"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count",
      "CountColumn": "cnt",
      "HideZeroCount": true
    }
  ]
}

[TEXTPART AllPersonalLists MSSQL]


[TEXTPART AllPersonalLists PGSQL]
SELECT
#if(Normal) {
	pl."ID" as "PLID",
    pl."Title" as "PLTitle",
    pl."OwnerID" as "PLOwnerID",
    pl."OwnerName" as "PLOwnerName",
    CASE 
    WHEN "Status" = false 
    	THEN 'Активна'
    	ELSE 'Не активна'
    END AS "PLStatus"
}
#if(Count) { 
	COUNT(*) as cnt
}

FROM "PersonalList" as pl
WHERE 1=1
#param(Title, pl."Title")
#param(Owner, pl."OwnerID")
#if(CheckLinkedStatic) { 
	AND pl."LinkedStaticRoleID" is null
}

#if(!Status) { 
	AND "Status" = false --OR "Status" = true
}
#if(Normal) { 
order by #order_by} 

#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit);
}
