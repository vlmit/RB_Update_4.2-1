[TEXTPART FileLoadingTokensForCard MSSQL]
SELECT
  [tk].[Scope],
  [tk].[Created],
  [tk].[Expires],
  [tk].[CreatedByID],
  [tk].[FileID],
  [tk].[FileName],
  [tk].[UserID],
  [tk].[Hash],
  [tk].[MaskedID] AS [ID]
FROM (
  SELECT 
    [tk].[ID],
    CONCAT(SUBSTRING([tk].[ID],1,3), '...', SUBSTRING([tk].[ID],LEN([tk].[ID])-2,3)) AS [MaskedID],
    [tk].[Scope],
    [tk].[Created],
    [tk].[Expires],
    [tk].[CreatedByID],
    [tk].[RefID] AS [FileID],
    [tk].[Description] AS [FileName],
    [tk].[UserID],
    CONVERT([VARCHAR](MAX), [tk].[TokenHash], 2) AS [Hash]
  FROM [Tokens] AS [tk] WITH (NOLOCK)
  WHERE [tk].[TypeID] = 4 -- File
  	AND [tk].[Options] LIKE CONCAT('%"CardID":"', #param(CardID), '"%')
    #param(FileName, [tk].[Description])
    #param(Created, [tk].[Created])
    #param(Expires, [tk].[Expires])
    #if(!Administrator) { 
    #param(CurrentUserID, [tk].[CreatedByID]) 
    }
) AS [tk]
WHERE 1=1
  #param(ID, [tk].[MaskedID])
  #param(Scope, [tk].[Scope])
  #param(Hash, [tk].[Hash])
  #param(CreatedByID, [tk].[CreatedByID])
  #param(UserID, [tk].[UserID])
ORDER BY #order_by

[TEXTPART FileLoadingTokensForCard PGSQL]
SELECT
  "tk"."Scope",
  "tk"."Created",
  "tk"."Expires",
  "tk"."CreatedByID",
  "tk"."FileID",
  "tk"."FileName",
  "tk"."UserID",
  "tk"."Hash",
  "tk"."MaskedID" AS "ID"
FROM (
  SELECT 
    "tk"."ID",
    (substring("tk"."ID" from 1 for 3) || '...' || substring("tk"."ID" from length("tk"."ID")-2 for 3)) AS "MaskedID",
    "tk"."Scope",
    "tk"."Created",
    "tk"."Expires",
    "tk"."CreatedByID",
    "tk"."RefID" AS "FileID",
    "tk"."Description" AS "FileName",
    "tk"."UserID",
    encode("tk"."TokenHash", 'hex') AS "Hash"
  FROM "Tokens" AS "tk"
  WHERE "tk"."TypeID" = 4 -- File
  	AND "Options"->>'CardID' = #param(CardID)::text
    #param(FileName, "tk"."Description")
    #param(Created, "tk"."Created")
    #param(Expires, "tk"."Expires")
    #if(!Administrator) { 
    #param(CurrentUserID, "tk"."CreatedByID") 
    }
) AS "tk"
WHERE 1=1
  #param(ID, "tk"."MaskedID")
  #param(Scope, lower("tk"."Scope"))
  #param(Hash, "tk"."Hash")
  #param(CreatedByID, "tk"."CreatedByID")
  #param(UserID, "tk"."UserID")
ORDER BY #order_by