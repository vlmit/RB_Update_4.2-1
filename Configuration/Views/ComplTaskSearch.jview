{
  "Alias": "ComplTaskSearch",
  "Caption": "Поиск завершенных задач",
  "GroupName": "Testing",
  "ID": "fa083a6a-7344-4cfb-aaa0-37f4336a9b17",
  "JsonMetadataSource::txt": "ComplTaskSearch JSONMETA",
  "MsQuerySource::txt": "ComplTaskSearch MSSQL",
  "PgQuerySource::txt": "ComplTaskSearch PGSQL"
}

[TEXTPART ComplTaskSearch JSONMETA]
{
  "Alias": "ComplTaskSearch",
  "Caption": "Поиск завершенных задач",
  "Columns": [
    {
      "Alias": "ID",
      "Type": "$TaskHistory.ID"
    },
    {
      "Alias": "RowID",
      "Type": "$TaskHistory.RowID"
    },
    {
      "Alias": "ParentRowID",
      "Type": "$TaskHistory.ParentRowID"
    },
    {
      "Alias": "Created",
      "SortBy": "Created",
      "Type": "$TaskHistory.Created"
    },
    {
      "Alias": "AuthorName",
      "Type": "$TaskHistory.AuthorName"
    },
    {
      "Alias": "Completed",
      "SortBy": "Completed",
      "Type": "$TaskHistory.Completed"
    },
    {
      "Alias": "TypeCaption",
      "Caption": "Тип задания",
      "Localizable": true,
      "Type": "$TaskHistory.TypeCaption"
    },
    {
      "Alias": "OptionCaption",
      "Caption": "Вариант завершения",
      "Localizable": true,
      "Type": "$TaskHistory.OptionCaption"
    },
    {
      "Alias": "RoleName",
      "Caption": "На кого назначено",
      "Type": "$TaskHistory.RoleName"
    },
    {
      "Alias": "UserName",
      "Caption": "Взял или завершил",
      "Type": "$TaskHistory.UserName"
    },
    {
      "Alias": "CompletedByName",
      "Caption": "Завершил",
      "Type": "$TaskHistory.CompletedByName"
    },
    {
      "Alias": "Result",
      "Type": "$TaskHistory.Result"
    },
    {
      "Alias": "ProcessName",
      "Hidden": true,
      "Type": "$TaskHistory.ProcessName"
    },
    {
      "Alias": "KindCaption",
      "Hidden": true,
      "Type": "$TaskHistory.KindCaption"
    },
    {
      "Alias": "Caption",
      "Localizable": true,
      "MaxLength": 100,
      "Type": "$TaskHistoryGroups.Caption"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "Created",
      "SortDirection": "Descending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART ComplTaskSearch MSSQL]


[TEXTPART ComplTaskSearch PGSQL]
select
	"t"."ID",
	"t"."RowID",
	"t"."ParentRowID",
	"Created",
	"AuthorName",
	"Completed",
	"TypeCaption",
	"OptionCaption",
	"RoleName",
	"UserName",
	"CompletedByName",
	"Result",
	"ProcessName",
	"KindCaption",
	"thg"."Caption"
from
	"TaskHistory" as "t",
	"TaskHistoryGroups" as "thg"
where
	true
	--and "t"."ID"='4d76f9a3-59d2-4a38-bb1f-3d8a7095ce98'
	and "t"."RowID"='bde7ca69-479f-4261-b5a1-545460ac9a09'
	--and "t"."ParentRowID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
	and "t"."GroupRowID"="thg"."RowID"
order by #order_by
