  "JsonMetadataSource::txt": "TaskTextTemplate JSONMETA",
  "MsQuerySource::txt": "TaskTextTemplate MSSQL",
  "PgQuerySource::txt": "TaskTextTemplate PGSQL"
}

[TEXTPART TaskTextTemplate JSONMETA]
{
  "Alias": "TaskTextTemplate",
  "Caption": "Шаблон текста поручения",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$Partners.ID"
    },
    {
      "Alias": "TypeName",
      "Caption": "Шаблон текста поручения",
      "Type": "$Partners.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "TaskTextTemplateName",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$PartnersTypes.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "RefSection": [
        "TaskTextTemplates"
      ]
    }
  ]
}

[TEXTPART TaskTextTemplate MSSQL]


[TEXTPART TaskTextTemplate PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "TaskTextTemplate" AS "pt"

WHERE true
	#param(TaskTextTemplateName, "pt"."Name")
ORDER BY "pt"."ID"
