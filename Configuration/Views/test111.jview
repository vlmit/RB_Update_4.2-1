{
  "Alias": "test111",
  "Caption": "test",
  "GroupName": "Custom",
  "ID": "2fce00cf-bea0-4bef-8fb2-710bc9f12a5b",
  "JsonMetadataSource::txt": "test111 JSONMETA",
  "MsQuerySource::txt": "test111 MSSQL",
  "PgQuerySource::txt": "test111 PGSQL"
}

[TEXTPART test111 JSONMETA]
{
  "Alias": "test111",
  "Caption": "test",
  "Columns": [
    {
      "Alias": "DocID",
      "Caption": "ID",
      "Type": "Guid Null"
    },
    {
      "Alias": "DocFullNumber",
      "Caption": "FullNumber",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "CreationDate",
      "Caption": "CreationDate",
      "Type": "DateTime Null"
    },
    {
      "Alias": "ParentDescription",
      "Caption": "ParentDescription",
      "Type": "String(Max) Null"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "References": [
    {
      "ColPrefix": "Doc",
      "DisplayValueColumn": "DocFullNumber",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "DocumentCommonInfo",
        "DocRefsSection"
      ]
    }
  ]
}

[TEXTPART test111 MSSQL]


[TEXTPART test111 PGSQL]
select "dci"."ID" as "DocID",
"dci"."FullNumber" as "DocFullNumber",
"dci"."CreationDate",
"dci"."ParentDescription"

from "DocumentCommonInfo" as "dci"
where "dci"."CardTypeID" = '01ad498e-5f8e-417a-bd28-942739dbf342'
and "dci"."CategoryID" = '30f938ba-3db0-42e7-8dba-0f0d492e5726'
and "dci"."RegistratorID" = '1d701dbe-717e-4a7d-878c-084e2e9f8a14' -- мельников создатель
--and "dci"."AuthorID" = 'f641cbb0-996a-4c34-aadb-2e3d3f733146'
order by "dci"."CreationDate" desc
