[TEXTPART TestRoles JSONMETA]
{
  "Alias": "TestRoles",
  "Caption": "NewView{1c49414d-6743-442c-9877-daa076a85ed6}",
  "Columns": [
    {
      "Alias": "ID",
      "Type": "$RoleUsers.UserID"
    },
    {
      "Alias": "UserName",
      "Type": "$RoleUsers.UserName"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART TestRoles MSSQL]


[TEXTPART TestRoles PGSQL]
SELECT distinct "ru"."UserID", "ru"."UserName"
FROM "RoleUsers" as "ru"
Inner Join "DocumentCommonInfo" as "dci" on "dci"."ControllerID" = "ru"."ID"
WHERE "dci"."ParentID" ='fd489038-478d-44df-b855-0f36055bbba2'
--AND "ru"."UserID" ='18a0d343-fea7-45ce-8792-33b2c0a88e46'

