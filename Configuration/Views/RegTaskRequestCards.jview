  "JsonMetadataSource::txt": "RegTaskRequestCards JSONMETA",
  "MsQuerySource::txt": "RegTaskRequestCards MSSQL",
  "PgQuerySource::txt": "RegTaskRequestCards PGSQL"
}

[TEXTPART RegTaskRequestCards JSONMETA]
{
  "Alias": "RegTaskRequestCards",
  "Caption": "RegTaskRequestCards",
  "Columns": [
    {
      "Alias": "CardID",
      "Hidden": true,
      "Type": "Guid Null"
    },
    {
      "Alias": "RequestID",
      "Hidden": true,
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Mnemonic",
      "Hidden": true,
      "Type": "String(Max) Null"
    },
    {
      "Alias": "TaskType",
      "Caption": "Тип поручения",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "UpdateAt",
      "Caption": "Дата последнего запроса",
      "Type": "DateTime Null"
    },
    {
      "Alias": "Message",
      "Caption": "Статус",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "PeriodDateStart",
      "Caption": "Начало охватываемого периода",
      "Type": "DateTime Null"
    },
    {
      "Alias": "PeriodDateEnd",
      "Caption": "Конец охватываемого периода",
      "Type": "DateTime Null"
    },
    {
      "Alias": "Status",
      "Hidden": true,
      "Type": "Int16 Null"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART RegTaskRequestCards MSSQL]


[TEXTPART RegTaskRequestCards PGSQL]
SELECT
	dci."ID" AS "CardID",
	rtdr."RequestID",
	rtdr."Mnemonic",
	rtdr."TaskType",
	rtdr."UpdateAt",
	rtdr."Message",
	rtdr."PeriodDateStart",
	rtdr."PeriodDateEnd",
	rtdr."Status"
FROM "DocumentCommonInfo" as "dci"
JOIN "RegTasksDataRequests" as "rtdr" ON "rtdr"."ID" = dci."ID"
WHERE "dci"."DocTypeID" = 'af3956ad-2eca-468e-999e-488f5e7d72c0'
