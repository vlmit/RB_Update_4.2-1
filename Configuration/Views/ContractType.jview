{
  "Alias": "ContractType",
  "Caption": "Тип договора",
  "GroupName": "Custom",
  "ID": "8450f18e-09a3-47f3-beed-f5adb0196cbb",
  "JsonMetadataSource::txt": "ContractType JSONMETA",
  "MsQuerySource::txt": "ContractType MSSQL",
  "PgQuerySource::txt": "ContractType PGSQL"
}

[TEXTPART ContractType JSONMETA]
{
  "Alias": "ContractType",
  "Caption": "Тип договора",
  "Columns": [
    {
      "Alias": "TypeID",
      "Caption": "Тип договора",
      "Hidden": true,
      "Type": "$ContractType.ID"
    },
    {
      "Alias": "TypeName",
      "Type": "$ContractType.Name"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "TypeID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Multiple": false,
      "Type": "$ContractType.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "ContractType"
      ]
    }
  ]
}

[TEXTPART ContractType MSSQL]


[TEXTPART ContractType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "ContractType" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
