      "Caption": "Completed",
      "Type": "$TaskHistory.Completed"
    },
    {
      "Alias": "KindCaption",
      "Caption": "KindCaption",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "Result",
      "Caption": "Result",
      "Type": "$NDSRate.Rate"
