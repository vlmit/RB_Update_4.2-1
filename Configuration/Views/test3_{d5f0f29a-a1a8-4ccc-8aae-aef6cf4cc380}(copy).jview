[TEXTPART test3_{d5f0f29a-a1a8-4ccc-8aae-aef6cf4cc380}(copy) MSSQL]


[TEXTPART test3_{d5f0f29a-a1a8-4ccc-8aae-aef6cf4cc380}(copy) PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"dci"."FullNumber" as "FullNumber",
	"pt"."CompletedByName"		AS "CompletedByName",
	"pt"."OptionCaption"		AS "OptionCaption",
	"pt"."Completed" as "Completed",
	"pt"."KindCaption" as "KindCaption",
	"pt"."Result"
FROM "TaskHistory" AS "pt"
Inner join "DocumentCommonInfo" as "dci" on "dci"."ID" = "pt"."ID"
WHERE true 
--"pt"."CompletedByID" in (select "ru"."UserID" from "RoleUsers" as "ru" where "ru"."ID" = '63b38597-d7cb-4de2-9f7e-f2dadf925239')
--and "pt"."KindCaption" = 'Утверждение проекта поручения'
and "pt"."OptionID" = '5b108223-92db-49b9-8085-336758ccabaa' --завершить
and "pt"."Result" = 'Вернуть на доработку' --or "pt"."Result" is null)
	#param(Name, "pt"."Name")
ORDER BY "pt"."Completed" desc
