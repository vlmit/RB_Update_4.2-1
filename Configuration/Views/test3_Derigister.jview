  "JsonMetadataSource::txt": "test3_Derigister JSONMETA",
  "MsQuerySource::txt": "test3_Derigister MSSQL",
  "PgQuerySource::txt": "test3_Derigister PGSQL"
}

[TEXTPART test3_Derigister JSONMETA]
{
  "Alias": "test3_Derigister",
  "Caption": "Список отмененных регистраций",
  "Columns": [
    {
      "Alias": "NdsID",
      "Hidden": true,
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "FullNumber",
      "Caption": "FullNumber",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "Subject",
      "Caption": "Subject",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "CompletedByName",
      "Caption": "CompletedByName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "OptionCaption",
      "Caption": "OptionCaption",
      "Localizable": true,
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "Completed",
      "Caption": "Completed",
      "Type": "$TaskHistory.Completed"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "NdsID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "IsGo",
      "AllowedOperands": [
        "IsTrue"
      ],
      "Caption": "IsGo",
      "Multiple": false,
      "Type": "Boolean Null"
    },
    {
      "Alias": "IsNotGo",
      "AllowedOperands": [
        "IsTrue"
      ],
      "Caption": "IsNotGo",
      "Multiple": false,
      "Type": "Boolean Null"
    },
    {
      "Alias": "IsProj",
      "AllowedOperands": [
        "IsTrue"
      ],
      "Caption": "IsProj",
      "Multiple": false,
      "Type": "Boolean Null"
    }
  ],
  "QuickSearchParam": "Rate"
}

[TEXTPART test3_Derigister MSSQL]


[TEXTPART test3_Derigister PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"dci"."FullNumber" as "FullNumber",
	"dci"."Subject" as "Subject",
	MAX("pt"."CompletedByName")		AS "CompletedByName",
	"pt"."OptionCaption"		AS "OptionCaption",
	MAX("pt"."Completed") as "Completed"
FROM "TaskHistory" AS "pt"
Inner join "DocumentCommonInfo" as "dci" on "dci"."ID" = "pt"."ID"
WHERE true
and "pt"."OptionID" = '66e0a7e1-484a-40a6-b123-06118ce3b160' --отменить регистрацию
#if(IsGo) 
{
and exists(select null from "TaskHistory" as "th2" where "th2"."ID" = "dci"."ID" 
			and "th2"."TypeID" = '2257bff2-1bdd-4f9a-aacd-dd93de844ea6') 
} 
#if(IsNotGo) 
{
and not exists(select null from "TaskHistory" as "th2" where "th2"."ID" = "dci"."ID" 
			and "th2"."TypeID" = '2257bff2-1bdd-4f9a-aacd-dd93de844ea6') 
}
#if(IsProj) 
{
and ("dci"."FullNumber" is null or "dci"."FullNumber" = '' or "dci"."FullNumber" like '%пр%' or "dci"."FullNumber" like '%ПР%')
}
and "dci"."Subject" not in ('Тест', 'ntcn', 'test', 'тест', 'ТЕСТ')
and "pt"."CompletedByName" != 'Олюнин В.В.'

GROUP BY "pt"."ID","dci"."FullNumber", "dci"."Subject","pt"."OptionCaption"
ORDER BY "Completed" DESC
