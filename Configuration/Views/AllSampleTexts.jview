{
  "Alias": "AllSampleTexts",
  "Caption": "Все типовые тексты",
  "GroupName": "Junicsoft",
  "ID": "e3c1f93b-41ec-4bc0-8b66-e95fe7b65d17",
  "JsonMetadataSource::txt": "AllSampleTexts JSONMETA",
  "MsQuerySource::txt": "AllSampleTexts MSSQL",
  "PgQuerySource::txt": "AllSampleTexts PGSQL"
}

[TEXTPART AllSampleTexts JSONMETA]
{
  "Alias": "AllSampleTexts",
  "Caption": "Все типовые тексты",
  "Columns": [
    {
      "Alias": "STID",
      "Hidden": true,
      "Type": "$SampleText.ID"
    },
    {
      "Alias": "STText",
      "Caption": "Текст",
      "MaxLength": 255,
      "Type": "$SampleText.Text"
    },
    {
      "Alias": "STAuthorID",
      "Hidden": true,
      "Type": "$SampleText.AuthorID"
    },
    {
      "Alias": "STAuthorName",
      "Caption": "Автор",
      "Type": "$SampleText.AuthorName"
    },
    {
      "Alias": "STStatus",
      "Caption": "Статус",
      "Type": "String(Max) Not Null"
    }
  ],
  "EnableAutoWidth": true,
  "Extensions": [
    {
      "Data": {
        "CardCreationKind": "ByTypeAlias",
        "CardOpeningKind": "ApplicationTab",
        "DocTypeIdentifier": null,
        "IDParam": null,
        "TypeAlias": "SampleText"
      },
      "Order": 0,
      "TypeName": "Tessa.Extensions.Default.Client.Views.CreateCardExtension"
    }
  ],
  "FormatVersion": 5,
  "PageLimit": 1000,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "Text",
      "Caption": "Текст",
      "Multiple": false,
      "Type": "$SampleText.Text"
    },
    {
      "Alias": "AuthorOld",
      "AllowedOperands": [
        "Equality"
      ],
      "Caption": "Автор",
      "Hidden": true,
      "Multiple": false,
      "RefSection": [
        "OnlyUsersExpand"
      ],
      "Type": "$SampleText.AuthorID"
    },
    {
      "Alias": "Author",
      "AllowedOperands": [
        "Equality",
        "NonEquality"
      ],
      "AutoCompleteInfo": {
        "ParamAlias": "Name",
        "PopupColumns": [
          1,
          4
        ],
        "ViewAlias": "Users"
      },
      "Caption": "$Views_Registers_Author_Param",
      "RefSection": [
        "PersonalRoles"
      ],
      "Type": "$DocumentCommonInfo.AuthorID"
    }
  ],
  "QuickSearchParam": "Text",
  "References": [
    {
      "ColPrefix": "ST",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "SampleText"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count",
      "CountColumn": "cnt",
      "HideZeroCount": true
    }
  ]
}

[TEXTPART AllSampleTexts MSSQL]


[TEXTPART AllSampleTexts PGSQL]
SELECT
#if(Normal) {
	st."ID" as "STID",
    st."Text" as "STText",
    st."AuthorID" as "STAuthorID",
    st."AuthorName" as "STAuthorName",
    CASE 
    WHEN "Status" = false 
    	THEN 'Активен'
    	ELSE 'Не активен'
    END AS "STStatus"
    }
#if(Count) { 
	COUNT(*) as cnt
}

FROM "SampleText" as st
WHERE 1=1
#param(Text, st."Text")
#param(Author, st."AuthorID")
