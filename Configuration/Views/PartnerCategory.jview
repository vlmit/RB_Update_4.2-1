}

[TEXTPART PartnerCategory JSONMETA]
{
  "Alias": "PartnerCategory",
  "Caption": "Категории контрагентов",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$Partners.ID"
    },
    {
      "Alias": "TypeName",
      "Caption": "Наименование",
      "Type": "$Partners.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$PartnersTypes.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "PartnerCategory"
      ]
    }
  ]
}

[TEXTPART PartnerCategory MSSQL]


[TEXTPART PartnerCategory PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "PartnerCategory" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
