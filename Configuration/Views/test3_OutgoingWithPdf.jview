{
  "Alias": "test3_OutgoingWithPdf",
  "Caption": "Список исходящих от районов с файлами пдф",
  "GroupName": "Custom",
  "ID": "d16c1ac1-5fb8-4d48-b03d-b976c382cdbd",
  "JsonMetadataSource::txt": "test3_OutgoingWithPdf JSONMETA",
  "MsQuerySource::txt": "test3_OutgoingWithPdf MSSQL",
  "PgQuerySource::txt": "test3_OutgoingWithPdf PGSQL"
}

[TEXTPART test3_OutgoingWithPdf JSONMETA]
{
  "Alias": "test3_OutgoingWithPdf",
  "Caption": "Список исходящих от районов с файлами пдф",
  "Columns": [
    {
      "Alias": "ID",
      "Hidden": true,
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "FullNumber",
      "Caption": "FullNumber",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "DepartmentName",
      "Caption": "DepartmentName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "RegistratorName",
      "Caption": "RegistratorName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "FileList",
      "Caption": "FileList",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "RoleList",
      "Caption": "RoleList",
      "Type": "$NDSRate.Rate"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "NdsID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "QuickSearchParam": "Rate"
}

[TEXTPART test3_OutgoingWithPdf MSSQL]


[TEXTPART test3_OutgoingWithPdf PGSQL]
SELECT
	"dci"."ID"		AS "ID",
	"dci"."FullNumber" as "FullNumber",
	"dci"."DepartmentName" as "DepartmentName",
	"dci"."RegistratorName" as "RegistratorName",
	(SELECT string_agg("f"."Name",'; ')
		FROM "Files" as "f" 
		WHERE "dci"."ID"="f"."ID" and "f"."Name" like '%.pdf%'
		) as "FileList",
		
	(SELECT string_agg("th"."RoleName",'; ')
		FROM "TaskHistory" AS "th" 
		where "th"."ID" = "dci"."ID" and "th"."TypeID" = '2257bff2-1bdd-4f9a-aacd-dd93de844ea6' 
		) as "RoleList"
		
FROM "DocumentCommonInfo" AS "dci"
WHERE true and "dci"."DocTypeID" = '02bd0e1f-d80b-4223-a552-a50f633f17fe' --тип Исходящий
and exists(select null from "TaskHistory" as "th" where "th"."ID" = "dci"."ID" 
			and "th"."TypeID" = '2257bff2-1bdd-4f9a-aacd-dd93de844ea6')
and exists(select null from "Files" as "f" where "f"."ID" = "dci"."ID" 
			and "f"."Name" like '%.pdf%')

ORDER BY "dci"."CreationDate" desc
