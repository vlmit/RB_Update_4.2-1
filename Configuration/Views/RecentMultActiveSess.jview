{
  "Alias": "RecentMultActiveSess",
  "Caption": "Пользователи с более чем одной активной сессией с активностью за последний час",
  "GroupName": "Testing",
  "ID": "90b5fd1c-2a02-4f87-a27f-263aa5f98938",
  "JsonMetadataSource::txt": "RecentMultActiveSess JSONMETA",
  "MsQuerySource::txt": "RecentMultActiveSess MSSQL",
  "PgQuerySource::txt": "RecentMultActiveSess PGSQL"
}

[TEXTPART RecentMultActiveSess JSONMETA]
{
  "Alias": "RecentMultActiveSess",
  "Caption": "Пользователи с более чем одной активной сессией с активностью за последний час",
  "Columns": [
    {
      "Alias": "UserID",
      "Hidden": true,
      "Type": "$Sessions.UserID"
    },
    {
      "Alias": "UserName",
      "Caption": "Пользователь",
      "Type": "$Sessions.UserName"
    },
    {
      "Alias": "cnt",
      "Caption": "Число сессий",
      "Type": "Int64 Null"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "UserName",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "References": [
    {
      "ColPrefix": "User",
      "DisplayValueColumn": "UserName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "MultiSessions"
      ]
    }
  ]
}

[TEXTPART RecentMultActiveSess MSSQL]


[TEXTPART RecentMultActiveSess PGSQL]
select
	"UserID",
	"UserName",
	count(*) as "cnt"
	
from
	"Sessions"
where
	"IsActive"=true
 and "LastActivity" > now()-interval '1 hour'
 
group by "UserID", "UserName"
having count(*)>1
order by cnt desc, "UserName"
