{
  "Alias": "CoUsers",
  "Caption": "Соисполнители",
  "GroupName": "Custom",
  "ID": "45583f83-4377-4204-94fa-1f3eb9544642",
  "JsonMetadataSource::txt": "CoUsers JSONMETA",
  "MsQuerySource::txt": "CoUsers MSSQL",
  "PgQuerySource::txt": "CoUsers PGSQL"
}

[TEXTPART CoUsers JSONMETA]
{
  "Alias": "CoUsers",
  "Caption": "Соисполнители",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$Partners.ID"
    },
    {
      "Alias": "TypeName",
      "Caption": "Исполнитель",
      "Type": "$Partners.Name"
    },
    {
      "Alias": "Planned",
      "Caption": "Срок",
      "Type": "Date Null"
    },
    {
      "Alias": "Question",
      "Caption": "Описание",
      "Type": "$Partners.Name"
    },
    {
      "Alias": "Status",
      "Caption": "Статус",
      "Type": "$Partners.Name"
    },
    {
      "Alias": "Result",
      "Caption": "Комментарий",
      "Type": "$Partners.Name"
    }
  ],
  "Extensions": [
    {
      "Order": 0,
      "TypeName": "Tessa.Extensions.Default.Client.Views.ViewsContextMenuExtension"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "CardID",
      "Caption": "CardID",
      "Hidden": true,
      "Multiple": false,
      "Type": "$TaskHistory.AuthorID"
    },
    {
      "Alias": "TaskCardID",
      "Caption": "TaskCardID",
      "Hidden": true,
      "Multiple": false,
      "Type": "$TaskHistory.AuthorID"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "PersonalRoles"
      ]
    }
  ]
}

[TEXTPART CoUsers MSSQL]


[TEXTPART CoUsers PGSQL]
SELECT
	"pt"."UserID"		AS "TypeID",
	"pt"."UserName"		AS "TypeName",
	"CtD"."Planned" 	AS "Planned",
	"CtD"."Question" 	AS "Question",
	Case when (select "th"."Completed" from "TaskHistory" as "th" where "pt"."UserID"="th"."UserID" 
	#param(CardID, "th"."ID") and "th"."TypeCaption"='Исполнение поручения' limit 1) is not null
		Then 'На исполнении'
		Else 'Завершен'
		END 			As "Status",
	(select "th"."Result" from "TaskHistory" as "th" where "pt"."UserID"="th"."UserID" 
	#param(CardID, "th"."ID") and "th"."TypeCaption"='Исполнение поручения' limit 1)
						as "Result"	
FROM "ControlTaskPerformers" AS "pt"
Inner join "ControlTaskDecisions" as "CtD" on "CtD"."RowID"= "pt"."ParentRowID"
Inner join "DocumentCommonInfo" as "dci" on "dci"."ID"= "pt"."ID"
WHERE true --and "CtD"."ID" = (select "mi"."ID" from "DocumentCommonInfo" as "mi" where "mi"."CardTypeID" =  '01ad498e-5f8e-417a-bd28-942739dbf342' LIMIT 1)
	#param(TaskCardID, "pt"."ID")
	and "pt"."UserID"!=#param(CurrentUserID)
ORDER BY "dci"."CreationDate"
limit 5
