[TEXTPART Original MSSQL]


[TEXTPART Original PGSQL]
SELECT
	"pt"."ID"		AS "OrigID",
	"pt"."Name"		AS "OrigName"
FROM "Original" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
