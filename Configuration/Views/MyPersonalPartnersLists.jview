  "PgQuerySource::txt": "MyPersonalPartnersLists PGSQL"
}

[TEXTPART MyPersonalPartnersLists JSONMETA]
{
  "Alias": "MyPersonalPartnersLists",
  "Caption": "Личный список контрагентов",
  "Columns": [
    {
      "Alias": "PPL_ID",
      "Caption": "ID",
      "Hidden": true,
      "Type": "$PersonalPartnerList.ID"
    },
    {
      "Alias": "PPL_Title",
      "Caption": "Название списка",
      "Type": "$PersonalPartnerList.Title"
    },
    {
      "Alias": "PPL_Status",
      "Caption": "Статус",
      "Type": "String(Max) Not Null"
    },
    {
      "Alias": "OwnerID",
      "Hidden": true,
      "Type": "$PersonalPartnerList.OwnerID"
    }
  ],
  "EnableAutoWidth": true,
  "Extensions": [
    {
      "Data": {
        "CardCreationKind": "ByTypeAlias",
        "CardOpeningKind": "ApplicationTab",
        "DocTypeIdentifier": null,
        "IDParam": null,
        "TypeAlias": "PersonalPartnerList"
      },
      "Order": 0,
      "TypeName": "Tessa.Extensions.Default.Client.Views.CreateCardExtension"
    }
  ],
  "FormatVersion": 5,
  "Paging": "Optional",
  "Parameters": [
    {
      "Alias": "Title",
      "Caption": "Название списка",
      "Multiple": false,
      "RefSection": [
        "MyPersonalPartnersLists"
      ],
      "Type": "$PersonalPartnerList.Title"
    },
    {
      "Alias": "Status",
      "AllowedOperands": [
        "IsFalse",
        "IsTrue"
      ],
      "Caption": "Показать неактивные списки",
      "Multiple": false,
      "Type": "$PersonalPartnerList.Status"
    }
  ],
  "References": [
    {
      "ColPrefix": "PPL_",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "MyPersonalPartnersLists"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count",
      "CountColumn": "cnt",
      "HideZeroCount": true
    }
  ]
}

[TEXTPART MyPersonalPartnersLists MSSQL]


[TEXTPART MyPersonalPartnersLists PGSQL]
select
#if(Normal) { 
	"ID" as "PPL_ID",
	"Title" as "PPL_Title",
	CASE 
    WHEN "Status" = false 
    	THEN 'Активен'
    	ELSE 'Не активен'
    END as "PPL_Status",
    "OwnerID"
	}
#if(Count) { 
	count(*) as cnt
	}
from
	"PersonalPartnerList" as "ppl"
where
	true
	#param(Title, "Title")
	#param(Status, "Status")
	and "ppl"."OwnerID"=#param(CurrentUserID)
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit);
}
