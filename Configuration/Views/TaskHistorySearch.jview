{
  "Alias": "TaskHistorySearch",
  "Caption": "Прошлые задачи документа",
  "GroupName": "Testing",
  "ID": "c77d7524-a547-46bb-b762-d99363a25857",
  "JsonMetadataSource::txt": "TaskHistorySearch JSONMETA",
  "MsQuerySource::txt": "TaskHistorySearch MSSQL",
  "PgQuerySource::txt": "TaskHistorySearch PGSQL"
}

[TEXTPART TaskHistorySearch JSONMETA]
{
  "Alias": "TaskHistorySearch",
  "Caption": "Прошлые задачи документа",
  "Columns": [
    {
      "Alias": "ID",
      "Type": "$Tasks.ID"
    },
    {
      "Alias": "ParentRowID",
      "Type": "$Tasks.ParentID"
    },
    {
      "Alias": "RowID",
      "Type": "$Tasks.RowID"
    },
    {
      "Alias": "TypeCaption",
      "Localizable": true,
      "Type": "$Tasks.TypeCaption"
    },
    {
      "Alias": "OptionCaption",
      "Localizable": true,
      "Type": "$TaskHistory.OptionCaption"
    },
    {
      "Alias": "Created",
      "SortBy": "Created",
      "Type": "$Tasks.Created"
    },
    {
      "Alias": "AuthorName",
      "Type": "$Tasks.AuthorName"
    },
    {
      "Alias": "RoleName",
      "Caption": "Кому назначено",
      "Localizable": true,
      "Type": "$Tasks.RoleName"
    },
    {
      "Alias": "UserName",
      "Caption": "Кто взял в работу",
      "Type": "$Tasks.UserName"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "Created",
      "SortDirection": "Descending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART TaskHistorySearch MSSQL]


[TEXTPART TaskHistorySearch PGSQL]
select
	"t"."ID",
	"ParentRowID",
	"RowID",
	"t"."TypeCaption",
	"OptionCaption",
	"Created",
	"t"."AuthorName",
	"RoleName",
	"UserName"
from "TaskHistory" as "t"
where 
	"ID"='a936fd25-5a48-4b86-93ea-f1982c7f118b'
	--"ParentID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
	--"RowID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
order by #order_by
