{
  "Alias": "test3",
  "Caption": "Список отмененных проектов поручений",
  "GroupName": "Custom",
  "ID": "4160ac96-2d9e-4274-8236-6e9b8ad19342",
  "JsonMetadataSource::txt": "test3 JSONMETA",
  "MsQuerySource::txt": "test3 MSSQL",
  "PgQuerySource::txt": "test3 PGSQL"
}

[TEXTPART test3 JSONMETA]
{
  "Alias": "test3",
  "Caption": "Список отмененных проектов поручений",
  "Columns": [
    {
      "Alias": "NdsID",
      "Hidden": true,
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "FullNumber",
      "Caption": "FullNumber",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "CompletedByName",
      "Caption": "CompletedByName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "OptionCaption",
      "Caption": "OptionCaption",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "Completed",
      "Caption": "Completed",
      "Type": "$TaskHistory.Completed"
    },
    {
      "Alias": "KindCaption",
      "Caption": "KindCaption",
      "Type": "$NDSRate.Rate"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "NdsID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "QuickSearchParam": "Rate"
}

[TEXTPART test3 MSSQL]


[TEXTPART test3 PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"dci"."FullNumber" as "FullNumber",
	"pt"."CompletedByName"		AS "CompletedByName",
	"pt"."OptionCaption"		AS "OptionCaption",
	"pt"."Completed" as "Completed",
	"pt"."KindCaption" as "KindCaption"
FROM "TaskHistory" AS "pt"
Inner join "DocumentCommonInfo" as "dci" on "dci"."ID" = "pt"."ID"
WHERE true and 
"pt"."CompletedByID" in (select "ru"."UserID" from "RoleUsers" as "ru" where "ru"."ID" = '63b38597-d7cb-4de2-9f7e-f2dadf925239')
and "pt"."KindCaption" = 'Утверждение проекта поручения'
and "pt"."OptionID" = '5b108223-92db-49b9-8085-336758ccabaa' --завершить
and ("pt"."Result" = '' or "pt"."Result" is null)
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
