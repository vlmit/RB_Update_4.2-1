{
  "Alias": "SubStageType",
  "Caption": "Тип этапа",
  "GroupName": "Custom",
  "ID": "1dcd5ce4-1a0a-4fde-8b31-19edb26bb1d9",
  "JsonMetadataSource::txt": "SubStageType JSONMETA",
  "MsQuerySource::txt": "SubStageType MSSQL",
  "PgQuerySource::txt": "SubStageType PGSQL"
}

[TEXTPART SubStageType JSONMETA]
{
  "Alias": "SubStageType",
  "Caption": "Тип этапа",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "Int16 Not Null"
    },
    {
      "Alias": "TypeName",
      "Caption": "Наименование",
      "Type": "$Partners.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$PartnersTypes.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "RefSection": [
        "SubStageTypes"
      ]
    }
  ]
}

[TEXTPART SubStageType MSSQL]


[TEXTPART SubStageType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "SubStageType" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
