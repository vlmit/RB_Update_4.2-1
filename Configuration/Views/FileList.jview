{
  "Alias": "FileList",
  "Caption": "Список вложений",
  "Description": "    ",
  "GroupName": "CustomFileList",
  "ID": "47ed07a4-3d5b-44fc-b047-edbb58b507bd",
  "JsonMetadataSource::txt": "FileList JSONMETA",
  "MsQuerySource::txt": "FileList MSSQL",
  "PgQuerySource::txt": "FileList PGSQL"
}

[TEXTPART FileList JSONMETA]
{
  "Alias": "FileList",
  "Caption": "Список вложений",
  "Columns": [
    {
      "Alias": "CardID",
      "Hidden": true,
      "Type": "Guid Not Null"
    },
    {
      "Alias": "FileName",
      "Caption": "Название файла",
      "Type": "String"
    },
    {
      "Alias": "FileID",
      "Caption": "ID файла",
      "Hidden": true,
      "SortBy": "t.Name",
      "Type": "Guid Not Null"
    },
    {
      "Alias": "Category",
      "Caption": "Категория",
      "Type": "String"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "CardID",
      "Caption": "CardID",
      "Hidden": true,
      "Type": "$Files.ID"
    },
    {
      "Alias": "CardTaskID",
      "Caption": "CardTaskID",
      "Hidden": true,
      "Type": "$Files.ID"
    },
    {
      "Alias": "FileName",
      "Caption": "Имя файла",
      "Type": "String(Max) Null"
    }
  ],
  "References": [
    {
      "ColPrefix": "File",
      "DisplayValueColumn": "FileName",
      "OpenOnDoubleClick": true,
      "RefSection": [
        "Files"
      ]
    }
  ]
}

[TEXTPART FileList MSSQL]


[TEXTPART FileList PGSQL]
select
    "t"."ID" as "CardID",
    "t"."Name" as "FileName",
    "t"."RowID" as "FileID",
    "t"."CategoryCaption" as "Category"
from "Files" as "t" 
where 1=1
	#param(FileName, "t"."Name")
    #if(CardID)
    {
    #param(CardID, "t"."ID")
    }
    {
		    #if(CardTaskID)
		    {
		    and "t"."ID" = (select "tsk"."ID" from "TaskHistory" as "tsk" 
		    			where 1=1 #param(CardTaskID, "tsk"."RowID") limit 1)
		    and "t"."CategoryCaption" != 'Документ'
		    }
		    {
		    and 1=0
		    }
    }
