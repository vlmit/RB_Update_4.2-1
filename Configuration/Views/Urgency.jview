}

[TEXTPART Urgency JSONMETA]
{
  "Alias": "Urgency",
  "Caption": "Срочность",
  "Columns": [
    {
      "Alias": "UrgID",
      "Hidden": true,
      "Type": "$Urgency.ID"
    },
    {
      "Alias": "UrgName",
      "Caption": "Срочность",
      "Type": "$Urgency.Name"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "UrgID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Multiple": false,
      "Type": "$Urgency.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "CardType": "RB_Urgency",
      "ColPrefix": "Urg",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "Urgency"
      ]
