[TEXTPART Urgency MSSQL]


[TEXTPART Urgency PGSQL]
SELECT
	"pt"."ID"		AS "UrgID",
	"pt"."Name"		AS "UrgName"
FROM "Urgency" AS "pt"

WHERE true and "pt"."Name" != 'Весьма срочно'
	#param(Name, "pt"."Name")
ORDER BY 
   CASE "pt"."Name"
      WHEN 'Нет' THEN 1
      WHEN 'Срочно' THEN 2
      WHEN 'Важно' THEN 3
      WHEN 'Оперативно' THEN 4
      WHEN 'Обычный приоритет' THEN 5
      ELSE 6 --needed only is no IN clause above. eg when = 'b'
   END
