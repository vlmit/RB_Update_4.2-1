[TEXTPART RefGroups MSSQL]
SELECT
	[t].*
FROM (

	SELECT
	#if(Normal) 
	{
		[rg].[ID]						AS [RefGroupID],
		[rg].[Name]						AS [RefGroupName],
		[rg].[RefGroupTypeID]			AS [RefGroupTypeID],
		[rg].[RefGroupTypeName]			AS [RefGroupTypeName],
		[rg].[IntID]					AS [IntID],
		row_number() OVER (ORDER BY #order_by)	AS [rn]
	}
	#if(ByRefGroupType)
	{
		[rg].[RefGroupTypeID]		AS [RefGroupTypeID],
		[rg].[RefGroupTypeName]		AS [RefGroupTypeName],
		count(*) as [Count]
	}
	#if(Count) 
	{
		count(*) AS [Count]
	}
	FROM [RefGroups] AS [rg] WITH (NOLOCK)
    #if(Name || Normal && request.SortedBy("RefGroupName")) {
	CROSS APPLY [Localization]([rg].[Name], #param(locale)) AS [lName]
	}
	WHERE 1 = 1
		#param(Name, [lName].[Value])
		#param(TypeID, [rg].[RefGroupTypeID])
		
	#if(ByRefGroupType) {
		GROUP BY [rg].[RefGroupTypeID], [rg].[RefGroupTypeName]
	}
		
) AS [t]

#if(PageOffset) {
	WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) 
{
	ORDER BY [t].[rn]
}
#if(ByRefGroupType)
{
    GROUP BY [t].[RefGroupTypeID], [t].[RefGroupTypeName], [t].[Count]
    ORDER BY [t].[RefGroupTypeName]
}

[TEXTPART RefGroups PGSQL]
SELECT
	"t".*
FROM (

	SELECT
	#if(Normal) 
	{
		"rg"."ID"						AS "RefGroupID",
		"rg"."Name"						AS "RefGroupName",
		"rg"."RefGroupTypeID"			AS "RefGroupTypeID",
		"rg"."RefGroupTypeName"			AS "RefGroupTypeName",
		"rg"."IntID"					AS "IntID",
		row_number() OVER (ORDER BY #order_by)	AS "rn"
	}
	#if(ByRefGroupType)
	{
		"rg"."RefGroupTypeID"		AS "RefGroupTypeID",
		"rg"."RefGroupTypeName"		AS "RefGroupTypeName",
		count(*) as "Count"
	}
	#if(Count) 
	{
		count(*) AS "Count"
	}
	FROM "RefGroups" AS "rg"	
    #if(Name || Normal && request.SortedBy("RefGroupName")) {
	CROSS JOIN "Localization"("rg"."Name", #param(locale)) AS "lName"
	}
	WHERE 1 = 1
		#param(Name, "lName"."Value")
		#param(TypeID, "rg"."RefGroupTypeID")
		
	#if(ByRefGroupType) {
		GROUP BY "rg"."RefGroupTypeID", "rg"."RefGroupTypeName"
	}
	
) AS "t"

#if(PageOffset) {
	WHERE "t"."rn" >= #param(PageOffset) AND "t"."rn" < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) 
{
	ORDER BY "t"."rn"
}
#if(ByRefGroupType)
{
    GROUP BY "t"."RefGroupTypeID", "t"."RefGroupTypeName", "t"."Count"
    ORDER BY "t"."RefGroupTypeName"
}