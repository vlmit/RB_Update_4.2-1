[TEXTPART test2_{2d0a3c60-94a5-4526-a673-b2fd1a2529fc}(copy) MSSQL]


[TEXTPART test2_{2d0a3c60-94a5-4526-a673-b2fd1a2529fc}(copy) PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"pt"."Name"		AS "DeputyName",
	"pt"."EDSCertificateInfo"		AS "DeputizedName"
FROM "test2" AS "pt"

WHERE true --and "pt"."AccessLevelID" = 1
and "pt"."EDSCertificateInfo" is not null
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
