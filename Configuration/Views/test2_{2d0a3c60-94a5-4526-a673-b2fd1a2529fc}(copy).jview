{
  "Alias": "test2_{2d0a3c60-94a5-4526-a673-b2fd1a2529fc}(copy)",
  "Caption": "Сотрудники с уровнем доступа Администратор",
  "Columns": [
    {
      "Alias": "NdsID",
      "Hidden": true,
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "DeputyName",
      "Caption": "DeputyName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "DeputizedName",
      "Caption": "DeputizedName",
      "Type": "$NDSRate.Rate"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "NdsID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
