}

[TEXTPART ShowPostgreActiveSessions JSONMETA]
{
  "Alias": "ShowPostgreActiveSessions",
  "Caption": "Активные сессии Postgres",
  "Columns": [
    {
      "Alias": "pid",
      "SortBy": "pid",
      "Type": "Int32 Not Null"
    },
    {
      "Alias": "usename",
      "SortBy": "username",
      "Type": "String(Max) Not Null"
    },
    {
      "Alias": "database_name",
      "SortBy": "database_name",
      "Type": "String(Max) Not Null"
    },
    {
      "Alias": "client_addr",
      "SortBy": "client_addr",
      "Type": "String(Max) Not Null"
    },
    {
      "Alias": "client_hostname",
      "SortBy": "client_hostname",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "application_name",
      "SortBy": "application_name",
      "Type": "String(Max) Not Null"
    },
    {
      "Alias": "backend_start",
      "SortBy": "backend_start",
      "Type": "DateTime Not Null"
    },
    {
      "Alias": "state",
      "SortBy": "state",
      "Type": "String(Max) Not Null"
    },
    {
      "Alias": "state_change",
      "SortBy": "state_change",
      "Type": "DateTime Not Null"
    },
    {
      "Alias": "query",
      "SortBy": "query",
      "Type": "String(Max) Null"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART ShowPostgreActiveSessions MSSQL]


[TEXTPART ShowPostgreActiveSessions PGSQL]
SELECT
    pid,
    cast(usename as text),
    cast(datname as text) as database_name,
    cast(client_addr as text) as client_addr,
    client_hostname,
    application_name,
    backend_start,
    state,
    state_change,
    query
FROM
    pg_stat_activity
order by pid
