[TEXTPART DeletedFiles MSSQL]
SELECT
	#if(Normal) {
	[f].[ID]					AS [DeletedID],
	[f].[RowID]					AS [DeletedRowID],
	[f].[Name]					AS [DeletedName],
	CAST(
		CASE
			WHEN [f].[OriginalFileID] IS NOT NULL
				THEN 1
			ELSE 0
		END
	AS BIT)						AS [DeletedCopy],
	[f].[CreatedByID]			AS [DeletedAuthorID],
	[f].[Deleted]				AS [DeletedDate],
	[f].[DeletedByID]			AS [DeletedByID],
	[f].[CategoryCaption]		AS [DeletedCategory],
	[fv].[Number]				AS [DeletedNumber],
	[fv].[Size]					AS [DeletedSize],
	STUFF((
		SELECT
			CHAR(10) +
			[fs].[UserName] +
			CASE WHEN [fs].[SubjectName] IS NOT NULL
				THEN ' (' + [fs].[SubjectName] + ')'
				ELSE ''
			END
		FROM [DeletedFileSignatures] AS [fs] WITH (NOLOCK)
		WHERE [fs].[VersionRowID] = [f].[VersionRowID]
		ORDER BY [fs].[Signed]
		FOR XML PATH('')),
		1, 1, N'')				AS [DeletedSignatures],
	N'#appearance(Background: ' +
		CASE [fv].[StateID]
			WHEN 2 THEN N'#FFFF0000'	-- Error => Red
			ELSE N'#00000000'			-- Transparent
		END + N')'				AS [DeletedAppearance]
	}
	#if(Count) {
	[f].*
	}
FROM (
	SELECT
		[t].*
	FROM (
		SELECT
			#if(Normal) {
			[f].*,
			ROW_NUMBER() OVER (ORDER BY #order_by)	AS [rn]
			}
			#if(Count) {
			COUNT(*)								AS [cnt]
			}
		FROM [DeletedFiles] AS [f] WITH (NOLOCK)
		#if(Name || request.SortedBy("DeletedName")) {
		CROSS APPLY [Localization]([f].[Name], #param(locale)) AS [lName]
		}
		WHERE 1 = 1
			#param(Name, [lName].[Value])
			#param(CreatedBy, [f].[CreatedByID])
			#param(Deleted, [f].[Deleted])
			#param(DeletedBy, [f].[DeletedByID])
			#param(Card, [f].[ID])
			#if(!ShowAll) {
				#param(CurrentUserID, [f].[DeletedByID]) 
			}
			#if(Copy && Copy.CriteriaName == CriteriaOperatorConst.IsTrue) {
				AND [f].[OriginalFileID] IS NOT NULL
			}
			#if(Copy && Copy.CriteriaName == CriteriaOperatorConst.IsFalse) {
				AND [f].[OriginalFileID] IS NULL
			}
		) AS [t]
	#if(PageOffset) {
	WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
	}
) AS [f]
#if(Normal) {
INNER JOIN [DeletedFileVersions] AS [fv] WITH (NOLOCK)
	ON [fv].[RowID] = [f].[VersionRowID]
ORDER BY [f].[rn]
}

[TEXTPART DeletedFiles PGSQL]
SELECT
	#if(Normal) {
	"f"."ID"					AS "DeletedID",
	"f"."RowID"					AS "DeletedRowID",
	"f"."Name"					AS "DeletedName",
	CASE
		WHEN "f"."OriginalFileID" IS NOT NULL
			THEN true
		ELSE false
	END							AS "DeletedCopy",
	"f"."CreatedByID"			AS "DeletedAuthorID",
	"f"."Deleted"				AS "DeletedDate",
	"f"."DeletedByID"			AS "DeletedByID",
	"f"."CategoryCaption"		AS "DeletedCategory",
	"fv"."Number"				AS "DeletedNumber",
	"fv"."Size"					AS "DeletedSize",
	(
		SELECT string_agg(
			"fs"."UserName" ||
			CASE WHEN "fs"."SubjectName" IS NOT NULL
				THEN ' (' || "fs"."SubjectName" || ')'
				ELSE ''
			END,
			chr(10)
			ORDER BY "fs"."Signed")
		FROM "DeletedFileSignatures" AS "fs"
		WHERE "fs"."VersionRowID" = "f"."VersionRowID"
	 )							AS "DeletedSignatures",
	'#appearance(Background: ' ||
		CASE "fv"."StateID"
			WHEN 2 THEN N'#FFFF0000'	-- Error => Red
			ELSE '#00000000'			-- Transparent
		END || ')' AS "DeletedAppearance"
	}
	#if(Count) {
	"f".*
	}
FROM (
	SELECT
		#if(Normal) {
		"f".*
		}
		#if(Count) {
		count(*)					AS "cnt"
		}
	FROM "DeletedFiles" AS "f"
	#if(Name || request.SortedBy("DeletedName")) {
	CROSS JOIN "Localization"("f"."Name", #param(locale)) AS "lName"
	}
	WHERE true
		#param(Name, "lName"."Value")
		#param(CreatedBy, "f"."CreatedByID")
		#param(Deleted, "f"."Deleted")
		#param(DeletedBy, "f"."DeletedByID")
		#param(Card, "f"."ID")
		#if(!ShowAll) {
			#param(CurrentUserID, "f"."DeletedByID") 
		}
		#if(Copy && Copy.CriteriaName == CriteriaOperatorConst.IsTrue) {
			AND "f"."OriginalFileID" IS NOT NULL
		}
		#if(Copy && Copy.CriteriaName == CriteriaOperatorConst.IsFalse) {
			AND "f"."OriginalFileID" IS NULL
		}
	#if(Normal) {
	ORDER BY #order_by
	}
	#if(PageOffset) {
	OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
	}
) AS "f"
#if(Normal) {
INNER JOIN "DeletedFileVersions" AS "fv"
	ON "fv"."RowID" = "f"."VersionRowID"
}