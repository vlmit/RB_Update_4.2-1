  "PgQuerySource::txt": "GipFileSignatures PGSQL"
}

[TEXTPART GipFileSignatures JSONMETA]
{
  "Alias": "GipFileSignatures",
  "Caption": "Подписи",
  "Columns": [
    {
      "Alias": "FsID",
      "Hidden": true,
      "Type": "GUID"
    },
    {
      "Alias": "RowID",
      "Hidden": true,
      "Type": "GUID"
    },
    {
      "Alias": "FsUserName",
      "Caption": "Подписант",
      "Type": "String"
    },
    {
      "Alias": "FsSigned",
      "Caption": "Подписан",
      "Type": "DateTime"
    },
    {
      "Alias": "FsSerialNumber",
      "Caption": "Сертификат",
      "Type": "String"
    },
    {
      "Alias": "FsCardID",
      "Hidden": true,
      "Type": "GUID"
    },
    {
      "Alias": "FsFileName",
      "Caption": "Имя файла",
      "Type": "String"
    }
  ],
  "DefaultSortColumns": [
