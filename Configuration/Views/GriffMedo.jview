[TEXTPART GriffMedo MSSQL]


[TEXTPART GriffMedo PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName",
	"pt"."Index"	AS "TypeIndex"
FROM "GriffMedo" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."Name"
