[TEXTPART GriffMedo JSONMETA]
{
  "Alias": "GriffMedo",
  "Caption": "Гриф документа МЭДО",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$GriffMedo.ID"
    },
    {
      "Alias": "TypeName",
      "Caption": "Наименование",
      "SortBy": "\"pt\".\"Name\"",
      "Type": "$GriffMedo.Name"
    },
    {
      "Alias": "TypeIndex",
      "Caption": "Индекс",
      "SortBy": "\"pt\".\"Name\"",
      "Type": "$GriffMedo.Index"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "TypeIndex",
      "SortDirection": "Ascending"
    },
    {
      "Alias": "TypeName",
      "SortDirection": "Descending"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$GriffMedo.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "GriffMedo"
      ]
