[TEXTPART UsersExpand_DistrictHeads MSSQL]


[TEXTPART UsersExpand_DistrictHeads PGSQL]

SELECT 
	"dr"."ID",
	"r"."ID" as "DepID",
	"r"."Name" as "DepName",
	"dr"."HeadUserID" as "UserID",
	COALESCE("dr"."HeadUserName",'') as "UserName"
	
FROM
	"DepartmentRoles" as "dr"
LEFT JOIN "Roles" as "r" on "r"."ID" = "dr"."ID"
WHERE
	"r"."ParentID" = '0374e055-b527-45ef-b32e-79fcd739cb6b'
	
order by #order_by
