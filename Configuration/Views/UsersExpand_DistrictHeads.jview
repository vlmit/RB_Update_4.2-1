      "Type": "$DepartmentRoles.HeadUserID"
    },
    {
      "Alias": "UserName",
      "Caption": "Глава",
      "Type": "$DepartmentRoles.HeadUserName"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "DepName",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "MultiSelect": true,
  "References": [
    {
      "CardType": "Roles",
      "ColPrefix": "Dep",
      "RefSection": [
        "Roles"
      ]
    },
