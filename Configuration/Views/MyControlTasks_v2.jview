[TEXTPART MyControlTasks_v2 MSSQL]


[TEXTPART MyControlTasks_v2 PGSQL]
with control_tasks as (
	select
			"dci"."ParentID", 
			"dci"."DocDate", 
			"dci"."AuthorID", 
			"ctp"."UserID", 
			"ctp"."UserName",
			coalesce("dci"."ExpandTextTask", "dci"."CommissionTemplateText") as "Resolution",
			"dci"."ManualStateID",
			"dci"."ManualStateName"
		from 
			"DocumentCommonInfo" as "dci"
			left join "ControlTaskDecisions" as "ctd"
				on "dci"."ID"="ctd"."ID"
			left join "ControlTaskPerformers" as "ctp"
				on "ctp"."ParentRowID"="ctd"."RowID"
		where
			"dci"."CardTypeID"='01ad498e-5f8e-417a-bd28-942739dbf342' --control task card type
			and ("dci"."AuthorID"=#param(CurrentUserID) or "ctp"."UserID"=#param(CurrentUserID))
			#if(MyTaskDate) 
			{ #param(MyTaskDate, "dci"."DocDate") } 
			#if(!MyTaskDate) 
			{and "dci"."DocDate">=current_timestamp-interval'7 days'}
)

select 
	#if(Normal) {
	"ID" as "DocID",
	"FullNumber" as "DocFullNumber",
	"DocDate",
	"Subject",
	"DepartmentName",
	"SignedByName",
	(select string_agg(ct."Resolution",', ') 
		from control_tasks as ct 
		where ct."ParentID"="d"."ID" and ct."UserID"=#param(CurrentUserID)) as "Resolution",
	(select string_agg(distinct "DocDate"::varchar(15),', ') 
		from control_tasks as ct 
		where ct."ParentID"="d"."ID" and ct."UserID"=#param(CurrentUserID) ) as "TaskDate",
	(select string_agg(distinct "ct"."AuthorName",', ') 
		from "DocumentCommonInfo" as "ct", "ControlTaskDecisions" as "ctd", "ControlTaskPerformers" as "ctp"
		where "ct"."ParentID"="d"."ID" and "ct"."ID"="ctd"."ID" and "ctp"."ParentRowID"="ctd"."RowID" 
		and "ctp"."UserID"=#param(CurrentUserID) ) as "AuthorName",
	(select string_agg(distinct "DocDate"::varchar(15), ', ')
		from control_tasks as ct
		where ct."ParentID"="d"."ID" and ct."AuthorID"=#param(CurrentUserID)) as "MyTaskDate",
	(select string_agg(distinct "ManualStateName",', ') 
		from control_tasks as ct
		where ct."ParentID"="d"."ID" and ct."AuthorID"=#param(CurrentUserID)) as "MyTaskState",
	(select string_agg(distinct ct."UserName",', ') 
		from control_tasks as ct
		where ct."ParentID"="d"."ID" and ct."AuthorID"=#param(CurrentUserID)) as "MyTaskPerformers"
	}
	#if(Count) { count(*)  as "cnt"} 
from
	"DocumentCommonInfo" as "d"
	
where
	"d"."ID" in (select "ParentID" 
				from control_tasks 
				where true 
				#param(MyTaskAuthorID, "AuthorID")
				#param(TaskPerformerID, "UserID")
				#param(ManualStateID, "ManualStateID")
				group by "ParentID")

#if(Normal) { 
order by #order_by
}
		
