{
  "Alias": "TaskAssignedRoleUsers_CurrentApproval",
  "Caption": "Список согласующих",
  "GroupName": "Testing",
  "ID": "f3ef8e0f-364a-47ae-bef0-940680815133",
  "JsonMetadataSource::txt": "TaskAssignedRoleUsers_CurrentApproval JSONMETA",
  "MsQuerySource::txt": "TaskAssignedRoleUsers_CurrentApproval MSSQL",
  "PgQuerySource::txt": "TaskAssignedRoleUsers_CurrentApproval PGSQL"
}

[TEXTPART TaskAssignedRoleUsers_CurrentApproval JSONMETA]
{
  "Alias": "TaskAssignedRoleUsers_CurrentApproval",
  "Caption": "Список согласующих",
  "Columns": [
    {
      "Alias": "UserID",
      "Hidden": true,
      "Type": "$Roles.ID"
    },
    {
      "Alias": "UserName",
      "Caption": "$Views_Users_Name",
      "SortBy": "t.Name",
      "Type": "$PersonalRoles.Name"
    },
    {
      "Alias": "Email",
      "Caption": "$Views_Users_Email",
      "Type": "$PersonalRoles.Email"
    },
    {
      "Alias": "Position",
      "Caption": "$Views_Users_Position",
      "Type": "$PersonalRoles.Position"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "UserName",
      "SortDirection": "Ascending"
    }
  ],
  "FormatVersion": 5,
  "MultiSelect": true,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_Users_Name_Param",
      "Type": "$RoleUsers.UserName"
    },
    {
      "Alias": "ShowHidden",
      "AllowedOperands": [
        "IsTrue",
        "IsFalse"
      ],
      "Caption": "$Views_Users_ShowHidden_Param",
      "Multiple": false,
      "Type": "Boolean Null"
    },
    {
      "Alias": "TaskRowID",
      "Hidden": true,
      "Type": "Guid Null"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "User",
      "DisplayValueColumn": "UserName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "TaskAssignedRoleUsers_CurrentApproval"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count"
    }
  ]
}

[TEXTPART TaskAssignedRoleUsers_CurrentApproval MSSQL]


[TEXTPART TaskAssignedRoleUsers_CurrentApproval PGSQL]
SELECT distinct
	#if(Normal) {
	"t"."ID"					AS "UserID",
	"pr"."Name"					AS "UserName",
	"pr"."Email"				AS "Email",
	"pr"."Position"				AS "Position"
	
	} {
	"t".*
	}
FROM (
	SELECT
		#if(Normal) {
		"t"."ID"
		}
		#if(Count) {
		count(*) AS "cnt"
		}
	FROM "Roles" AS "t"
	WHERE
			"t"."TypeID" = 1
			#param(Name, "t"."Name")

			
			AND "t"."ID" in (
				SELECT "RoleID" From "Tasks" as "ta"
				where ta."TypeID" = 'e4d7f6bf-fea9-4a3b-8a5a-e1a0a40de74c'
				and ta."ID" in (
				select "ta1"."ID" from "Tasks" AS "ta1" where 1 = 1 #param(TaskRowID, "ta1"."RowID"))				
				)
			
			#if(!ShowHidden || ShowHidden.CriteriaName != "IsTrue") {
			--не отображать скрытые
			AND "t"."Hidden" = false
			#if(Normal) {
				ORDER BY #order_by
			}
			}
	) AS "t"
#if(Normal) {
INNER JOIN "PersonalRoles" AS "pr"
	ON "pr"."ID" = "t"."ID"
	
LEFT JOIN (
    SELECT "ru"."UserID", "r1"."Name"
    FROM "RoleUsers" AS "ru"
    INNER JOIN "Roles" AS "r1" ON "r1"."ID" = "ru"."UserID"
    WHERE "ru"."TypeID" = 2
) AS "r1" ON "t"."ID" = "r1"."UserID"

LEFT JOIN (
    SELECT "ru"."UserID", "r2"."Name"
    FROM "RoleUsers" AS "ru"
    INNER JOIN "Roles" AS "r2" ON "r2"."ID" = "ru"."UserID"
    WHERE "ru"."TypeID" = 0
) AS "r2" ON "t"."ID" = "r2"."UserID"

group by "t"."ID", "pr"."Name", "pr"."Email", "pr"."Position"
}
#if(PageOffset) {
	OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
}
