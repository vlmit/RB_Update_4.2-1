[TEXTPART WorkflowEngineDialogFormTypes MSSQL]
SELECT
	[dt].[ID] as [DialogFormTypeID]
	,[dt].[Name] as [DialogFormTypeName]
FROM [WorkflowEngineDialogFormTypes] [dt] WITH(NOLOCK)
#if(Name) {
CROSS APPLY [Localization]([dt].[Name], #param(locale)) AS [lName]
}
WHERE 1 = 1
	#param(Name, [lName].[Value])
ORDER BY [dt].[ID]


[TEXTPART WorkflowEngineDialogFormTypes PGSQL]
SELECT
	"dt"."ID" as "DialogFormTypeID"
	,"dt"."Name" as "DialogFormTypeName"
FROM "WorkflowEngineDialogFormTypes" "dt"
#if(Name) {
CROSS JOIN "Localization"("dt"."Name", #param(locale)) AS "lName"
}
WHERE true
	#param(Name, "lName"."Value")
ORDER BY "dt"."ID"