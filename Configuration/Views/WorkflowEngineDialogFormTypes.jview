[TEXTPART WorkflowEngineDialogFormTypes JSONMETA]
{
  "Alias": "WorkflowEngineDialogFormTypes",
  "Caption": "$Views_Names_WorkflowEngineDialogFormTypes",
  "Columns": [
    {
      "Alias": "DialogFormTypeID",
      "Hidden": true,
      "Type": "$WorkflowEngineDialogFormTypes.ID"
    },
    {
      "Alias": "DialogFormTypeName",
      "Caption": "$Views_WorkflowEngineDialogFormTypes_Name",
      "FilterParameter": "Name",
      "FilterType": "Parameter",
      "Localizable": true,
      "Type": "$WorkflowEngineDialogFormTypes.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_WorkflowEngineDialogFormTypes_Name_Param",
      "Multiple": false,
      "Type": "$WorkflowEngineDialogFormTypes.Name"
