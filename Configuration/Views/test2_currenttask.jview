  "JsonMetadataSource::txt": "test2_currenttask JSONMETA",
  "MsQuerySource::txt": "test2_currenttask MSSQL",
  "PgQuerySource::txt": "test2_currenttask PGSQL"
}

[TEXTPART test2_currenttask JSONMETA]
{
  "Alias": "test2_currenttask",
  "Caption": "текущие задачи по документу",
  "Columns": [
    {
      "Alias": "NdsID",
      "Hidden": true,
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "RowID",
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "Planned",
      "Type": "$Tasks.Planned"
    },
    {
      "Alias": "Created",
      "Type": "$Tasks.Created"
    },
    {
      "Alias": "RoleID",
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "RoleName",
      "Caption": "RoleName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "UserName",
      "Caption": "UserName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "TypeCaption",
      "Caption": "TypeCaption",
      "Type": "$NDSRate.Rate"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "NdsID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "QuickSearchParam": "Rate"
}

[TEXTPART test2_currenttask MSSQL]


[TEXTPART test2_currenttask PGSQL]
SELECT
	"pt"."ID"		AS "ID",
	"pt"."RowID"	AS "RowID",
	"pt"."Planned"  AS "Planned",
	"pt"."Created"  AS "Created",
	"pt"."RoleID"		AS "RoleID",
	"pt"."RoleName"		AS "RoleName",
	"pt"."UserName"		AS "UserName",
	"pt"."TypeCaption"		AS "TypeCaption"
FROM "Tasks" AS "pt"

WHERE true --and "pt"."AccessLevelID" = 1
--and "pt"."ID" = '0fde0b99-2cf3-4f17-a270-510bae6e0dc2'
and "pt"."TypeID" = '5309ce42-c4d2-4e99-a733-697c589311e7'
--and "pt"."Created" > '2023-09-01'
and "pt"."RoleID" = 'd7e4bcae-89db-4a71-8a93-cd0dd84d1d6c'

ORDER BY "pt"."Created" desc
