[TEXTPART MyCompletedTasks_Control_RB MSSQL]
DECLARE @NoName			nvarchar(max);
#if(TypeParam) {
DECLARE @CardTypeID		uniqueidentifier;
}

SET @NoName = [dbo].[GetString](N'Views_CompletedTasks_NoName_Sql', #param(locale));

#if(TypeParam) {
-- индексы в DocumentCommonInfo устроены так, что нам быстрее сначала найти тип карточки по CardType, а потом тип документа
SET @CardTypeID = #param(TypeParam);

SELECT @CardTypeID = [CardTypeID]
FROM [KrDocType] WITH (NOLOCK)
WHERE [ID] = #param(TypeParam);
}

SELECT
	[th].[ID]											AS [CardID],
	COALESCE([dci].[FullNumber], @NoName)				AS [CardName],
	[dci].[DocTypeTitle]								AS [CardTypeCaption],
	[dci].[Subject],
	[th].[TypeID],
	COALESCE([th].[KindCaption], [th].[TypeCaption])	AS [TypeCaption],
	[th].[OptionID],
	[th].[OptionCaption],
	[th].[Result],
	[th].[RoleID],
	[th].[RoleName],
	[th].[AuthorID],
	[th].[AuthorName],
	[th].[Completed],
	[t].[rn]
FROM (
	SELECT
		[th].[RowID],
		row_number() OVER (ORDER BY #order_by) AS [rn]
	FROM [TaskHistory] AS [th] WITH (NOLOCK)
	#if(TypeParam) {
	LEFT JOIN [DocumentCommonInfo] AS [dci] WITH (NOLOCK)
		ON [dci].[ID] = [th].[ID]
	}
	WHERE [th].[Completed] IS NOT NULL
		#param(CompletionDate, [th].[Completed])
		#param(TaskType, [th].[TypeID])
		#param(SelUser, [th].[UserID])
		#param(Option, [th].[OptionID])

		#if(FromMeMode && FromMeMode.Value == 1) {
		AND [th].[AuthorID] = #param(CurrentUserID)
		} {
		AND [th].[UserID] = #param(CurrentUserID)
		}

		#if(Role) {
		AND EXISTS (
			SELECT NULL
			FROM [RoleUsers] AS [ru] WITH (NOLOCK)
			WHERE [ru].[UserID] = [th].[UserID] #param(Role, [ru].[ID])
			)
		}

		#if(TypeParam) {
		AND [dci].[CardTypeID] = @CardTypeID
		AND COALESCE([dci].[DocTypeID], [dci].[CardTypeID]) = #param(TypeParam)
		}
	) AS [t]
INNER JOIN [TaskHistory] AS [th] WITH (NOLOCK)
	ON [th].[RowID] = [t].[RowID]
LEFT JOIN [DocumentCommonInfo] AS [dci] WITH (NOLOCK)
	ON [dci].[ID] = [th].[ID]
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}
;

[TEXTPART MyCompletedTasks_Control_RB PGSQL]
DECLARE
	"no_name"		text;
	#if(TypeParam) {
	"card_type_id"	uuid;
	}
BEGIN
	"no_name" = "GetString"('Views_CompletedTasks_NoName_Sql', #param(locale));

	#if(TypeParam) {
	-- индексы в DocumentCommonInfo устроены так, что нам быстрее сначала найти тип карточки по CardType, а потом тип документа

	SELECT "CardTypeID"
	INTO "card_type_id"
	FROM "KrDocType"
	WHERE "ID" = #param(TypeParam);
	
	IF "card_type_id" IS NULL THEN
		"card_type_id" = #param(TypeParam);
	END IF;
	}

	RETURN QUERY
	SELECT
		"th"."ID"											AS "CardID",
		COALESCE("dci"."FullNumber", "no_name")				AS "CardName",
		"dci"."DocTypeTitle"								AS "CardTypeCaption",
		"dci"."Subject",
		"th"."TypeID",
		COALESCE("th"."KindCaption", "th"."TypeCaption")	AS "TypeCaption",
		"th"."OptionID",
		"th"."OptionCaption",
		"th"."Result",
		"th"."RoleID",
		"th"."RoleName",
		"th"."AuthorID",
		"th"."AuthorName",
		"th"."Completed",
		"dci"."AuthorID"											AS "DocAuthorID",
			"dci"."AuthorName"											AS "DocAuthorName",
			"dci"."ControllerID"										AS "DocRegistratorID",
			"dci"."ControllerName"										AS "DocRegistratorName",
			"dci"."TaskDeadline"										AS "DocTaskDeadline",
			"dci"."TaskFact"											AS "DocTaskFact",
			"dci"."SignedByID"											AS "DocSignedByID",
			"dci"."SignedByName"										AS "DocSignedByName",
		0::int8												AS "rn"
	FROM (
		SELECT
			"th"."RowID"
		FROM "TaskHistory" AS "th"
		#if(TypeParam) {
		LEFT JOIN "DocumentCommonInfo" AS "dci"
			ON "dci"."ID" = "th"."ID"
		}
		-- введен
		WHERE "th"."Completed" IS NOT NULL
			#param(CompletionDate, "th"."Completed")
			#param(TaskType, "th"."TypeID")
			#param(SelUser, "th"."UserID")
			#param(Option, "th"."OptionID")
			#param(Subject, (SELECT "dci"."Subject" FROM "DocumentCommonInfo" AS "dci" WHERE "dci"."ID" = "th"."ID"))
			#param(DocNumber, (SELECT "dci"."FullNumber" FROM "DocumentCommonInfo" AS "dci" WHERE "dci"."ID" = "th"."ID"))
			#param(OptionCaption, "th"."OptionCaption")
			#param(Result, "th"."Result")
			#param(RoleName, "th"."RoleName")
			#param(AuthorName, "th"."AuthorName")
			
			#if(FromMeMode && FromMeMode.Value == 1) {
			AND "th"."AuthorID" = #param(CurrentUserID)
			} {
			AND "th"."UserID" = #param(CurrentUserID)
			}

			#if(Role) {
			AND EXISTS (
				SELECT NULL
				FROM "RoleUsers" AS "ru"
				WHERE "ru"."UserID" = "th"."UserID" #param(Role, "ru"."ID")
				)
			}

			#if(TypeParam) {
			AND "dci"."CardTypeID" = "card_type_id"
			AND COALESCE("dci"."DocTypeID", "dci"."CardTypeID") = #param(TypeParam)
			}
		#if(Normal) {
		ORDER BY #order_by
		}
		#if(PageOffset) {
		OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
		}
		) AS "t"
	INNER JOIN "TaskHistory" AS "th"
		ON "th"."RowID" = "t"."RowID"
	LEFT JOIN "DocumentCommonInfo" AS "dci"
		ON "dci"."ID" = "th"."ID"
	#if(Normal) {
	ORDER BY #order_by
	};
END;
