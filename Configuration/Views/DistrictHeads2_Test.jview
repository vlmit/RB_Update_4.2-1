[TEXTPART DistrictHeads2_Test JSONMETA]
{
  "Alias": "DistrictHeads2_Test",
  "Caption": "Глобальный список",
  "Columns": [
    {
      "Alias": "UserID",
      "Hidden": true,
      "Type": "$RoleUsers.UserID"
    },
    {
      "Alias": "UserName",
      "Caption": "Сотрудник",
      "SortBy": "UserName",
      "Type": "$RoleUsers.UserName"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "UserName",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "MultiSelect": true,
