[TEXTPART RB_IncomingDocuments MSSQL]
#var(UseCommonInfo: Normal || ByDocType || Partner || Number || Subject || DocDate || DocType || IsRegistrator || Registrator || Department || CreationDate || OutgoingNumber)

SELECT
	#if(Normal) {
	[t].[ID]																	AS [DocID],
	[t].[FullNumber]															AS [DocNumber],
	[t].[DocTypeTitle]															AS [SubTypeTitle],
	[t].[Subject]																AS [DocSubject],
	COALESCE([t].[FullNumber], N'') + N', ' + COALESCE([t].[Subject], N'')		AS [DocDescription],		-- autocomplete
	[t].[PartnerID]																AS [PartnerID],
	[t].[PartnerName]															AS [PartnerName],
	[t].[OutgoingNumber]														AS [OutgoingNumber],
	[t].[RegistratorID]															AS [RegistratorID],
	[t].[RegistratorName]														AS [RegistratorName],
	[t].[DocDate]																AS [DocDate],
	CAST([t].[CreationDate] AS date)											AS [CreationDate],
	[t].[DepartmentName]														AS [Department]
	}
	#if(ByDocType) {
	[t].[SubTypeID],
	[kdt].[Title]																AS [SubTypeTitle],
	[t].[SubTypeCount]
	}
	#if(ByState | Count) {
	[t].*
	}
FROM (
	SELECT
		#if(Normal) {
		[mi].[ID],
		[mi].[FullNumber],
		[mi].[DocTypeTitle],
		[mi].[Subject],
		[mi].[PartnerID],
		[mi].[PartnerName],
		[mi].[OutgoingNumber],
		[mi].[RegistratorID],
		[mi].[RegistratorName],
		[mi].[DocDate],
		[mi].[CreationDate],
		[mi].[DepartmentName],
		[t].[rn]
		}
		#if(ByDocType | ByState) {
		[t].*
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM (
		SELECT
			#if(Normal || Count) {
			[mi].[ID]
			}
			#if(Normal) {,
			row_number() OVER (ORDER BY #order_by) AS [rn]
			}
			#if(ByDocType) {
			[mi].[DocTypeID]									AS [SubTypeID],
			count(*)											AS [SubTypeCount]
			}
			#if(ByState) {
			COALESCE([kr].[StateID], CAST(0 AS smallint))		AS [StateID],
			COALESCE([kr].[StateName], N'$KrStates_Doc_Draft')	AS [StateName],
			count(*)											AS [StateCount]
			}
		#if(UseCommonInfo) {
		FROM [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		} {
		FROM [Instances] AS [mi] WITH (NOLOCK) -- алиас [mi] должен быть таким же, как у DocumentCommonInfo
		}
		#if(ByState || State || IsInitiator) {
		LEFT JOIN [KrApprovalCommonInfo] AS [kr] WITH (NOLOCK)
			ON [kr].[MainCardID] = [mi].[ID]
		}
		WHERE
			#if(UseCommonInfo) {
			[mi].[CardTypeID]
			} {
			[mi].[TypeID]
			}
			= '001f99fd-5bf3-0679-9b6f-455767af72b5'	--Incoming
			#param(Partner, [mi].[PartnerID])
			#param(Number, [mi].[FullNumber])
			#param(OutgoingNumber, [mi].[OutgoingNumber])
			#param(Subject, [mi].[Subject])
			#param(DocDate, [mi].[DocDate])
			#param(State, COALESCE([kr].[StateID], 0))
			#param(DocType, [mi].[DocTypeID])
			#param(Registrator, [mi].[RegistratorID])
			#param(Department, [mi].[DepartmentID])
			#param(CreationDate, [mi].[CreationDate])
			#if(IsRegistrator) {
				#if(IsRegistrator.CriteriaName == "IsTrue") {
			AND [mi].[RegistratorID] = #param(CurrentUserID)
				} {
			AND ([mi].[RegistratorID] IS NULL OR [mi].[RegistratorID] <> #param(CurrentUserID))
				}
			}
			#if(IsInitiator) {
				#if(IsInitiator.CriteriaName == "IsTrue") {
			AND [kr].[AuthorID] = #param(CurrentUserID)
				} {
			AND ([kr].[AuthorID] IS NULL OR [kr].[AuthorID] <> #param(CurrentUserID))
				}
			}
		#if(ByDocType) {
		GROUP BY [mi].[DocTypeID]
		}
		#if(ByState) {
		GROUP BY COALESCE([kr].[StateID], CAST(0 AS smallint)), COALESCE([kr].[StateName], N'$KrStates_Doc_Draft')
		}
		) AS [t]
	#if(Normal) {
	INNER JOIN [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		ON [mi].[ID] = [t].[ID]
	}
	#if(PageOffset) {
	WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
	}
	) AS [t]
#if(Normal) {
ORDER BY [t].[rn]
}
#if(ByState) {
CROSS APPLY [Localization]([t].[StateName], #param(locale)) AS [sls] --Локализуем состояние документа
ORDER BY [sls].[Value]
}
#if(ByDocType) {
INNER JOIN [KrDocType] AS [kdt] WITH (NOLOCK)
	ON [kdt].[ID] = [t].[SubTypeID]
CROSS APPLY [Localization]([kdt].[Title], #param(locale)) AS [tls] --Локализуем тип документа
ORDER BY [tls].[Value]
}
;

[TEXTPART RB_IncomingDocuments PGSQL]
#var(UseCommonInfo: Normal || ByDocType || Partner || Number || Subject || DocDate || DocType || IsRegistrator || Registrator || Department || CreationDate || OutgoingNumber)

SELECT
	#if(Normal) {
	"t"."ID"																	AS "DocID",
	"t"."FullNumber"															AS "DocNumber",
	"t"."DocDate"																AS "DocDate",
	
	"t"."Subject"																AS "DocSubject",
	"t"."DocTypeTitle"															AS "SubTypeTitle",
	COALESCE("t"."FullNumber", '') || ', ' || COALESCE("t"."Subject", '')		AS "DocDescription",		-- autocomplete
	"t"."PartnerID"																AS "PartnerID",
	"t"."PartnerName"															AS "PartnerName",
	"t"."OutgoingNumber"														AS "OutgoingNumber",
	"t"."RegistratorID"															AS "RegistratorID",
	"t"."RegistratorName"														AS "RegistratorName",
	
	CAST("t"."CreationDate" AS date)											AS "CreationDate",
	"t"."DepartmentName"														AS "Department"
	}
	#if(ByDocType) {
	"t"."SubTypeID",
	"kdt"."Title"																AS "SubTypeTitle",
	"t"."SubTypeCount"
	}
	#if(ByState) {
	"t".*
	}
FROM (
	SELECT
		#if(Normal) {
		"mi"."ID",
		"mi"."FullNumber",
		"mi"."DocTypeTitle",
		"mi"."Subject",
		"mi"."PartnerID",
		"mi"."PartnerName",
		"mi"."OutgoingNumber",
		"mi"."RegistratorID",
		"mi"."RegistratorName",
		"mi"."DocDate",
		"mi"."CreationDate",
		"mi"."DepartmentName",
		"mi"."ExternalGuid"
		}
		#if(ByDocType | ByState) {
		"t".*
		}
	FROM (
		SELECT
			#if(Normal) {
			"mi"."ID"
			}
			#if(ByDocType) {
			"mi"."DocTypeID"									AS "SubTypeID",
			count(*)											AS "SubTypeCount"
			}
			#if(ByState) {
			COALESCE("kr"."StateID", CAST(0 AS smallint))		AS "StateID",
			COALESCE("kr"."StateName", '$KrStates_Doc_Draft')	AS "StateName",
			count(*)											AS "StateCount"
			}
		#if(UseCommonInfo) {
		FROM "DocumentCommonInfo" AS "mi"
		} {
		FROM "Instances" AS "mi"	 -- алиас "mi" должен быть таким же, как у DocumentCommonInfo
		}
		#if(ByState || State || IsInitiator) {
		LEFT JOIN "KrApprovalCommonInfo" AS "kr"
			ON "kr"."MainCardID" = "mi"."ID"
		}
		WHERE
			
			#if(UseCommonInfo) {
			"mi"."ID" != '1826344c-904c-48d7-b604-e46bbb318175' and
			"mi"."CardTypeID"
			} {
			"mi"."ID" != '1826344c-904c-48d7-b604-e46bbb318175' and
			"mi"."TypeID"
			}
			= 'ed6d5ee1-9075-4ce0-bdae-76afe87544f2'		-- Incoming
			#param(Partner, "mi"."PartnerID")
			#param(Number, "mi"."FullNumber")
			#param(OutgoingNumber, "mi"."OutgoingNumber")
			#param(Subject, "mi"."Subject")
			#param(DocDate, "mi"."DocDate")
			#param(State, COALESCE("kr"."StateID", 0))
			#param(DocType, "mi"."DocTypeID")
			#param(Registrator, "mi"."RegistratorID")
			#param(Department, "mi"."DepartmentID")
			#param(CreationDate, "mi"."CreationDate")
			#param(ExternalGuid, "mi"."ExternalGuid")
			#if(IsRegistrator) {
				#if(IsRegistrator.CriteriaName == "IsTrue") {
			AND "mi"."RegistratorID" = #param(CurrentUserID)
				} {
			AND ("mi"."RegistratorID" IS NULL OR "mi"."RegistratorID" <> #param(CurrentUserID))
				}
			}
			#if(IsInitiator) {
				#if(IsInitiator.CriteriaName == "IsTrue") {
			AND "kr"."AuthorID" = #param(CurrentUserID)
				} {
			AND ("kr"."AuthorID" IS NULL OR "kr"."AuthorID" <> #param(CurrentUserID))
				}
			}
		#if(ByDocType) {
		GROUP BY "mi"."DocTypeID"
		}
		#if(ByState) {
		GROUP BY COALESCE("kr"."StateID", CAST(0 AS smallint)), COALESCE("kr"."StateName", '$KrStates_Doc_Draft')
		}
		) AS "t"
	#if(Normal) {
	INNER JOIN "DocumentCommonInfo" AS "mi"
		ON "mi"."ID" = "t"."ID"
	ORDER BY #order_by
	}
	#if(PageOffset) {
	OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
	}
	) AS "t"
#if(ByState) {
CROSS JOIN "Localization"("t"."StateName", #param(locale)) AS "sls" --Локализуем состояние документа
ORDER BY "sls"."Value"
}
#if(ByDocType) {
INNER JOIN "KrDocType" AS "kdt"
	ON "kdt"."ID" = "t"."SubTypeID"
CROSS JOIN "Localization"("kdt"."Title", #param(locale)) AS "tls" --Локализуем тип документа
ORDER BY "tls"."Value"
}
