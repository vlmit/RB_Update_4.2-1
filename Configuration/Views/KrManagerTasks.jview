[TEXTPART KrManagerTasks JSONMETA]
{
  "Alias": "KrManagerTasks",
  "Caption": "$Views_Names_KrManagerTasks",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$Tasks.TypeID"
    },
    {
