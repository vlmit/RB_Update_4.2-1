{
  "Alias": "Control Tasks - Tasks",
  "Caption": "Поручения - Задачи",
  "GroupName": "NewTasks",
  "ID": "0bce7b16-882c-4b16-92ed-e1a6f070b753",
  "JsonMetadataSource::txt": "Control Tasks - Tasks JSONMETA",
  "MsQuerySource::txt": "Control Tasks - Tasks MSSQL",
  "PgQuerySource::txt": "Control Tasks - Tasks PGSQL"
}

[TEXTPART Control Tasks - Tasks JSONMETA]
{
  "Alias": "Control Tasks - Tasks",
  "Caption": "Поручения - Задачи",
  "Columns": [
    {
      "Alias": "ID",
      "Type": "$DocumentCommonInfo.ID"
    },
    {
      "Alias": "FullNumber",
      "Type": "$DocumentCommonInfo.FullNumber"
    },
    {
      "Alias": "CategoryName",
      "Type": "$DocumentCommonInfo.CategoryName"
    },
    {
      "Alias": "ManualStateID",
      "Type": "$DocumentCommonInfo.ManualStateID"
    },
    {
      "Alias": "ManualStateName",
      "Type": "$DocumentCommonInfo.ManualStateName"
    },
    {
      "Alias": "ParentID",
      "Type": "$DocumentCommonInfo.ParentID"
    },
    {
      "Alias": "ParentDescription",
      "Type": "$DocumentCommonInfo.ParentDescription"
    },
    {
      "Alias": "TypeCaption",
      "Type": "$Tasks.TypeCaption"
    },
    {
      "Alias": "StateID",
      "Type": "$Tasks.StateID"
    },
    {
      "Alias": "StateName",
      "Type": "$TaskStates.Name"
    },
    {
      "Alias": "Digest",
      "Type": "$Tasks.Digest"
    },
    {
      "Alias": "RoleName",
      "Type": "$Tasks.RoleName"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "ManualStateID",
      "Caption": "ManualStateID",
      "Multiple": false,
      "Type": "$DocumentCommonInfo.ManualStateID"
    }
  ]
}

[TEXTPART Control Tasks - Tasks MSSQL]


[TEXTPART Control Tasks - Tasks PGSQL]
select
	"dci"."ID" as "ID",
	"FullNumber",
	"CategoryName",
	"ManualStateID",
	"ManualStateName",
	"dci"."ParentID" as "ParentID",
	"ParentDescription",
	"TypeCaption",
	"StateID",
	"ts"."Name" as "StateName",
	"Digest",
	"RoleName"
from
	"DocumentCommonInfo" as "dci",
	"Tasks" as "t",
	"TaskStates" as "ts"
where
	"CardTypeID"='01ad498e-5f8e-417a-bd28-942739dbf342'
	and "dci"."ParentID"="t"."ID"
	and "t"."StateID"="ts"."ID"
	--and "dci"."ParentID"='c53782bd-5b3d-4910-8fe5-516d56a3b5c1'
	#param(ManualStateID, "ManualStateID")
limit 30
