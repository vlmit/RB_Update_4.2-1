      "Alias": "PlatformVersion",
      "Caption": "$Views_Applications_PlatformVersion",
      "Type": "$Applications.PlatformVersion"
    },
    {
      "Alias": "Modified",
      "Hidden": true,
      "Type": "$Instances.Modified"
    },
    {
      "Alias": "GroupName",
      "Caption": "$Views_Applications_GroupName",
      "Hidden": true,
      "Type": "$Applications.GroupName"
    },
    {
      "Alias": "LocalizedGroupName",
