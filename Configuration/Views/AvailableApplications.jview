{
  "Alias": "AvailableApplications",
  "Caption": "$Views_Names_AvailableApplications",
  "Description": "Используется в TessaAppManager для проверки необходимости обновлений и для определения, доступности приложение пользователю",
  "GroupName": "System",
  "ID": "1a272344-a020-452a-b6e9-3720064ed760",
  "JsonMetadataSource::txt": "AvailableApplications JSONMETA",
  "MsQuerySource::txt": "AvailableApplications MSSQL",
  "PgQuerySource::txt": "AvailableApplications PGSQL",
  "Roles": [
    {
      "RoleId": "7ff52dc0-ff6a-4c9d-ba25-b562c370004d"
    }
  ]
}

[TEXTPART AvailableApplications JSONMETA]
{
  "Alias": "AvailableApplications",
  "Caption": "$Views_Names_AvailableApplications",
  "Columns": [
    {
      "Alias": "ID",
      "Hidden": true,
      "Type": "$Applications.ID"
    },
    {
      "Alias": "Name",
      "Caption": "$Views_Applications_Name",
      "SortBy": "t.Name",
      "Type": "$Applications.Name"
    },
    {
      "Alias": "Alias",
      "Caption": "$Views_Applications_Alias",
      "FilterParameter": "Alias",
      "FilterType": "Parameter",
      "Type": "$Applications.Alias"
    },
    {
      "Alias": "Icon",
      "Hidden": true,
      "Type": "$Applications.Icon"
    },
    {
      "Alias": "Client64Bit",
      "Caption": "$Views_Applications_Client64Bit",
      "FilterParameter": "Client64Bit",
      "FilterType": "Parameter",
      "Type": "$Applications.Client64Bit"
    },
    {
      "Alias": "ExecutableFileName",
      "Caption": "$Views_Applications_ExecutableFileName",
      "Type": "$Applications.ExecutableFileName"
    },
    {
      "Alias": "ForAdmin",
      "Caption": "$Views_Applications_ForAdmin",
      "Type": "$Applications.ForAdmin"
    },
    {
      "Alias": "AppManagerApiV2",
      "Hidden": true,
      "Type": "Boolean Not Null"
    },
    {
      "Alias": "Hidden",
      "Caption": "Скрывать приложение в AppManager-e",
      "Hidden": true,
      "Type": "$Applications.Hidden"
    },
    {
      "Alias": "AppVersion",
      "Caption": "$Views_Applications_AppVersion",
      "Type": "$Applications.AppVersion"
    },
