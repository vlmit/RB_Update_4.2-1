      },
      "Order": 0,
      "TypeName": "Tessa.Extensions.Default.Client.Views.CreateCardExtension"
    }
  ],
  "FormatVersion": 5,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "Title",
      "Caption": "Наименование",
      "Multiple": false,
