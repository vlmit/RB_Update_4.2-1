      "Caption": "Статус",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "LinkedStaticRoleID",
      "Hidden": true,
      "Type": "$PersonalList.LinkedStaticRoleID"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "PLTitle",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "Extensions": [
    {
      "Data": {
        "CardCreationKind": "ByTypeAlias",
