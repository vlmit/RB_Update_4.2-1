{
  "Alias": "ControlTask_History",
  "Caption": "История изменений",
  "GroupName": "Custom",
  "ID": "7518a512-d867-4cf3-b81f-4acba3156aab",
  "JsonMetadataSource::txt": "ControlTask_History JSONMETA",
  "MsQuerySource::txt": "ControlTask_History MSSQL",
  "PgQuerySource::txt": "ControlTask_History PGSQL"
}

[TEXTPART ControlTask_History JSONMETA]
{
  "Alias": "ControlTask_History",
  "Caption": "История изменений",
  "Columns": [
    {
      "Alias": "Modified",
      "Caption": "Дата",
      "Type": "$ActionHistory.Modified"
    },
    {
      "Alias": "Name",
      "Caption": "Действие",
      "Localizable": true,
      "Type": "$ActionTypes.Name"
    },
    {
      "Alias": "Request",
      "Caption": "Поручение",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Request2",
      "Caption": "Содержание поручения",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Reguest3",
      "Caption": "Плановая дата",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Performer1",
      "Caption": "Исполнитель",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "ModifiedByName",
      "Caption": "Сотрудник",
      "Type": "$ActionHistory.ModifiedByName"
    },
    {
      "Alias": "Request3",
      "Hidden": true,
      "Type": "$ActionHistory.Request"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "CardID",
      "Caption": "Card ID",
      "Multiple": false,
      "Type": "$DocumentCommonInfo.ID"
    }
  ]
}

[TEXTPART ControlTask_History MSSQL]


[TEXTPART ControlTask_History PGSQL]
select
	"Modified",
	"at"."Name",
	"Request"::json#>>'{Card,Sections,DocumentCommonInfo,Fields,CommissionTemplateText}' as "Request",
	"Request"::json#>>'{Card,Sections,DocumentCommonInfo,Fields,ExpandTextTask}' as "Request2",
	--"Request"::json->>'ExpandTextTask' as "Request2",
	"Request"::json#>>'{Card,Sections,DocumentCommonInfo,Fields,TaskDeadline::dtm}' as "Request3",
	(select string_agg(value->>'UserName', ', ') 
		from (select json_array_elements("Request"::json#>'{Card,Sections,ControlTaskPerformers,Rows}') as value) as s) as "Performer1",
	"ModifiedByName",
	"Request" as "Request3"
from
	"ActionHistory" as "ah"
	left join "ActionTypes" as "at"
		on "ah"."ActionID"="at"."ID"
where
	true
	--"ah"."ID"='a01c1d45-dce2-4dc4-891e-18048afea509'  --кп-403520
	--"ah"."ID"='8c60c01f-9bd4-4a10-b449-8f2eecc9c015'
	--"ah"."ID"='89b6a01f-85dd-42b0-b04f-c12cb5257c8e'
	and ("ActionID"=1 or "ActionID"=3)
	#param(CardID, "ah"."ID")
order by "Modified" desc
