{
  "Alias": "BlockedCards",
  "Caption": "Список потенциально заблокированных документов",
  "GroupName": "Testing",
  "ID": "8da39b87-a74d-4821-a355-baa9f0c49fd6",
  "JsonMetadataSource::txt": "BlockedCards JSONMETA",
  "MsQuerySource::txt": "BlockedCards MSSQL",
  "PgQuerySource::txt": "BlockedCards PGSQL"
}

[TEXTPART BlockedCards JSONMETA]
{
  "Alias": "BlockedCards",
  "Caption": "Список потенциально заблокированных документов",
  "Columns": [
    {
      "Alias": "ID",
      "Type": "$Instances.ID"
    },
    {
      "Alias": "TypeCaption",
      "Type": "$Instances.TypeCaption"
    },
    {
      "Alias": "WritePending",
      "Type": "$Instances.WritePending"
    },
    {
      "Alias": "Readers",
      "Type": "$Instances.Readers"
    },
    {
      "Alias": "ModifiedByName",
      "Type": "$Instances.ModifiedByName"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART BlockedCards MSSQL]


[TEXTPART BlockedCards PGSQL]
select
	"ID",
	"TypeCaption",
	"WritePending",
	"Readers",
	"ModifiedByName"
from "Instances"
where
	"Readers">0
	or "WritePending" is true
