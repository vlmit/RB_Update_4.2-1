  "JsonMetadataSource::txt": "IncomingMEDO JSONMETA",
  "MsQuerySource::txt": "IncomingMEDO MSSQL",
  "PgQuerySource::txt": "IncomingMEDO PGSQL"
}

[TEXTPART IncomingMEDO JSONMETA]
{
  "Alias": "IncomingMEDO",
  "Caption": "Входящие МЭДО",
  "Columns": [
    {
      "Alias": "DocID",
      "Hidden": true,
      "Type": "$DocumentCommonInfo.ID"
    },
    {
      "Alias": "DocNumber",
      "Caption": "Номер",
      "SortBy": "mi.FullNumber",
      "Type": "$DocumentCommonInfo.FullNumber"
    },
    {
      "Alias": "DocDate",
      "Caption": "Дата регистрации",
      "SortBy": "mi.DocDate",
      "Type": "$DocumentCommonInfo.DocDate"
    },
    {
      "Alias": "Subject",
      "Caption": "Тема",
      "SortBy": "mi.Subject",
      "Type": "$DocumentCommonInfo.Subject"
    },
    {
      "Alias": "RegistratorName",
      "Caption": "Регистратор",
      "SortBy": "mi.RegistratorName",
      "Type": "$DocumentCommonInfo.RegistratorName"
    },
    {
      "Alias": "StateName",
      "Caption": "Состояние",
      "Localizable": true,
      "Type": "$KrApprovalCommonInfo.StateName"
    },
    {
      "Alias": "Correspondent",
      "Caption": "Корреспондент",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "CreationDate",
      "Caption": "Дата создания",
      "SortBy": "mi.CreationDate",
      "Type": "$DocumentCommonInfo.CreationDate"
    },
    {
      "Alias": "Department",
      "Caption": "Подразделение",
      "Type": "$DocumentCommonInfo.DepartmentName"
    },
    {
      "Alias": "OutgoingNumber",
      "Caption": "№ внеш.",
      "Type": "$DocumentCommonInfo.OutgoingNumber"
    },
    {
      "Alias": "MEDOFolderName",
      "Caption": "Папка МЭДО",
      "Type": "$DocumentCommonInfo.MEDOFolderName"
    },
    {
      "Alias": "GriffMedoID",
      "Hidden": true,
      "Type": "$DocumentCommonInfo.GriffMedoID"
    },
    {
      "Alias": "GrifMedo",
      "Caption": "Гриф МЭДО",
      "Type": "$DocumentCommonInfo.GriffMedoName"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "CreationDate",
      "SortDirection": "Descending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "MultiSelect": true,
  "PageLimit": 20,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "FullNumber",
      "Caption": "Номер",
      "Multiple": false,
      "Type": "$DocumentCommonInfo.FullNumber"
    },
    {
      "Alias": "DocDate",
      "AllowedOperands": [
        "Between",
        "Equality",
        "GreatOrEquals",
        "GreatThan",
        "IsNotNull",
        "IsNull",
        "LessOrEquals",
        "LessThan"
      ],
      "Caption": "Дата регистрации",
      "Type": "Date Null"
    },
    {
      "Alias": "Subject",
      "Caption": "Тема",
      "Multiple": false,
      "Type": "$DocumentCommonInfo.Subject"
    },
    {
      "Alias": "Correspondent",
      "AutoCompleteInfo": {
        "ParamAlias": "Name",
        "RefPrefix": "Partner",
        "ViewAlias": "Partners"
      },
      "Caption": "Корреспондент",
      "Multiple": false,
      "RefSection": [
        "Partners"
      ],
      "Type": "$Correspondents.PartnersID"
    },
    {
      "Alias": "CreationDate",
      "AllowedOperands": [
        "Between",
        "GreatOrEquals",
        "GreatThan",
        "Equality",
        "IsNotNull",
        "IsNull",
        "LessOrEquals",
        "LessThan"
      ],
      "Caption": "Дата создания",
      "Type": "$DocumentCommonInfo.CreationDate"
    },
    {
      "Alias": "Department",
      "AutoCompleteInfo": {
        "ParamAlias": "Name",
        "PopupColumns": [
          1,
          3,
          5
        ],
        "ViewAlias": "Departments"
      },
      "Caption": "Подразделение",
      "Multiple": false,
      "RefSection": [
        "DepartmentRoles"
      ],
      "Type": "$DocumentCommonInfo.DepartmentID"
    },
    {
      "Alias": "OutgoingNumber",
      "Caption": "№ внеш.",
      "Multiple": false,
      "Type": "$DocumentCommonInfo.OutgoingNumber"
    },
    {
      "Alias": "MEDOFolder",
      "Caption": "Папка МЭДО",
      "Multiple": false,
      "Type": "$DocumentCommonInfo.MEDOFolderName"
    },
    {
      "Alias": "GrifMedo",
      "AllowedOperands": [
        "IsTrue",
        "IsFalse"
      ],
      "Caption": "Только ДСП МЭДО",
      "Multiple": false,
      "Type": "Boolean Null"
    }
  ],
  "References": [
    {
      "ColPrefix": "Doc",
      "DisplayValueColumn": "DocNumber",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "DocumentCommonInfo"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count",
      "CountColumn": "cnt"
    }
  ]
}

[TEXTPART IncomingMEDO MSSQL]


[TEXTPART IncomingMEDO PGSQL]

select
	#if(Normal) 
	{ 
	"mi"."ID" as "DocID",
	"mi"."FullNumber" as "DocNumber",
	"mi"."DocDate" as "DocDate",
	"mi"."Subject" as "Subject",
	"mi"."RegistratorName" as "RegistratorName",
	"kr"."StateName" as "StateName",
    "cr"."PartnersName" as "Correspondent",
	"mi"."CreationDate" as "CreationDate",
	"mi"."DepartmentName" as "DepartmentName",
	"mi"."OutgoingNumber" as "OutgoingNumber",
	"mi"."MEDOFolderName" as "MEDOFolderName",
	"mi"."GriffMedoID" as "GriffMedoID",
	"mi"."GriffMedoName" as "GrifMedo"
	}
	#if(Count) 
	{ 
	count(*)
	} 
from
	"DocumentCommonInfo" as "mi", "KrApprovalCommonInfo" AS "kr","Correspondents" as "cr" 
where 
	true
	and "kr"."MainCardID" = "mi"."ID"
	and "cr"."ID"="mi"."ID"
	and "mi"."CardTypeID"='50b3b84a-ba01-4a4f-a8b4-fd83fa5b8e72'
	#param(DocNumber, "mi"."FullNumber")
	#param(DocDate, "mi"."DocDate")
	#param(Subject, "mi"."Subject")
	#param(Correspondent, "cr"."PartnersID")
	#param(CreationDate, "mi"."CreationDate")
	#param(Department, "mi"."DepartmentID")
	#param(OutgoingNumber, "mi"."OutgoingNumber")
	#param (MEDOFolder, "mi"."MEDOFolderName")
	#if(GrifMEDO &&GrifMEDO.Value=true ) 
	{ and "mi"."GriffMedoName"!='Обычная информация' } 
	#if(GrifMEDO &&GrifMEDO.Value=false ) 
	{ and ("mi"."GriffMedoName"='Обычная информация' or  "mi"."GriffMedoName" is null)}
	
	--#param(GrifMEDO, "mi"."GriffMedoID")
#if(Normal) 
{ order by #order_by} 
#if(PageOffset) {
 OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}

	
