  "JsonMetadataSource::txt": "MEDOFileSignatures JSONMETA",
  "MsQuerySource::txt": "MEDOFileSignatures MSSQL",
  "PgQuerySource::txt": "MEDOFileSignatures PGSQL"
}

[TEXTPART MEDOFileSignatures JSONMETA]
{
  "Alias": "MEDOFileSignatures",
  "Caption": "МЕДО Подписи",
  "Columns": [
    {
      "Alias": "FsRowID",
      "Hidden": true,
      "Type": "GUID"
    },
    {
      "Alias": "FsUserName",
      "Caption": "Подписант",
      "Type": "String"
    },
    {
      "Alias": "FsSigned",
      "Caption": "Подписан",
      "Type": "DateTime"
    },
    {
      "Alias": "FsSerialNumber",
      "Caption": "Сертификат",
      "Type": "String"
    },
    {
      "Alias": "FsCardID",
      "Hidden": true,
      "Type": "GUID"
    },
    {
      "Alias": "FsFileName",
      "Caption": "Имя файла",
      "Type": "String"
    },
    {
      "Alias": "FsID",
      "Hidden": true,
      "Type": "GUID"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "FsSigned",
      "SortDirection": "Ascending"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "CardId",
      "Caption": "ID",
      "Type": "Guid"
    },
    {
      "Alias": "Name",
      "Caption": "Подписант",
      "Multiple": false,
      "Type": "$FileSignatures.SubjectName"
    }
  ],
  "References": [
    {
      "ColPrefix": "Fs",
      "DisplayValueColumn": "FsUserName",
      "RefSection": [
        "MEDOFileSignatures"
      ]
    }
  ]
}

[TEXTPART MEDOFileSignatures MSSQL]
SELECT 
 [t].[ID]				AS [FsID]
,[t].[RowID] 			AS [FsRowID]
,[t].[SubjectName] 	AS [FsUserName]
,[t].[Signed] 		AS [FsSigned]
,[t].[SerialNumber] 	AS [FsSerialNumber]
,[t].[CardID] 		AS [FsCardID]
,[t].[Name] 			AS [FsFileName]
FROM (SELECT 
 fs.[ID]
,fs.[RowID]
,fs.[UserID]
,fs.[SubjectName] 		
,fs.[Signed]
,fs.[SerialNumber]
,f.[ID]				AS [CardID]
,f.[Name]
FROM [FileSignatures] AS [fs]
left join [Files] as f on f.[RowID]= fs.[ID]

where
f.[Name] Like (
select ls.[Value] 
	from [LocalizationStrings] as ls
	left join [LocalizationEntries] as le on ls.[EntryID] = le.[ID]
where le.[Name] = 'GipPrefixDocName'
) + '%'
#param(CardId, f.[ID])
) AS t

[TEXTPART MEDOFileSignatures PGSQL]
SELECT 
t."RowID" 			AS "FsRowID"
,t."SubjectName" 	AS "FsUserName"
,t."Signed" 		AS "FsSigned"
,t."SerialNumber" 	AS "FsSerialNumber"
,t."CardID" 		AS "FsCardID"
,t."Name" 			AS "FsFileName",
 t."ID"				AS "FsID"
FROM (SELECT 
 fs."ID"
,fs."RowID"
,fs."UserID"
,fs."SubjectName" 		
,fs."Signed"
,fs."SerialNumber"
,f."ID"				AS "CardID"
,f."Name"
FROM "FileSignatures" AS "fs"
left join "Files" as f on f."RowID"= fs."ID"

where
f."CategoryCaption" = 'Документ'
#param(CardId, f."ID")
#param(Name, fs."SubjectName")
) AS t
--WHERE (1=1 #param(FileID, t."ID"))
