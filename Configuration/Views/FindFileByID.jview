}

[TEXTPART FindFileByID JSONMETA]
{
  "Alias": "FindFileByID",
  "Caption": "NewView{b0db7f63-1b85-4e42-b31e-251d821cc5f3}",
  "Columns": [
    {
      "Alias": "CardID",
      "Type": "Guid Null"
    },
    {
      "Alias": "FileID",
      "Type": "Guid Null"
    },
    {
      "Alias": "VersionRowID",
      "Type": "Guid Null"
    },
    {
      "Alias": "Name",
      "Type": "String(Max) Null"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "CardID",
      "Multiple": false,
      "Type": "Guid Null"
    }
  ]
}

[TEXTPART FindFileByID MSSQL]


[TEXTPART FindFileByID PGSQL]
SELECT
		
		"dci"."ID" as "CardID",
		"f"."RowID" as "FileID",
		"f"."VersionRowID" as "VersionRowID",
		"f"."Name" as "Name"
FROM "DocumentCommonInfo" as "dci"
Join "Files" as "f" ON "f"."ID" = "dci"."ID"

Where true
#param(CardID, "dci"."ID")
