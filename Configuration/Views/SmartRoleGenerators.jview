[TEXTPART SmartRoleGenerators MSSQL]
SELECT
	[s].[ID]				AS [SmartRoleGeneratorID],
	[s].[Name]				AS [SmartRoleGeneratorName],
	[s].[Description]		AS [SmartRoleGeneratorDescription],
	[s].[IsDisabled]		AS [SmartRoleGeneratorIsDisabled],
	[s].[HideRoles]			AS [SmartRoleGeneratorHideRoles],
	[s].[DisableDeputies]	AS [SmartRoleGeneratorDisableDeputies]
	
FROM [SmartRoleGenerators] AS [s] WITH (NOLOCK)
#if(Name || request.SortedBy("SmartRoleGeneratorName")) {
CROSS APPLY [Localization]([s].[Name], #param(locale)) AS [lName]
}
WHERE 1 = 1
	#param(Name, [lName].[Value])
	#param(Description, [s].[Description])
	#param(IsDisabled, [s].[IsDisabled])
	#param(HideRoles, [s].[HideRoles])
	#param(DisableDeputies, [s].[DisableDeputies])
ORDER BY #order_by


[TEXTPART SmartRoleGenerators PGSQL]
SELECT
	"s"."ID"				AS "SmartRoleGeneratorID",
	"s"."Name"				AS "SmartRoleGeneratorName",
	"s"."Description"		AS "SmartRoleGeneratorDescription",
	"s"."IsDisabled"		AS "SmartRoleGeneratorIsDisabled",
	"s"."HideRoles"			AS "SmartRoleGeneratorHideRoles",
	"s"."DisableDeputies"	AS "SmartRoleGeneratorDisableDeputies"
	
FROM "SmartRoleGenerators" AS "s"
#if(Name || request.SortedBy("SmartRoleGeneratorName")) {
CROSS JOIN "Localization"("s"."Name", #param(locale)) AS "lName"
}
WHERE true
	#param(Name, "lName"."Value")
	#param(Description, "s"."Description")
	#param(IsDisabled, "s"."IsDisabled")
	#param(HideRoles, "s"."HideRoles")
	#param(DisableDeputies, "s"."DisableDeputies")
	
ORDER BY #order_by