{
  "Name": "Condensed",
  "meta": {
    "name": "Condensed"
  },

  "templates": {
    "control": {
      "padding": "6 6 6 9",
      "gap": "3",

      "@types": {
        "inline": {
          "gap": "3"
        }
      },

      "@components": {
        "panels": {
          "padding": "2 2 2 9"
        }
      }
    },
    "table": {
      "row": {
        "padding": "7",
        "gap": "5"
      },
      "header": {
        "padding": "8",
        "gap": "5",
        "min-height": "calc(var(--table-header-padding-top) + var(--table-header-padding-bottom) + var(--icon-size-s))"
      },
      "footer": {
        "padding": "3 6"
      }
    }
  },

  "autocomplete": {
    "@containers": {
      "buttons": {
        "padding": "2 2 2 0"
      }
    }
  },

  "buttons": {
    "normal": {
      "padding": "5 11",
      "height": "calc(6 * 2 + var(--icon-size-m))"
    },
    "toolbox": {
      "padding": "7 9",
      "height": "calc(8 * 2 + var(--icon-size-m))"
    }
  },
  "card": {
    "padding": "7 7 7 15",

    "side-form": {
      "gap": "7",
      "padding": "7"
    }
  },
  "corners": {
    "radius": {
      "l1": "10px"
    }
  },

  "dropdown": {
    "padding": "6 10"
  },
  "padding": {
    "content": "7px",
    "scroll": "5px"
  },
  "preview": {
    "header": {
      "padding": "7"
    },
    "toolbar": {
      "padding": "7"
    },
    "content": {
      "corners": "0",
      "padding": "0"
    },
    "dialog": {
      "header": {
        "padding": "7"
      }
    }
  },

  "files": {
    "item": {
      "padding": "5",
      "gap": "5",
      "@states": {
        "with-icons": {
          "padding": "1 5 1 1"
        }
      },
      "caption": {
        "gap": "2",
        "@states": {
          "full": {
            "padding": "0",
            "name": {
              "font": {
                "size": "$fontSizeSecondary",
                "height": "$fontSizePrimary"
              }
            }
          }
        }
      },
      "icons": {
        "gap": "2"
      }
    },
    "group": {
      "padding": "6",
      "gap": "5"
    },
    "drop": {
      "padding": "6"
    }
  },
  "form": {
    "label": {
      "padding": "10 0 5 0"
    },
    "block": {
      "padding": "15 0 0 0",
      "gap": "10 10"
    }
  },
  "select": {
    "gap": "5",
    "padding": "2 1 2 9"
  },
  "tabs": {
    "main": {
      "padding": "7 20 8 20"
    }
  },
  "tasks": {
    "gap": "10",
    "limitation": {
      "padding": "4 6"
    },
    "item": {
      "padding": "15",
      "gap": "10"
    }
  },
  "tree": {
    "item": {
      "padding": "8 10 8 8"
    }
  },
  "view": {
    "height": "100%",
    "padding": "0",
    "corners": "0",
    "item": {
      "corners": "0",
      "gap": "12",
      "padding": "12"
    },
    "param": {
      "gap": "8",
      "balloon": {
        "padding": "4"
      },
      "button": {
        "padding": "9 5",
        "height": "33"
      }
    }
  }
}
