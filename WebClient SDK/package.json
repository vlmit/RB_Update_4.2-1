{
  "name": "tessa_web_extensions",
  "private": "true",
  "engines": {
    "npm": ">=7.0.0 <12.0.0",
    "node": ">=20.0.0 <26.0.0"
  },
  "scripts": {
    "start": "webpack serve --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "build:module": "webpack --config webpack.config.js --mode production --env MODULE",
    "build:debug": "webpack --config webpack.config.js --mode development",
    "build:e2e": "webpack --config webpack.config.js --mode production --env E2E",
    "build-mobile": "cross-env PLATFORM=mobile npm run build",
    "lint": "eslint ./src",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@swc/core": "^1.15.3",
    "@swc/helpers": "^0.5.17",
    "@types/d3": "^5.7.2",
    "@types/node": "^22.18.8",
    "@types/react": "^17.0.80",
    "@types/slate": "^0.47.11",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^6.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "sass": "1.43.4",
    "sass-loader": "12.1.0",
    "style-loader": "4.0.0",
    "swc-loader": "^0.2.6",
    "typescript": "5.9",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-manifest-plugin": "^5.0.1",
    "webpack-virtual-modules": "^0.6.2",
    "webpackbar": "^7.0.0"
  },
  "dependencies": {
    "base58-js": "^3.0.3",
    "classnames": "^2.2.6",
    "clipboard": "^2.0.11",
    "compare-versions": "^4.1.1",
    "decimal.js": "^10.5.0",
    "file-saver": "^2.0.5",
    "history": "^4.10.1",
    "is-subnet": "^1.0.0",
    "mobx": "^5.15.7",
    "mobx-react": "6.3.1",
    "moment": "^2.24.0",
    "qrcode.react": "^3.1.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^8.0.7",
    "shepherd.js": "^14.1.0",
    "slate": "^0.78.0",
    "slate-history": "^0.66.0",
    "slate-react": "^0.77.4",
    "styled-components": "^5.1.1"
  },
  "overrides": {
    "mobx-react@6.3.1": {
      "react": "$react"
    }
  },
  "browserslist": [
    ">0.3%",
    "Chrome >= 98",
    "ChromeAndroid >= 98",
    "Firefox >= 95",
    "Edge >= 96",
    "Safari >= 14.1",
    "iOS >= 14.5",
    "last 2 versions",
    "not dead"
  ]
}
