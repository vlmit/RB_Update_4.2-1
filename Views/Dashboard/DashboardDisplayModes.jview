[TEXTPART DashboardDisplayModes JSONMETA]
{
  "Alias": "DashboardDisplayModes",
  "Caption": "$Views_Names_DashboardDisplayModes",
  "Columns": [
    {
      "Alias": "RefID",
      "Hidden": true,
      "Type": "$AccessLevels.ID"
    },
    {
      "Alias": "RefName",
      "Caption": "$Views_DashboardDisplayModes_Name",
      "FilterParameter": "Name",
      "FilterType": "Parameter",
      "Localizable": true,
      "Type": "$DashboardDisplayModes.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_DashboardDisplayModes_Name",
      "Type": "String(Max) Null"
    }
  ],
  "References": [
    {
      "ColPrefix": "Ref",
      "DisplayValueColumn": "RefName",
      "RefSection": [
        "DashboardDisplayModes"
      ]
    }
  ],
  "TreatAsSingleQuery": true
}

[TEXTPART DashboardDisplayModes MSSQL]
SELECT
	[ddm].[ID]		AS [RefID],
	[ddm].[Name]	AS [RefName]
FROM [DashboardDisplayModes] AS [ddm] WITH (NOLOCK)
#if(Name) {
CROSS APPLY [Localization]([ddm].[Name], #param(locale)) AS [l]
}
WHERE 1 = 1
	#param(Name, [l].[Value])
ORDER BY [ddm].[ID]


[TEXTPART DashboardDisplayModes PGSQL]
SELECT
	"ddm"."ID"		AS "RefID",
	"ddm"."Name"	AS "RefName"
FROM "DashboardDisplayModes" AS "ddm"
#if(Name) {
CROSS JOIN "Localization"("ddm"."Name", #param(locale)) AS "l"
}
WHERE true
	#param(Name, "l"."Value")
ORDER BY "ddm"."ID"