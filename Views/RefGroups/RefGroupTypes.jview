[TEXTPART RefGroupTypes MSSQL]
SELECT
	[t].*
FROM (
	SELECT #if(Normal) {
		[rgt].[ID]				AS [RefGroupTypeID],
		[rgt].[Name]			AS [RefGroupTypeName],
		[rgt].[KeyTypeID]		AS [RefGroupTypeKeyTypeID],
		[rgt].[KeyTypeName]		AS [RefGroupTypeKeyTypeName],
		[rgt].[RefSection]		AS [RefGroupTypeRefSection],
		row_number() OVER (ORDER BY #order_by)	AS [rn]
	}
	#if(Count) 
	{
		count(*) AS [cnt]
	}
    FROM [RefGroupTypes] AS [rgt] WITH (NOLOCK)
    #if(Name || Normal && request.SortedBy("RefGroupTypeName")) {
    CROSS APPLY [Localization]([rgt].[Name], #param(locale)) AS [lName]
    }
	WHERE 1 = 1
    	#param(Name, [lName].[Value])
) AS [t]
#if(PageOffset) {
	WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
	ORDER BY [t].[rn]
}

[TEXTPART RefGroupTypes PGSQL]
SELECT
	"t".*
FROM (
	SELECT #if(Normal) {
		"rgt"."ID"				AS "RefGroupTypeID",
		"rgt"."Name"			AS "RefGroupTypeName",
		"rgt"."KeyTypeID"		AS "RefGroupTypeKeyTypeID",
		"rgt"."KeyTypeName"		AS "RefGroupTypeKeyTypeName",
		"rgt"."RefSection"		AS "RefGroupTypeRefSection",
		row_number() OVER (ORDER BY #order_by)	AS "rn"
	}
	#if(Count) 
	{
		count(*) AS "cnt"
	}
    FROM "RefGroupTypes" AS "rgt"
    #if(Name || Normal && request.SortedBy("RefGroupTypeName")) {
    CROSS JOIN "Localization"("rgt"."Name", #param(locale)) AS "lName"
    }
	WHERE 1 = 1
    	#param(Name, "lName"."Value")
) AS "t"
#if(PageOffset) {
	WHERE "t"."rn" >= #param(PageOffset) AND "t"."rn" < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
	ORDER BY "t"."rn"
}