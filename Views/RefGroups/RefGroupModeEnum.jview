[TEXTPART RefGroupModeEnum MSSQL]
SELECT
	[r].[ID]		AS [ModeID],
	[r].[Name]		AS [ModeName]
FROM [RefGroupModeEnum] AS [r] WITH (NOLOCK)
CROSS APPLY [Localization]([r].[Name], #param(locale)) AS [lName]
WHERE 1 = 1
	#param(Name, [lName].[Value])
ORDER BY #order_by


[TEXTPART RefGroupModeEnum PGSQL]
SELECT
	"r"."ID"		AS "ModeID",
	"r"."Name"		AS "ModeName"
FROM "RefGroupModeEnum" AS "r"
CROSS JOIN "Localization"("r"."Name", #param(locale)) AS "lName"
WHERE 1 = 1
	#param(Name, "lName"."Value")
ORDER BY #order_by