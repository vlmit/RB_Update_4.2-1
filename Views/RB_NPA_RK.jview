[TEXTPART RB_NPA_RK MSSQL]
#var(UseCommonInfo: Normal || ByDocType || Number || Subject || DocDate || DocType || IsAuthor || IsRegistrator || Author || Registrator || Department)

DECLARE @Project nvarchar(max);
SET @Project = [dbo].[GetString](N'Views_Registers_Project_Sql', #param(locale));

SELECT
	#if(Normal) {
	[t].[ID]																	AS [DocID],
	[t].[FullNumber]															AS [DocNumber],
	[t].[DocTypeTitle]															AS [SubTypeTitle],
	[t].[Subject]																AS [DocSubject],
	COALESCE([t].[FullNumber], N'') + N', ' + COALESCE([t].[Subject], N'')		AS [DocDescription], 	-- autocomplete
	[t].[AuthorID]																AS [AuthorID],
	[t].[AuthorName]															AS [AuthorName],
	[t].[RegistratorID]															AS [RegistratorID],
	[t].[RegistratorName]														AS [RegistratorName],
	COALESCE([kr].[StateName], @Project)										AS [KrState],
	[t].[DocDate]																AS [DocDate],
	CAST([t].[CreationDate] AS date)											AS [CreationDate],
	[t].[DepartmentName]														AS [Department]
	}
	#if(ByDocType) {
	[t].[SubTypeID],
	[kdt].[Title]																AS [SubTypeTitle],
	[t].[SubTypeCount]
	}
	#if(ByState | Count) {
	[t].*
	}
FROM (
	SELECT
		#if(Normal) {
		[mi].[ID],
		[mi].[FullNumber],
		[mi].[DocTypeTitle],
		[mi].[Subject],
		[mi].[AuthorID],
		[mi].[AuthorName],
		[mi].[RegistratorID],
		[mi].[RegistratorName],
		[mi].[DocDate],
		[mi].[CreationDate],
		[mi].[DepartmentName],
		[t].[rn]
		}
		#if(ByDocType | ByState) {
		[t].*
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM (
		SELECT
			#if(Normal || Count) {
			[mi].[ID]
			}
			#if(Normal) {,
			row_number() OVER (ORDER BY #order_by) AS [rn]
			}
			#if(ByDocType) {
			[mi].[DocTypeID]									AS [SubTypeID],
			count(*)											AS [SubTypeCount]
			}
			#if(ByState) {
			COALESCE([kr].[StateID], CAST(0 AS smallint))		AS [StateID],
			COALESCE([kr].[StateName], N'$KrStates_Doc_Draft')	AS [StateName],
			count(*)											AS [StateCount]
			}
		#if(UseCommonInfo) {
		FROM [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		} {
		/* Алиас [mi] должен быть таким же, как у DocumentCommonInfo */
		FROM [Instances] AS [mi] WITH (NOLOCK)
		}
		#if(ByState || State || IsInitiator) {
		LEFT JOIN [KrApprovalCommonInfo] AS [kr] WITH (NOLOCK)
			ON [kr].[MainCardID] = [mi].[ID]
		}
		WHERE
			#if(UseCommonInfo) {
			[mi].[CardTypeID]
			} {
			[mi].[TypeID]
			}
			= '6d06c5a0-9687-4f6b-9bed-d3a081d84d9a'		--Document
			#param(Number, [mi].[FullNumber])
			#param(Subject, [mi].[Subject])
			#param(DocDate, [mi].[DocDate])
			#param(State, COALESCE([kr].[StateID], 0))
			#param(DocType, [mi].[DocTypeID])
			#param(Author, [mi].[AuthorID])
			#param(Registrator, [mi].[RegistratorID])
			#param(Department, [mi].[DepartmentID])
			#if(IsAuthor) {
				#if(IsAuthor.CriteriaName == "IsTrue") {
			AND [mi].[AuthorID] = #param(CurrentUserID)
				} {
			AND ([mi].[AuthorID] IS NULL OR [mi].[AuthorID] <> #param(CurrentUserID))
				}
			}
			#if(IsRegistrator) {
				#if(IsRegistrator.CriteriaName == "IsTrue") {
			AND [mi].[RegistratorID] = #param(CurrentUserID)
				} {
			AND ([mi].[RegistratorID] IS NULL OR [mi].[RegistratorID] <> #param(CurrentUserID))
				}
			}
			#if(IsInitiator) {
				#if(IsInitiator.CriteriaName == "IsTrue") {
			AND [kr].[AuthorID] = #param(CurrentUserID)
				} {
			AND ([kr].[AuthorID] IS NULL OR [kr].[AuthorID] <> #param(CurrentUserID))
				}
			}
		#if(ByDocType) {
		GROUP BY [mi].[DocTypeID]
		}
		#if(ByState) {
		GROUP BY COALESCE([kr].[StateID], CAST(0 AS smallint)), COALESCE([kr].[StateName], N'$KrStates_Doc_Draft')
		}
		) AS [t]
	#if(Normal) {
	INNER JOIN [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		ON [mi].[ID] = [t].[ID]
	}
	#if(PageOffset) {
	WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
	}
	) AS [t]
#if(Normal) {
LEFT JOIN [KrApprovalCommonInfo] AS [kr] WITH (NOLOCK)
	ON [kr].[MainCardID] = [t].[ID]
ORDER BY [t].[rn]
}
#if(ByState) {
CROSS APPLY [Localization]([t].[StateName], #param(locale)) AS [sls] --Локализуем состояние документа
ORDER BY [sls].[Value]
}
#if(ByDocType) {
INNER JOIN [KrDocType] AS [kdt] WITH (NOLOCK)
	ON [kdt].[ID] = [t].[SubTypeID]
CROSS APPLY [Localization]([kdt].[Title], #param(locale)) AS [tls] --Локализуем тип документа
ORDER BY [tls].[Value]
}
;

[TEXTPART RB_NPA_RK PGSQL]
DECLARE
	"project" text;
BEGIN
	#var(UseCommonInfo: Normal || ByDocType || Number || Subject || DocDate || DocType || IsAuthor || IsRegistrator || Author || Registrator || Department)

	"project" = "GetString"('Views_Registers_Project_Sql', #param(locale));
	
	RETURN QUERY
	SELECT
		#if(Normal) {
		"mi"."ID"																	AS "DocID",
		"mi"."FullNumber"															AS "DocNumber",
		"mi"."DocDate"																AS "DocDate",
		"mi"."NumNPA"																AS "NumNPA",
		"mi"."OutgoingDate"															AS "OutgoingDate",
		"mi"."Subject"																AS "DocSubject",
		"mi"."DocTypeTitle"															AS "SubTypeTitle",
		COALESCE("mi"."FullNumber", '') || ', ' || COALESCE("mi"."Subject", '')		AS "DocDescription",		-- autocomplete
		"mi"."AuthorID"																AS "AuthorID",
		"mi"."AuthorName"															AS "AuthorName",
		"mi"."RegistratorID"														AS "RegistratorID",
		"mi"."RegistratorName"														AS "RegistratorName",
		COALESCE("kr"."StateName", "project")										AS "KrState",
		
		CAST("mi"."CreationDate" AS date)											AS "CreationDate",
		"mi"."DepartmentName"														AS "Department",
		"mi"."DepAGIPName"															AS "DepAGIP",
		"mi"."PerformersWithoutSED"													AS "PerformersWithoutSED",
		"mi"."DivisionWithoutSED"													AS "DivisionWithoutSED",
		"mi"."AcceptanceStatusName"													AS "AcceptanceStatus",
		"mi"."AcceptanceProcedureName"												AS "AcceptanceProcedure",
		"mi"."SignedByName"															AS "SignedBy",
		"mi"."ProjectQualityName"													AS "DepAGIPID",
		(SELECT "ID"  FROM "Performers" as "Perf" where "Perf"."ID" = "mi"."ID" ORDER BY #order_by LIMIT 1)	AS "PerformersID",
		(SELECT "UserID"  FROM "Performers" as "Perf" where "Perf"."ID" = "mi"."ID" ORDER BY #order_by LIMIT 1)	AS "PerformersUserID",
		(SELECT "UserName"  FROM "Performers" as "Perf" where "Perf"."ID" = "mi"."ID" ORDER BY #order_by LIMIT 1)	AS "Performers",
		"mi"."Comment"																AS "Comment"
		}
		#if(Count){
			"mi".*
		}
		#if(ByDocType) {
		"mi"."SubTypeID",
		"kdt"."Title"																AS "SubTypeTitle",
		"mi"."SubTypeCount"
		}
		#if(ByState) {
		"mi".*
		}
	FROM (
		SELECT
			#if(Normal) {
			"mi"."ID",
			"mi"."Number",
			"mi"."FullNumber",
			"mi"."NumNPA",
			"mi"."OutgoingDate",
			"mi"."DocTypeTitle",
			"mi"."Subject",
			"mi"."AuthorID",
			"mi"."AuthorName",
			"mi"."RegistratorID",
			"mi"."RegistratorName",															
			"mi"."DocDate",
			"mi"."CreationDate",
			"mi"."DepartmentName",
			"mi"."DepAGIPName",
			"mi"."PerformersWithoutSED",
			"mi"."DivisionWithoutSED",
			"mi"."AcceptanceStatusName",
			"mi"."AcceptanceProcedureName",
			"mi"."SignedByName",
			"mi"."ProjectQualityName",
			--(SELECT UserName FROM Performers as Perf where "Perf"."RowID" = "mi"."ID"),
			"mi"."Comment"

			}
			#if(ByDocType | ByState) {
			"t".*
			}
			#if(Count) {
				count(*) AS "cnt"
			}
		FROM (
			SELECT
				#if(Normal) {
				"mi"."ID"
				}
				#if(ByDocType) {
				"mi"."DocTypeID" 									AS "SubTypeID",
				count(*)											AS "SubTypeCount"
				}
				#if(ByState) {
				COALESCE("kr"."StateID", CAST(0 AS smallint))		AS "StateID",
				COALESCE("kr"."StateName", '$KrStates_Doc_Draft')	AS "StateName",
				count(*)											AS "StateCount"
				}
			#if(UseCommonInfo) {
			FROM "DocumentCommonInfo" AS "mi"
			} {
			-- Алиас "mi" должен быть таким же, как у DocumentCommonInfo
			FROM "Instances" AS "mi"
			}
			#if(ByState || State || IsInitiator) {
			LEFT JOIN "KrApprovalCommonInfo" AS "kr"
				ON "kr"."MainCardID" = "mi"."ID"
			}
			WHERE
				#if(UseCommonInfo) {
				"mi"."CardTypeID"
				} {
				"mi"."TypeID"
				}
				= '0fadf560-bd34-4c41-b24e-e63d3b15bd74'		-- Document
				--in ('4e8d39ac-381e-4111-bc3a-66179ace7ecb','0fadf560-bd34-4c41-b24e-e63d3b15bd74')
				#param(Number, "mi"."FullNumber")
				#param(Subject, "mi"."Subject")
				#param(DocDate, "mi"."DocDate")
				#param(State, COALESCE("kr"."StateID", 0))
				#param(DocType, "mi"."DocTypeID")
				#param(Author, "mi"."AuthorID")
				#param(Registrator, "mi"."RegistratorID")
				#param(Department, "mi"."DepartmentID")
				#param(AcceptanceStatus, "mi"."AcceptanceStatusID")
				#param(ProjectQuality, "mi"."ProjectQualityID")
				#param(Performers, (SELECT "UserID"  FROM "Performers" as "Perf" where "Perf"."ID" = "mi"."ID" ORDER BY #order_by LIMIT 1))
				#param(DepAGIP, "mi"."DepAGIPID")
				
				#if(IsAuthor) {
					#if(IsAuthor.CriteriaName == "IsTrue") {
				AND "mi"."AuthorID" = #param(CurrentUserID)
					} {
				AND ("mi"."AuthorID" IS NULL OR "mi"."AuthorID" <> #param(CurrentUserID))
					}
				}
				#if(IsRegistrator) {
					#if(IsRegistrator.CriteriaName == "IsTrue") {
				AND "mi"."RegistratorID" = #param(CurrentUserID)
					} {
				AND ("mi"."RegistratorID" IS NULL OR "mi"."RegistratorID" <> #param(CurrentUserID))
					}
				}
				#if(IsInitiator) {
					#if(IsInitiator.CriteriaName == "IsTrue") {
				AND "kr"."AuthorID" = #param(CurrentUserID)
					} {
				AND ("kr"."AuthorID" IS NULL OR "kr"."AuthorID" <> #param(CurrentUserID))
					}
				}
			#if(Normal) {
			ORDER BY #order_by
			}
			#if(PageOffset) {
			OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
			}
			#if(ByDocType) {
			GROUP BY "mi"."DocTypeID"
			}
			#if(ByState) {
			GROUP BY COALESCE("kr"."StateID", CAST(0 AS smallint)), COALESCE("kr"."StateName", '$KrStates_Doc_Draft')
			}
			) AS "t"
		#if(Normal) {
		INNER JOIN "DocumentCommonInfo" AS "mi"
			ON "mi"."ID" = "t"."ID"
		}
		) AS "mi"
	#if(Normal) {
	LEFT JOIN "KrApprovalCommonInfo" AS "kr"
		ON "kr"."MainCardID" = "mi"."ID"
	ORDER BY #order_by
	}
	#if(ByState) {
	CROSS JOIN "Localization"("mi"."StateName", #param(locale)) AS "sls" --Локализуем состояние документа
	ORDER BY "sls"."Value"
	}
	#if(ByDocType) {
	INNER JOIN "KrDocType" AS "kdt"
		ON "kdt"."ID" = "mi"."SubTypeID"
	CROSS JOIN "Localization"("kdt"."Title", #param(locale)) AS "tls" --Локализуем тип документа
	ORDER BY "tls"."Value"
	};
END;
