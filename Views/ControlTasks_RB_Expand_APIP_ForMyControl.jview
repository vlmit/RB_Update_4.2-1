[TEXTPART ControlTasks_RB_Expand_APIP_ForMyControl MSSQL]
#var(UseCommonInfo: Normal || ByDocType || Number || Subject || DocDate || DocType || IsAuthor || IsRegistrator || Author || Registrator || Department || TaskFact || SignedBy)--|| PerformersUserName)

DECLARE @Project nvarchar(max);
SET @Project = [dbo].[GetString](N'Views_Registers_Project_Sql', #param(locale));

SELECT
	#if(Normal) {
	[t].[ID]																	AS [DocID],
	[t].[FullNumber]															AS [DocNumber],
	[t].[DocTypeTitle]															AS [SubTypeTitle],
	[t].[Subject]																AS [DocSubject],
	COALESCE([t].[FullNumber], N'') + N', ' + COALESCE([t].[Subject], N'')		AS [DocDescription], 	-- autocomplete
	[t].[AuthorID]																AS [AuthorID],
	[t].[AuthorName]															AS [AuthorName],
	[t].[RegistratorID]															AS [RegistratorID],
	[t].[RegistratorName]														AS [RegistratorName],
	COALESCE([kr].[StateName], @Project)										AS [KrState],
	[t].[DocDate]																AS [DocDate],
	CAST([t].[CreationDate] AS date)											AS [CreationDate],
	[t].[DepartmentName]														AS [Department],
	[t].[TaskDeadline]															AS [TaskDeadline],
	[t].[TaskFact]																AS [TaskFact],
	[t].[TaskBaseNum]															AS [TaskBaseNum],
	[t].[TaskBaseDocTypeTitle]													AS [TaskBaseDocType],
	[t].[SignedByID]															AS [SignedByID],
	[t].[SignedByName]															AS [SignedByName]
	---[tt].[PerformersName]												AS [STP]
	}
	#if(ByDocType) {
	[t].[SubTypeID],
	[kdt].[Title]																AS [SubTypeTitle],
	[t].[SubTypeCount]
	}
	#if(ByState | Count) {
	[t].*
	}

FROM (
	SELECT
		#if(Normal) {
		[mi].[ID],
		[mi].[FullNumber],
		[mi].[DocTypeTitle],
		[mi].[Subject],
		[mi].[AuthorID],
		[mi].[AuthorName],
		[mi].[RegistratorID],
		[mi].[RegistratorName],
		[mi].[DocDate],
		[mi].[CreationDate],
		[mi].[DepartmentName],
		[mi].[TaskDeadline],
		[mi].[TaskFact],
		[mi].[TaskBaseNum],
		[mi].[TaskBaseDocTypeTitle],
		[mi].[SignedByID],
		[mi].[SignedByName],
		[t].[rn]
		}
		#if(ByDocType | ByState) {
		[t].*
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM (
		SELECT
			#if(Normal || Count) {
			[mi].[ID]
			}
			#if(Normal) {,
			row_number() OVER (ORDER BY #order_by) AS [rn]
			}
			#if(ByDocType) {
			[mi].[DocTypeID]									AS [SubTypeID],
			count(*)											AS [SubTypeCount]
			}
			--[m].[PerformersName]								AS [STP]
			#if(ByState) {
			COALESCE([kr].[StateID], CAST(0 AS smallint))		AS [StateID],
			COALESCE([kr].[StateName], N'$KrStates_Doc_Draft')	AS [StateName],
			count(*)											AS [StateCount]
			}
			
		--From [StatusTable] as [m] with (NOLOCK)--[m].[PerformersName]
		#if(UseCommonInfo) {
		FROM [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		} {
		/* Алиас [mi] должен быть таким же, как у DocumentCommonInfo */
		FROM [Instances] AS [mi] WITH (NOLOCK)
		}
		#if(ByState || State || IsInitiator) {
		LEFT JOIN [KrApprovalCommonInfo] AS [kr] WITH (NOLOCK)
			ON [kr].[MainCardID] = [mi].[ID]
		}
		WHERE
			#if(UseCommonInfo) {
			[mi].[CardTypeID]
			} {
			[mi].[TypeID]
			}
			= '4416d155-c839-4a1c-88bf-2b133812f403'		--ControlTask
			#param(Number, [mi].[FullNumber])
			#param(Subject, [mi].[Subject])
			#param(DocDate, [mi].[DocDate])
			#param(TaskFact, [mi].[TaskFact])
			#param(State, COALESCE([kr].[StateID], 0))
			#param(DocType, [mi].[DocTypeID])
			#param(Author, [mi].[AuthorID])
			#param(Registrator, [mi].[RegistratorID])
			#param(Department, [mi].[DepartmentID])
			#param(TaskDeadline, [mi].[TaskDeadline])
			#param(TaskBaseNum, [mi].[TaskBaseNum])
			#param(TaskBaseDocType, [mi].[TaskBaseDocTypeTitle])
			#param(SignedBy, [mi].[SignedByID])
			#if(IsAuthor) {
				#if(IsAuthor.CriteriaName == "IsTrue") {
			AND [mi].[AuthorID] = #param(CurrentUserID)
				} {
			AND ([mi].[AuthorID] IS NULL OR [mi].[AuthorID] <> #param(CurrentUserID))
				}
			}
			#if(IsRegistrator) {
				#if(IsRegistrator.CriteriaName == "IsTrue") {
			AND [mi].[RegistratorID] = #param(CurrentUserID)
				} {
			AND ([mi].[RegistratorID] IS NULL OR [mi].[RegistratorID] <> #param(CurrentUserID))
				}
			}
			#if(IsInitiator) {
				#if(IsInitiator.CriteriaName == "IsTrue") {
			AND [kr].[AuthorID] = #param(CurrentUserID)
				} {
			AND ([kr].[AuthorID] IS NULL OR [kr].[AuthorID] <> #param(CurrentUserID))
				}
			}
		#if(ByDocType) {
		GROUP BY [mi].[DocTypeID]
		}
		#if(ByState) {
		GROUP BY COALESCE([kr].[StateID], CAST(0 AS smallint)), COALESCE([kr].[StateName], N'$KrStates_Doc_Draft')
		}
		) AS [t]
	#if(Normal) {
	INNER JOIN [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		ON [mi].[ID] = [t].[ID]
	}

	#if(PageOffset) {
	WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
	}
	) AS [t]
	

    	
#if(Normal) {
LEFT JOIN [KrApprovalCommonInfo] AS [kr] WITH (NOLOCK)
	ON [kr].[MainCardID] = [t].[ID]
ORDER BY [t].[rn]
}

#if(ByState) {
CROSS APPLY [Localization]([t].[StateName], #param(locale)) AS [sls] --Локализуем состояние документа
ORDER BY [sls].[Value]
}
#if(ByDocType) {
INNER JOIN [KrDocType] AS [kdt] WITH (NOLOCK)
	ON [kdt].[ID] = [t].[SubTypeID]
CROSS APPLY [Localization]([kdt].[Title], #param(locale)) AS [tls] --Локализуем тип документа
ORDER BY [tls].[Value]
}


;

[TEXTPART ControlTasks_RB_Expand_APIP_ForMyControl PGSQL]
DECLARE
	"project" text;
	"red_threshold"				int;
	"сlientUtcOffset" int = #eval(session.ClientUtcOffset.TotalMinutes);
	#if(Normal) {
	"now_timestamp"				timestamptz;
	}
BEGIN
	#var(UseCommonInfo: Normal || ByDocType || Number || Subject || DocDate || DocType || IsAuthor || IsMe || IsRegistrator || IsResponsible || Author || Registrator || Department || TaskFact || SignedBy || ParentTask||Parent ||DeadlineToday ||DeadlineFiveDays||DeadlineSevenDays
								||DeadlinePast ||ISProject || State || KrState || ControlState || OnControl || RemovedFromControl
								|| CreationDate ||ParentNumber || DocRegDate || CardOutgoingNumber
								|| CardOutgoingDate || DocTypeTitle || CategoryName
								|| Correspondents || ParentSubject || CategoryTaskName
								|| ExpandTextTask || TaskDeadline || NumberOfTransfers
								|| AuthorComDepartment || ExecutorComDepartment || СontrolerComDepartment
								|| Notes || OutgoingRefDocs || ControlState || TaskFactControl
								|| GroundsDeregistrationName || OrderPoint
								|| ExpandTextTask || TaskDeadline || Performer)-- || OutgoingRefDocs)

	#if(Normal) {
	"red_threshold"			= 320; -- задания, просроченные более чем на две недели (320 квантов), будут одинаково красные
	"now_timestamp"			= current_timestamp;
	}
	
	
	"project" = "GetString"('Views_Registers_Project_Sql', #param(locale));
	
	RETURN QUERY
	-- ДОЧЕРНИЕ Поручения
	WITH RECURSIVE "childs" AS (
    SELECT "t"."ID", "t"."ParentTaskID"
    FROM "DocumentCommonInfo" as "t"
    WHERE 1=1 
    #if(ParentTask)
    {
    and ("t"."ID" = #param(ParentTask) or "t"."ParentTaskID" = #param(ParentTask))
    } 
   	 UNION
     SELECT "t"."ID", "t"."ParentTaskID"
     FROM "DocumentCommonInfo" as "t"
     INNER JOIN "childs" as "c"
      ON "t"."ParentTaskID" = "c"."ID" or "t"."ID" = "c"."ParentTaskID"
	)
	SELECT
		#if(Normal) {
		"mi"."ID"																	AS "DocID",
		--CAST((select "dci"."CreationDate" from "DocumentCommonInfo" as "dci" where "dci"."ID"= "mi"."ParentID") as date) AS "CreationDate",
		CAST("mi"."CreationDate"  as date) 											AS "CreationDate",
		(select "dci"."FullNumber" from "DocumentCommonInfo" as "dci" where "dci"."ID"= "mi"."ParentID")
																					AS "ParentNumber",
		(select "dci"."DocDate" from "DocumentCommonInfo" as "dci" where "dci"."ID"= "mi"."ParentID") AS "DocRegDate",
	--	CAST("mi"."CreationDate" AS date)											
		(select COALESCE("dci"."OutgoingNumber", '') from "DocumentCommonInfo" as "dci"	where "dci"."ID"="mi"."ParentID")
																					AS "CardOutgoingNumber",
		(select "dci"."OutgoingDate" from "DocumentCommonInfo" as "dci"	where "dci"."ID"="mi"."ParentID")
																					AS "CardOutgoingDate",																			
		(select "dci"."DocTypeTitle" from "DocumentCommonInfo" as "dci"	where "dci"."ID"="mi"."ParentID")
																					AS "DocTypeTitle",																			
		(select COALESCE("dci"."TypeOfDocumentName","dci"."CategoryName") from "DocumentCommonInfo" as "dci"	where "dci"."ID"="mi"."ParentID")
																					AS "CategoryName",
		(SELECT string_agg("Correspondents"."PartnersName", ', ')
            FROM "Correspondents"
            WHERE "Correspondents"."ID" = "mi"."ParentID"
            ORDER BY #order_by
            --ORDER BY "Correspondents"."PartnersName"
        )                                                                            AS "Correspondents",
		(select "dci"."DepartmentName" from "DocumentCommonInfo" as "dci"	where "dci"."ID"="mi"."ParentID")	
																					AS "Department",			
		(select "dci"."Subject"	from "DocumentCommonInfo" as "dci" where "mi"."ParentID"="dci"."ID")
																					AS "ParentSubject",
		"mi"."OrderPoint"															AS "OrderPoint",
		"mi"."CategoryName"															AS "CategoryTaskName",
		COALESCE("mi"."CommissionTemplateText","mi"."Subject")						AS "DocSubject",
		"mi"."ExpandTextTask"														AS "ExpandTextTask",
		"mi"."TaskDeadline"															AS "TaskDeadline",
		"mi"."NumberOfTransfers"													AS "NumberOfTransfers",
		(select "ro"."HeadName" from "Roles" as "ro"
		inner join "RoleUsers" as "ru" on "ru"."ID" = "ro"."ID"
		where "ru"."UserID" = "mi"."AuthorID" 
		and "ru"."IsDeputy" = false and "ro"."TypeID" = 2 limit 1)					AS "AuthorComDepartment",
		"mi"."AuthorName"															AS "AuthorName",
		COALESCE("mi"."ManualStateName", 'Не начато')								AS "KrState",
		"mi"."TaskFact"																AS "TaskFact",
		(select string_agg("ro"."HeadName", ', ') from "Roles" as "ro"
		inner join "RoleUsers" as "ru" on "ru"."ID" = "ro"."ID"
		where "ru"."UserID" IN (select "CtP"."UserID" from "ControlTaskPerformers" as "CtP"
		inner join "ControlTaskDecisions" as "CtD" on "CtD"."RowID" = "CtP"."ParentRowID"
		where "mi"."ID"="CtP"."ID" and "CtD"."IsResponsible" is true) 
		and "ru"."IsDeputy" = false and "ro"."TypeID" = 2)					AS "ExecutorComDepartment",
		(
			    	SELECT "CTP"."UserName" from "ControlTaskPerformers" as "CTP"
			    	inner join "ControlTaskDecisions" as "CTD" on "CTP"."ParentRowID" = "CTD"."RowID"
			    	where "CTP"."ID" = "mi"."ID" and "CTD"."IsResponsible" = true
			    	limit 1
			    	)															    AS "SignedByName",
		(select "ro"."HeadName" from "Roles" as "ro"
		inner join "RoleUsers" as "ru" on "ru"."ID" = "ro"."ID"
		where "ru"."UserID" = "mi"."RegistratorID" 
		and "ru"."IsDeputy" = false and "ro"."TypeID" = 2 limit 1)					AS "ControlerComDepartment",
		"mi"."ControllerName"														AS "RegistratorName",
		"mi"."Notes"																AS "Notes",
		(SELECT string_agg("OutgoingRefDocs"."DocDescription", ', ')
            FROM "OutgoingRefDocs"
            WHERE "OutgoingRefDocs"."ID" = "mi"."ID"
            ORDER BY #order_by
        )                                                                                AS "OutgoingRefDocs",
		"mi"."ControlStatusID"													AS "ControlStatusID",
		"mi"."ControlStatusName"													AS "ControlStatusName",
		"mi"."TaskFactControl"														AS "TaskFactControl",
		"mi"."GroundsDeregistrationName"											AS "GroundsDeregistrationName",
		CASE
			WHEN "mi"."ControlStatusName" != 'Снято с контроля'
				THEN '#appearance(Foreground: Red, FontSize: 14, FontWeight: Bold)'
			ELSE 
				CASE WHEN "mi"."ControlStatusName" = 'Снято с контроля'
					THEN '#appearance(Foreground: SlateGray, FontSize: 14, FontWeight: Bold)'
					ELSE ''		
				END
		END 																		AS "AppearanceColumn",
		CASE
			WHEN ("mi"."CardTypeID" = '01ad498e-5f8e-417a-bd28-942739dbf342' and "mi"."ControllerID" is not null) or
				 ("mi"."CardTypeID" = '0d4db642-7b3e-4988-92e9-2fd3752a488c' and "mi"."RegistratorID" is not null)
			THEN
			'K'	
			ELSE ''
		END 																			AS "ControlMark",		
		CASE
				WHEN "kr"."StateName"= 'Поручение исполнено' THEN 'Поручение исполнено'
		ELSE	"mi"."TimeToCompletion"	END											AS "TimeToCompletion",
		"mi"."DocTypeTitle"															AS "SubTypeTitle",

		COALESCE("mi"."FullNumber", '') || ', ' || COALESCE("mi"."Subject", '')		AS "DocDescription",
		
		
		"mi"."AuthorID"																AS "AuthorID",
		"mi"."ControllerID"															AS "RegistratorID",
		"mi"."DocDate"																AS "DocDate",
		
		

		(SELECT string_agg(concat("CtP"."UserName", "CtD"."SubStateName",
		''
		)
		,
		chr(10)
		)
		from "ControlTaskDecisions" as "CtD"
		inner join "ControlTaskPerformers" as "CtP" on "CtD"."RowID" = "CtP"."ParentRowID"
		where "mi"."ID"="CtD"."ID" ) 												AS "PerformersList",
		
	--	(SELECT string_agg(concat("CtD"."UserName",' - ',"CtD"."Planned,' - ',"CtD"."SubStateName"), concat(';',chr(10)))  
	--		from "ControlTaskDecisions" as "CtD" where "mi"."ID"="CtD"."ID") 		AS "PerformersList", 
		"mi"."SignedByID"															AS "SignedByID",
		"mi"."ParentTaskID"															AS "ParentTaskID",
		0::int8																		AS "rn",
		
		"mi"."QuantsToFinish"														AS "QuantsToFinish",

		(select string_agg(concat("f"."Name",' (', "f"."CreatedByName", ')'),chr(10))
				from "Files" as "f" where "mi"."ID"="f"."ID")
																					AS "FilesList"
		
		}
		#if(ByDocType) {
		"mi"."SubTypeID",
		"kdt"."Title"																AS "SubTypeTitle",
		"mi"."SubTypeCount"
		}
		#if(ByState) {
		"mi".*
		}
		#if(Count) {
		"mi".*
		}
		
	FROM (
		SELECT
			#if(Normal) {
			"mi"."ID",
			"mi"."CardTypeID",
			"mi"."Number",
			"mi"."FullNumber",
			"mi"."DocTypeTitle",
			"mi"."Subject",
			"mi"."AuthorID",
			"mi"."AuthorName",
			"mi"."ControllerID",
			"mi"."RegistratorID",
			"mi"."RegistratorName",
			"mi"."ControllerName",
			"mi"."DocDate",
			"mi"."CreationDate",
			"mi"."DepartmentName",
			"mi"."TaskDeadline",
			"mi"."TaskFact",
			"mi"."SignedByID",
			"mi"."SignedByName",
			"mi"."ParentTaskID",
			"mi"."ParentID",
			"mi"."ManualStateName",
			"mi"."ManualStateID",
			"mi"."ParentDescription",
			"mi"."OrderPoint",
			"mi"."ExpandTextTask",
			"mi"."CategoryName",
			"mi"."NumberOfTransfers",
			"mi"."ControlStatusID",
			"mi"."ControlStatusName",
			"mi"."TaskFactControl",
			"mi"."GroundsDeregistrationName",
			"mi"."CommissionTemplateText",
			"mi"."Notes",
			CASE
				WHEN 180 = "сlientUtcOffset" THEN
					"GetTimeIntervalLiteral"("qq"."QuantNumber" - "qq1"."QuantNumber")	
				ELSE
					CASE
						WHEN 180 >= 0 THEN
							"GetTimeIntervalLiteral"("qq"."QuantNumber" - "qq1"."QuantNumber") || 
							' (UTC+' || TO_CHAR('1 minute'::interval * 180, 'HH24:MI')  || ')'
						ELSE
							"GetTimeIntervalLiteral"("qq"."QuantNumber" - "qq1"."QuantNumber") || 
							' (UTC-' || TO_CHAR('1 minute'::interval * ABS(180), 'HH24:MI')  || ')'
						END
					END													AS "TimeToCompletion",
			("qq"."QuantNumber" - "qq1"."QuantNumber")					AS "QuantsToFinish"
			--"f"."Name"													AS "FileName",
			--"f"."CreatedByName"											AS "FileCreatedByName"
			}
			#if(ByDocType | ByState) {
			"t".*
			}
			
			#if(Count) {
			"t".*
			}
		FROM (
			SELECT
				#if(Normal) {
				"mi"."ID"
				}
				#if(Count) {
				count(*) AS "cnt"
				}
				#if(ByDocType) {
				"mi"."DocTypeID" 									AS "SubTypeID",
				count(*)											AS "SubTypeCount"
				}
				#if(ByState) {
				COALESCE("kr"."StateID", CAST(0 AS smallint))		AS "StateID",
				COALESCE("kr"."StateName", '$KrStates_Doc_Draft')	AS "StateName",
				count(*)											AS "StateCount"
				}
			#if(UseCommonInfo) {
			FROM "DocumentCommonInfo" AS "mi"
			} {
			-- Алиас "mi" должен быть таким же, как у DocumentCommonInfo
			FROM "Instances" AS "mi"
			
			}
			#if(ByState || State || IsInitiator || KrState) {
			LEFT JOIN "KrApprovalCommonInfo" AS "kr"
				ON "kr"."MainCardID" = "mi"."ID"
			}
			WHERE
				#if(UseCommonInfo) {
				"mi"."CardTypeID"
				} {
				"mi"."TypeID"
				}
				in ('01ad498e-5f8e-417a-bd28-942739dbf342', '0d4db642-7b3e-4988-92e9-2fd3752a488c')
				-- Document
				#if(CreationDate || ParentNumber || DocRegDate 
					|| CardOutgoingNumber || CardOutgoingDate || DocTypeTitle || CategoryName
					|| Department || ParentSubject)
				{
				AND exists 
				   	    (
				    	SELECT null FROM "DocumentCommonInfo" as "dci"
					    where   "dci"."ID" = "mi"."ParentID"
						#param(CreationDate, CAST("dci"."CreationDate"  as date)) --Создано
						#param(ParentNumber, "dci"."FullNumber") --№ Док
						#param(DocRegDate, "dci"."DocDate") ---- Дата док.
						#param(CardOutgoingNumber, "dci"."OutgoingNumber") ---- № Внеш.
						#param(CardOutgoingDate, "dci"."CardOutgoingDate") ---- Дата внеш.
						#param(DocTypeTitle, "dci"."DocTypeID") -- Группа документов
						#param(CategoryName, "dci"."TypeOfDocumentID") -- Вид документа
						#param(Department, "dci"."DepartmentID") -- Место создания
						#param(ParentSubject, "dci"."Subject") -- Заголовок документа
					    Limit 1
					    )
				}
				#if(Performer)
				{				
					AND exists
			    	(
			    	SELECT NULL from "ControlTaskPerformers" as "CTP"
			    	where "CTP"."ID" = "mi"."ID"
			    	#param(Performer,"CTP"."UserID")
			    	)
		    	}		    	
		    	#if(Correspondents)
				{				
					AND exists
			    	(
			    	SELECT NULL from "Correspondents" as "cr"
			    	where "cr"."ID" = "mi"."ParentID"
			    	#param(Correspondents,"cr"."PartnersID")
			    	)
		    	}
		    	
				#param(DocDate, "mi"."CreationDate") -- дата контрольной карты
				#param(OrderPoint, "mi"."OrderPoint") -- номер пункта
				#param(Number, "mi"."FullNumber") -- номер контрольной карты
				#param(Subject, "mi"."CommissionTemplateText") -- поручение
				#param(ExpandTextTask, "mi"."ExpandTextTask") -- содержание поручения
				#param(TaskDeadline, "mi"."TaskDeadline") -- срок поручения
				#param(NumberOfTransfers, "mi"."NumberOfTransfers")-- количество переносов
				#param(Notes, "mi"."Notes")-- комментарий контролера об исполнении
				#param(Author, "mi"."AuthorID") -- автор поручения
				#param(Registrator, "mi"."ControllerID") -- контролер поручения
				#param(CategoryTaskName, "mi"."CategoryID") -- вид поручения
				#param(GroundsDeregistrationName, "mi"."GroundsDeregistrationID") -- основание для снятия с контроля
				#if(AuthorComDepartment)
				{
				AND exists
			    	(
					select "ro"."HeadID" from "Roles" as "ro"
					inner join "RoleUsers" as "ru" on "ru"."ID" = "ro"."ID"
					where "ru"."UserID" = "mi"."AuthorID" 
					and "ru"."IsDeputy" = false and "ro"."TypeID" = 2
					#param(AuthorComDepartment,"ro"."HeadID")
					limit 1)-- ведомство автора поручения
				}
				#param(State, COALESCE("mi"."ManualStateID", 0)) --статус исполнения поручения
				#param(TaskFact, "mi"."TaskFact") --Фактическая дата исполнения
				#param(TaskFactControl, "mi"."TaskFactControl") --Дата снятия с контроля
				#if(СontrolerComDepartment)
				{
				AND exists
			    	(
					select "ro"."HeadID" from "Roles" as "ro"
					inner join "RoleUsers" as "ru" on "ru"."ID" = "ro"."ID"
					where "ru"."UserID" = "mi"."RegistratorID" 
					and "ru"."IsDeputy" = false and "ro"."TypeID" = 2
					#param(СontrolerComDepartment,"ro"."HeadID")
					limit 1)-- ведомство контролера поручения
				}
				#if(OutgoingRefDocs)
				{				
					AND exists
			    	(
			    	SELECT NULL from "OutgoingRefDocs" as "ord"
			    	where "ord"."ID" = "mi"."ID"
			    	#param(OutgoingRefDocs,"ord"."DocID")
			    	)
		    	} -- документы подтверждающие исполнение
		    	#if(SignedBy)
				{				
				AND exists
			    	(
			    	SELECT NULL from "ControlTaskPerformers" as "CTP"
			    	inner join "ControlTaskDecisions" as "CTD" on "CTP"."ParentRowID" = "CTD"."RowID"
			    	where "CTP"."ID" = "mi"."ID" and "CTD"."IsResponsible" = true
			    	#param(SignedBy,"CTP"."UserID")
			    	)
		    	}  -- ответственный исполнитель
		    	#if(ExecutorComDepartment)
				{
				AND exists
			    	(
					select "ro"."HeadID" from "Roles" as "ro"
					inner join "RoleUsers" as "ru" on "ru"."ID" = "ro"."ID"
					where "ru"."UserID" = 
										(
										SELECT "CTP"."UserID" from "ControlTaskPerformers" as "CTP"
			    						inner join "ControlTaskDecisions" as "CTD" on
			    						"CTP"."ParentRowID" = "CTD"."RowID"
			    						where "CTP"."ID" = "mi"."ID" and "CTD"."IsResponsible" = true
			    						limit
			    						)
					and "ru"."IsDeputy" = false and "ro"."TypeID" = 2
					#param(ExecutorComDepartment,"ro"."HeadID")
					limit 1)-- ведомство контролера поручения
				}
				#param(KrState, COALESCE("kr"."StateID", 0))
				#param(ControlState, COALESCE("mi"."ControlStatusID", 0))
				#param(DocType, "mi"."DocTypeID")
				#param(TaskBaseNum, "mi"."TaskBaseNum")
				#param(TaskBaseDocType, "mi"."TaskBaseDocTypeTitle")
				
				#param(Parent, "mi"."ParentID")
				
				#if(ParentTask)
				{	
				AND exists
		    	(
		    	SELECT "ID" FROM "childs" as "chi" where "chi"."ID" = "mi"."ID" --and t.id != #param(ParentDepID)
		    	)
				}
				#if(ISProject)
				{
				and "mi"."CategoryID" = '0a4f078d-7ff6-4ece-8f75-b6e4d7e0790d'
				}
				#if(OnControl)
				{
				and "mi"."ControlStatusName" = 'На контроле'
				}
				#if(RemovedFromControl)
				{
				and "mi"."ControlStatusName" = 'Снято с контроля'
				}
				#if(DeadlineSevenDays)
				{
				and extract(day from "mi"."TaskDeadline" - current_timestamp) <= 7 and extract(day from "mi"."TaskDeadline" - current_timestamp) > 0
				}
				#if(DeadlineFiveDays)
				{
				and extract(day from "mi"."TaskDeadline" - current_timestamp) <= 5 and extract(day from "mi"."TaskDeadline" - current_timestamp) > 0
				}
				#if(DeadlineToday)
				{
				and extract(day from "mi"."TaskDeadline" - current_timestamp) <= 1 and extract(day from "mi"."TaskDeadline" - current_timestamp) > 0
				}
				#if(DeadlinePast)
				{
				and extract(day from "mi"."TaskDeadline" - current_timestamp) <= 0
				}
				--#param(OutgoingRefDocs, (SELECT string_agg("OutgoingRefDocs"."DocDescription", ', ') from "OutgoingRefDocs" where "mi"."ID"="OutgoingRefDocs"."ID"))
				#if(IsAuthor) {
					#if(IsAuthor.CriteriaName == "IsTrue") {
				and ("mi"."CardTypeID" = '01ad498e-5f8e-417a-bd28-942739dbf342') AND ("mi"."AuthorID" = #param(CurrentUserID) OR "mi"."AuthorID" IN (Select "d"."DeputizedID" from "RoleDeputies" as "d" where "d"."DeputyID" = #param(CurrentUserID) ))
					} {
				AND ("mi"."AuthorID" IS NULL OR "mi"."AuthorID" <> #param(CurrentUserID))
					}
				}
				#if(IsMe) {
				AND (select "ro"."HeadName" from "Roles" as "ro"
		inner join "RoleUsers" as "ru" on "ru"."ID" = "ro"."ID"
		where "ru"."UserID" = #param(CurrentUserID)
		and "ru"."IsDeputy" = false and "ro"."TypeID" = 2) in (select "ro"."HeadName" from "Roles" as "ro"
		inner join "RoleUsers" as "ru" on "ru"."ID" = "ro"."ID"
		where "ru"."UserID" IN (select "CtP"."UserID" from "ControlTaskPerformers" as "CtP" where "mi"."ID"="CtP"."ID") 
		and "ru"."IsDeputy" = false and "ro"."TypeID" = 2)  	
				}
				#if(IsRegistrator) {
					#if(IsRegistrator.CriteriaName == "IsTrue") {
				and "mi"."CardTypeID" = '01ad498e-5f8e-417a-bd28-942739dbf342' AND ("mi"."ControllerID" = #param(CurrentUserID)  OR "mi"."ControllerID" IN (Select "d"."DeputizedID" from "RoleDeputies" as "d" where "d"."DeputyID" = #param(CurrentUserID) ))
					} {
				AND ("mi"."ControllerID" IS NULL OR "mi"."ControllerID" <> #param(CurrentUserID))
					}
				}
				#if(IsInitiator) {
					#if(IsInitiator.CriteriaName == "IsTrue") {
				AND "kr"."AuthorID" = #param(CurrentUserID)
					} {
				AND ("kr"."AuthorID" IS NULL OR "kr"."AuthorID" <> #param(CurrentUserID))
					}
				}
				#if(IsResponsible) {
					#if(IsResponsible.CriteriaName == "IsTrue") {
				AND exists
		    	(
		    	SELECT "ID" FROM "ControlTaskPerformers" as "CTP" where "CTP"."ID" = "mi"."ID" and "CTP"."UserID" = #param(CurrentUserID)
		    	)
					}
				}
				#if(Performer) {
				AND exists
		    	(
		    	SELECT "ID" FROM "ControlTaskPerformers" as "CTP" where "CTP"."ID" = "mi"."ID" #param(Performer,"CTP"."UserID")
		    	)
				}
				#if(Report) {
				AND exists
		    	(
		    	SELECT "ID" FROM "ControlTaskDecisions" as "CTD" where "CTD"."ID" = "mi"."ID" and "CTD"."Report" is not null
		    	)
				}
			#if(Normal) {
			ORDER BY #order_by
			}
			#if(PageOffset) {
			OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
			}
			#if(ByDocType) {
			GROUP BY "mi"."DocTypeID"
			}
			#if(ByState) {
			GROUP BY COALESCE("kr"."StateID", CAST(0 AS smallint)), COALESCE("kr"."StateName", '$KrStates_Doc_Draft')
			}
			) AS "t"
		#if(Normal) {
		INNER JOIN "DocumentCommonInfo" AS "mi"
			ON "mi"."ID" = "t"."ID"
		
	--	LEFT JOIN "Files" AS "f"
--			ON "f"."ID" = "mi"."ID"
		LEFT JOIN LATERAL (
			SELECT "q"."QuantNumber"
			FROM "CalendarQuants" AS "q"
			WHERE "q"."StartTime" <= ("mi"."TaskDeadline" + interval '18 hours') + 180 * interval '1 minute'
			ORDER BY "q"."StartTime" DESC
			LIMIT 1
			) AS "qq" ON true
		LEFT JOIN LATERAL (
			SELECT "q"."QuantNumber"
			FROM "CalendarQuants" AS "q"
			WHERE "q"."StartTime" <= "now_timestamp" + 180 * interval '1 minute'
			ORDER BY "q"."StartTime" DESC
			LIMIT 1
			) AS "qq1" ON true
		}
		) AS "mi"
	#if(Normal) {
	LEFT JOIN "KrApprovalCommonInfo" AS "kr"
		ON "kr"."MainCardID" = "mi"."ID"
	ORDER BY #order_by
	}
	
	#if(ByState) {
	CROSS JOIN "Localization"("mi"."StateName", #param(locale)) AS "sls" --Локализуем состояние документа
	ORDER BY "sls"."Value"
	}
	#if(ByDocType) {
	INNER JOIN "KrDocType" AS "kdt"
		ON "kdt"."ID" = "mi"."SubTypeID"
	CROSS JOIN "Localization"("kdt"."Title", #param(locale)) AS "tls" --Локализуем тип документа
--	Where true

--	and "GetTimeIntervalLiteral"("mi"."QuantsToFinish") <= 5
--	and "GetTimeIntervalLiteral"("mi"."QuantsToFinish") > 0

	ORDER BY "tls"."Value"
	};
END;