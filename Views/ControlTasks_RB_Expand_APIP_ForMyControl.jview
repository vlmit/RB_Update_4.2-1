      "Alias": "RemovedFromControl",
      "AllowedOperands": [
        {
          "::single_type": "str"
        },
        "IsTrue"
      ],
      "AutoCompleteInfo": null,
      "Caption": "Снято с контроля",
      "Condition": null,
