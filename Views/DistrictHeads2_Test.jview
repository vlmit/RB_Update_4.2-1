[TEXTPART DistrictHeads2_Test MSSQL]


[TEXTPART DistrictHeads2_Test PGSQL]

SELECT 
	--"dr"."ID",
	--"r"."ID" as "DepID",
	--"r"."Name" as "DepName",
	"ru"."UserID" as "UserID",
	"ru"."UserName" as "UserName"
	
FROM
	"RoleUsers" as "ru"
--LEFT JOIN "Roles" as "r" on "r"."ID" = "pr"."ID"
WHERE
	"ru"."ID" = 'f5fd5ffe-dae5-4838-8e16-5e4d7670418d' -- ID статической роли

--"r"."Hidden" is false 
--	"r"."ParentID" = '0374e055-b527-45ef-b32e-79fcd739cb6b'
	
order by #order_by