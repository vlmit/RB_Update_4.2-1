[TEXTPART KrProcessManagementStageTypeModes MSSQL]
SELECT
	[a].[ID]		AS [RefID],
	[a].[Name]		AS [RefName]
FROM [KrProcessManagementStageTypeModes] AS [a] WITH (NOLOCK)
#if(Name) {
CROSS APPLY [Localization]([a].[Name], #param(locale)) AS [l]
}
WHERE 1 = 1
	#param(Name, [l].[Value])
ORDER BY [a].[ID]


