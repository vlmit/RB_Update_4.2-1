[TEXTPART AllDocuments_control_noMEDO_limited_{e2526b25-6271-44e1-8b5d-9e7131f14a5e}(copy) MSSQL]
#var(UseCommonInfo: Normal || ByType || Number || Subject || DocDate || Author || Registrator || Department || Type || IsAuthor || IsRegistrator)

DECLARE @Project nvarchar(max);
SET @Project = [dbo].[GetString](N'Views_Registers_Project_Sql', #param(locale));

SELECT
	#if(Normal) {
	[mi].[ID]																		AS [DocID],
	[mi].[FullNumber]																AS [DocNumber],
	[mi].[Subject]																	AS [DocSubject],
	COALESCE([mi].[FullNumber], N'') + N', ' + COALESCE([mi].[Subject], N'')		AS [DocDescription], 	-- autocomplete
	[mi].[AuthorID],
	[mi].[AuthorName],
	[mi].[RegistratorID],
	[mi].[RegistratorName],
	COALESCE([kr].[StateName], @Project)											AS [KrState],
	CAST(COALESCE([kr].[StateChangedDateTimeUTC], [mi].[CreationDate]) AS date)		AS [KrStateModified],
	CAST([mi].[DocDate] AS date)													AS [DocDate],
	CAST([mi].[CreationDate] AS date)												AS [CreationDate],
	[mi].[DepartmentName]															AS [Department],
	[kr].[ApprovedBy],
	[kr].[DisapprovedBy],
	N'#appearance(Background: ' + CASE
		WHEN ([kr].[StateID] = 1 OR [kr].[StateID] = 10) AND [kr].[DisapprovedBy] IS NOT NULL AND [kr].[DisapprovedBy] <> N''	-- Red: active/signing AND has disapprovers
			THEN N'#70FF0000'
		WHEN [kr].[StateID] = 2 OR [kr].[StateID] = 6 OR [kr].[StateID] = 8														-- Green: approved/signed/registered
			THEN N'#7000FF00'
		WHEN [kr].[StateID] = 4																									-- Yellow: editing
			THEN N'#70FFFF00'
		ELSE N'#00000000'																										-- Transparent: other
	END + N')'																		AS [Background],
	[t].[rn]
	}

	#if(Count) {
	[t].*
	}

	#if(ByType) {
	[t].[TypeID],
	[lName].[Value] AS [TypeName],
	[t].[TypeCount]
	}

	#if(ByState) {
	[t].*
	}
FROM (
	SELECT
		#if(Normal) {
		[t].[ID],
		row_number() OVER (ORDER BY #order_by) AS [rn]
		}

		#if(Count) {
		count(*) AS [cnt]
		}

		#if(ByType) {
		COALESCE([mi].[DocTypeID], [mi].[CardTypeID])		AS [TypeID],
		count(*)											AS [TypeCount]
		}

		#if(ByState) {
		COALESCE([kr].[StateID], CAST(0 AS smallint))		AS [StateID],
		COALESCE([kr].[StateName], N'$KrStates_Doc_Draft')	AS [StateName],
		count(*)											AS [StateCount]
		}
	FROM (
		-- я автор
		SELECT [ID]
		FROM [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		WHERE [mi].[AuthorID] = #param(CurrentUserID)

		UNION
		-- я регистратор
		SELECT [ID]
		FROM [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		WHERE [mi].[RegistratorID] = #param(CurrentUserID)

		UNION
		-- я инициатор
		SELECT [MainCardID]
		FROM [KrApprovalCommonInfo] AS [kr] WITH (NOLOCK)
		WHERE [kr].[AuthorID] = #param(CurrentUserID)
		) AS [t]

	#if(UseCommonInfo) {
	INNER JOIN [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
		ON [mi].[ID] = [t].[ID]
	}

	#if(ByState || State || IsInitiator) {
	LEFT JOIN [KrApprovalCommonInfo] AS [kr] WITH (NOLOCK)
		ON [kr].[MainCardID] = [t].[ID]
	}

	WHERE 1 = 1
		#param(Number, [mi].[FullNumber])
		#param(Subject, [mi].[Subject])
		#param(DocDate, [mi].[DocDate])
		#param(State, COALESCE([kr].[StateID], 0))
		#param(Author, [mi].[AuthorID])
		#param(Registrator, [mi].[RegistratorID])
		#param(Department, [mi].[DepartmentID])

		#if(Type) {
		AND (1 = 1 #param(Type, [mi].[DocTypeID]) OR 1 = 1 #param(Type, [mi].[CardTypeID]))
		}

		#if(IsAuthor) {
			#if(IsAuthor.CriteriaName == "IsTrue") {
		AND [mi].[AuthorID] = #param(CurrentUserID)
			} {
		AND ([mi].[AuthorID] IS NULL OR [mi].[AuthorID] <> #param(CurrentUserID))
			}
		}

		#if(IsRegistrator) {
			#if(IsRegistrator.CriteriaName == "IsTrue") {
		AND [mi].[RegistratorID] = #param(CurrentUserID)
			} {
		AND ([mi].[RegistratorID] IS NULL OR [mi].[RegistratorID] <> #param(CurrentUserID))
			}
		}

		#if(IsInitiator) {
			#if(IsInitiator.CriteriaName == "IsTrue") {
		AND [kr].[AuthorID] = #param(CurrentUserID)
			} {
		AND ([kr].[AuthorID] IS NULL OR [kr].[AuthorID] <> #param(CurrentUserID))
			}
		}

	#if(ByType) {
	GROUP BY COALESCE([mi].[DocTypeID], [mi].[CardTypeID])
	}

	#if(ByState) {
	GROUP BY COALESCE([kr].[StateID], CAST(0 AS smallint)), COALESCE([kr].[StateName], N'$KrStates_Doc_Draft')
	}
	) AS [t]

#if(Normal) {
INNER JOIN [DocumentCommonInfo] AS [mi] WITH (NOLOCK)
	ON [mi].[ID] = [t].[ID]
INNER JOIN [Types] AS [tt] WITH (NOLOCK)
	ON [tt].[ID] = [mi].[CardTypeID]
LEFT JOIN [KrApprovalCommonInfo] AS [kr] WITH (NOLOCK)
	ON [kr].[MainCardID] = [t].[ID]
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
ORDER BY [t].[rn]
}

#if(ByState) {
CROSS APPLY [Localization]([t].[StateName], #param(locale)) AS [lStateName]
ORDER BY [lStateName].[Value]
}

#if(ByType) {
LEFT JOIN [KrDocType] AS [kdt] WITH (NOLOCK)
	ON [kdt].[ID] = [t].[TypeID]
LEFT JOIN [Types] AS [tt] WITH (NOLOCK)
	ON [tt].[ID] = [t].[TypeID]
CROSS APPLY [Localization](COALESCE([kdt].[Title], [tt].[Caption]), #param(locale)) AS [lName]
ORDER BY [lName].[Value]
}
;

[TEXTPART AllDocuments_control_noMEDO_limited_{e2526b25-6271-44e1-8b5d-9e7131f14a5e}(copy) PGSQL]
DECLARE
	"project" text;
BEGIN
	#var(UseCommonInfo: Normal || ByType || Number || Subject || OutgoingNumber || DocDate || OutgoingDate || Author || Registrator || Department || Type || IsAuthor || IsRegistrator 
	|| AllTypesSearch || Type2 || Recipients || Correspondents)

	"project" = "GetString"('Views_Registers_Project_Sql', #param(locale));
	#if(!ByType && !Number && !Subject && !OutgoingNumber && !OutgoingDate && !DocDate && !Author && !Registrator && !Department && !Type && !IsAuthor && !IsRegistrator 
	&& !AllTypesSearch && !Recipients && !Correspondents) {
	} 
	{
	RETURN QUERY
	SELECT
		#if(Normal) {
		"mi"."ID"																		AS "DocID",
		"mi"."FullNumber"																AS "DocNumber",
		CAST("mi"."DocDate" AS date)													AS "DocDate",
		"mi"."OutgoingNumber"															AS "OutgoingNumber",

		
		COALESCE("mi"."FullNumber", '') || ', ' || COALESCE("mi"."Subject", '')			AS "DocDescription",		-- autocomplete
        CAST("mi"."OutgoingDate" AS date)												AS "OutgoingDate",
		(SELECT string_agg("Correspondents"."PartnersName", ', ')
            FROM "Correspondents"
            WHERE "Correspondents"."ID" = "mi"."ID"
            ORDER BY #order_by
            --ORDER BY "Correspondents"."PartnersName"
        )                                                                                AS "Correspondents",
        "mi"."Subject"																	AS "DocSubject",
        
		"mi"."AuthorID",
		COALESCE("mi"."AuthorName", "mi"."RegistratorName") 							as "AuthorName",
		"mi"."DocTypeTitle"																AS "DocTypeTitle",
		(SELECT string_agg("Recipients"."UserName", ', ')
            FROM "Recipients"
            WHERE "Recipients"."ID" = "mi"."ID"
            ORDER BY #order_by
            --ORDER BY "Recipients"."UserName"
        )                                                                                AS "RecipientsName",

		"mi"."RegistratorID",
		"mi"."RegistratorName",
		COALESCE("kr"."StateName", "project")											AS "KrState",
		CAST(COALESCE("kr"."StateChangedDateTimeUTC", "mi"."CreationDate") AS date)		AS "KrStateModified",
		

		
		
		
		--TO_CHAR("mi"."DocDate", 'DD.MM.YYYY') 
		CAST("mi"."CreationDate" AS date)												AS "CreationDate",		
		"kr"."ApprovedBy",
		"kr"."DisapprovedBy",
		'#appearance(Background: ' || CASE
			WHEN ("kr"."StateID" = 1 OR "kr"."StateID" = 10) AND "kr"."DisapprovedBy" IS NOT NULL AND "kr"."DisapprovedBy" <> ''	-- Red: active/signing AND has disapprovers
				THEN '#70FF0000'
			WHEN "kr"."StateID" = 2 OR "kr"."StateID" = 6 OR "kr"."StateID" = 8														-- Green: approved/signed/registered
				THEN '#7000FF00'
			WHEN "kr"."StateID" = 4																									-- Yellow: editing
				THEN '#70FFFF00'
			ELSE '#00000000'																										-- Transparent: other
		END || ')'																		AS "Background",
		0::int8																			AS "rn"
		}

		#if(Count) {
		"t".*
		}

		#if(ByType) {
		"t"."TypeID",
		"lName"."Value" AS "TypeName",
		"t"."TypeCount"
		}

		#if(ByState) {
		"t".*
		}
	FROM (
		SELECT
			#if(Normal) {
			"t"."ID"
			}

			#if(Count) {
			count(*) AS "cnt"
			}

			#if(ByType) {
			COALESCE("mi"."DocTypeID", "mi"."CardTypeID")		AS "TypeID",
			count(*)											AS "TypeCount"
			}

			#if(ByState) {
			COALESCE("kr"."StateID", CAST(0 AS smallint))		AS "StateID",
			COALESCE("kr"."StateName", '$KrStates_Doc_Draft')	AS "StateName",
			count(*)											AS "StateCount"
			}
		FROM (
			-- я автор
			SELECT "ID"
			FROM "DocumentCommonInfo" AS "mi"
			where "mi"."ID" != '1826344c-904c-48d7-b604-e46bbb318175'
			and "mi"."DocTypeID" in 
			(
			select "tt"."TypeID" from "KrPermissionTypes" as "tt"
			inner JOIN "KrPermissionRoles" AS "tr"
			ON "tr"."ID" = "tt"."ID"
			inner JOIN "KrPermissions" AS "kp"
			ON "kp"."ID" = "tt"."ID"
			where
			"kp"."IsDisabled" = false and
			"tt"."ID" != 'f523921c-ce6d-4871-82e9-5297baaddd34' -- правило для всех сотрудников
			and "tt"."ID" != '721a4879-09f0-46ee-83f7-b65cfdaeb111' -- правило для администраторов
			and "tt"."ID" != '6ae538ba-fa05-4792-bc54-120cd05ceaf3' -- Правило для подписания ЭП на планшетах
			and EXISTS (
			SELECT NULL
			FROM "RoleUsers" AS "ru"
			WHERE "ru"."ID" = "tr"."RoleID"
				AND "ru"."TypeID" <> 6
				and "ru"."UserID" = '3d728b5d-7ac3-4beb-8bd1-879f2de55624'
				
			)
			)
			) AS "t"

		#if(UseCommonInfo) {
		INNER JOIN "DocumentCommonInfo" AS "mi"
			ON "mi"."ID" = "t"."ID"
		}

		#if(ByState || State || IsInitiator) {
		LEFT JOIN "KrApprovalCommonInfo" AS "kr"
			ON "kr"."MainCardID" = "t"."ID"
		}
		{
		LEFT JOIN "KrApprovalCommonInfo" AS "kr"
			ON "kr"."MainCardID" = "t"."ID"
		
		}

		WHERE true
			and "mi"."DocTypeTitle"!='Входящий МЭДО'
			#param(Number, "mi"."FullNumber")
			#param(Subject, "mi"."Subject")
			#param(OutgoingNumber, "mi"."OutgoingNumber")
			#param(DocDate, "mi"."DocDate")
			#param(OutgoingDate, "mi"."OutgoingDate")
			#param(State, COALESCE("kr"."StateID", 0))
			#param(Author, "mi"."AuthorID")
			#param(Registrator, "mi"."RegistratorID")
			#param(Department, "mi"."DepartmentID")
			#if(Correspondents)
				{				
					AND exists
			    	(
			    	SELECT NULL from "Correspondents" as "cr"
			    	where "cr"."ID" = "mi"."ID"
			    	#param(Correspondents,"cr"."PartnersID")
			    	)
		    	}
		    #if(Recipients)
				{				
					AND exists
			    	(
			    	SELECT NULL from "Recipients" as "re"
			    	where "re"."ID" = "mi"."ID"
			    	#param(Recipients,"re"."UserID")
			    	)
		    	}
			#if(AllTypesSearch)
			{
			and (  
			    (true #param(AllTypesSearch, "mi"."FullNumber"))
				or
				(true #param(AllTypesSearch, "mi"."Subject"))
				or
				(TRUE #param(AllTypesSearch, "mi"."AuthorName"))
				or
				(TRUE #param(AllTypesSearch, "mi"."RegistratorName")) 
		--		or
		--		(TRUE #param(AllTypesSearch, "GetString"("kr"."StateName", #param(locale)))) -- не работает
				or
				(TRUE #param(AllTypesSearch, TO_CHAR(COALESCE("kr"."StateChangedDateTimeUTC", "mi"."CreationDate"), 'DD.MM.YYYY'))) --?
				or
				(TRUE #param(AllTypesSearch, TO_CHAR("mi"."DocDate", 'DD.MM.YYYY')))
				or
				(TRUE #param(AllTypesSearch, TO_CHAR("mi"."CreationDate", 'DD.MM.YYYY')))
				or
				(TRUE #param(AllTypesSearch, "mi"."DepartmentName"))
				or
				(TRUE #param(AllTypesSearch, "kr"."ApprovedBy"))
				or
				(TRUE #param(AllTypesSearch, "kr"."DisapprovedBy"))
				)
			}
			#if(Type) {
			AND (true #param(Type, "mi"."DocTypeID") OR true #param(Type, "mi"."CardTypeID"))
			}
			#if(Type2) {
			and "mi"."CardTypeID" != '01ad498e-5f8e-417a-bd28-942739dbf342' -- исключили поручения
			and "mi"."CardTypeID" != '0d4db642-7b3e-4988-92e9-2fd3752a488c' -- исключили КК
			}

			#if(IsAuthor) {
				#if(IsAuthor.CriteriaName == "IsTrue") {
			AND "mi"."AuthorID" = '3d728b5d-7ac3-4beb-8bd1-879f2de55624'
				} {
			AND ("mi"."AuthorID" IS NULL OR "mi"."AuthorID" <> '3d728b5d-7ac3-4beb-8bd1-879f2de55624')
				}
			}

			#if(IsRegistrator) {
				#if(IsRegistrator.CriteriaName == "IsTrue") {
			AND "mi"."RegistratorID" = '3d728b5d-7ac3-4beb-8bd1-879f2de55624'
				} {
			AND ("mi"."RegistratorID" IS NULL OR "mi"."RegistratorID" <> '3d728b5d-7ac3-4beb-8bd1-879f2de55624')
				}
			}

			#if(IsInitiator) {
				#if(IsInitiator.CriteriaName == "IsTrue") {
			AND "kr"."AuthorID" = '3d728b5d-7ac3-4beb-8bd1-879f2de55624'
				} {
			AND ("kr"."AuthorID" IS NULL OR "kr"."AuthorID" <> '3d728b5d-7ac3-4beb-8bd1-879f2de55624')
				}
			}

		#if(Normal) {
		ORDER BY #order_by
		}

		#if(PageOffset) {
		OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
		}

		#if(ByType) {
		GROUP BY COALESCE("mi"."DocTypeID", "mi"."CardTypeID")
		}

		#if(ByState) {
		GROUP BY COALESCE("kr"."StateID", CAST(0 AS smallint)), COALESCE("kr"."StateName", '$KrStates_Doc_Draft')
		}
		) AS "t"

	#if(Normal) {
	INNER JOIN "DocumentCommonInfo" AS "mi"
		ON "mi"."ID" = "t"."ID"
	INNER JOIN "Types" AS "tt"
		ON "tt"."ID" = "mi"."CardTypeID"
	LEFT JOIN "KrApprovalCommonInfo" AS "kr"
		ON "kr"."MainCardID" = "t"."ID"

	ORDER BY #order_by
	}

	#if(ByState) {
	CROSS JOIN "Localization"("t"."StateName", #param(locale)) AS "lStateName"
	ORDER BY "lStateName"."Value"
	}

	#if(ByType) {
	LEFT JOIN "KrDocType" AS "kdt"
		ON "kdt"."ID" = "t"."TypeID"
	LEFT JOIN "Types" AS "tt"
		ON "tt"."ID" = "t"."TypeID"
	CROSS JOIN "Localization"(COALESCE("kdt"."Title", "tt"."Caption"), #param(locale)) AS "lName"
	ORDER BY "lName"."Value"
	};
}
END;