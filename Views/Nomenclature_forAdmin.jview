[TEXTPART Nomenclature_forAdmin MSSQL]


[TEXTPART Nomenclature_forAdmin PGSQL]
SELECT
	#if(Normal) {
	"t"."ID"						AS "NomenclatureID",
	"t"."DepartmentName",
	"t"."Index"						AS "NomenclatureIndex",
	"t"."Name",
	"t"."Article",
	"t"."Duration",
	"t"."Year",
	"t"."Description"				AS "NomenclatureDescription"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
FROM "Nomenclature" AS "t"
WHERE true
	#param(NomenclatureID, "t"."ID")
	#param(DepartmentName, "t"."DepartmentName")
	#param(NomenclatureIndex, "t"."Index")
	#param(Header, "t"."Name")
	--and (TRUE #param(Name, "t"."Name")) or (TRUE #param(Name, "t"."Index"))
	#param(Article, "t"."Article")
	#param(Duration, "t"."Duration")
	#if(Year) {AND (true #param(Year, "t"."Year"))} {AND "t"."Year" = EXTRACT('YEAR' FROM CURRENT_DATE)}
	#param(NomenclatureDescription, "t"."Index")
#if(Normal) {
ORDER BY #order_by
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}
