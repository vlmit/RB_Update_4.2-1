[TEXTPART AllSampleTexts MSSQL]


[TEXTPART AllSampleTexts PGSQL]
SELECT
#if(Normal) {
	st."ID" as "STID",
    st."Text" as "STText",
    st."AuthorID" as "STAuthorID",
    st."AuthorName" as "STAuthorName",
    CASE 
    WHEN "Status" = false 
    	THEN 'Активен'
    	ELSE 'Не активен'
    END AS "STStatus"
    }
#if(Count) { 
	COUNT(*) as cnt
}

FROM "SampleText" as st
WHERE 1=1
#param(Text, st."Text")
#param(Author, st."AuthorID")