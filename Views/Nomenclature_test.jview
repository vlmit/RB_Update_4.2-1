[TEXTPART Nomenclature_test MSSQL]


[TEXTPART Nomenclature_test PGSQL]

	-- ДОЧЕРНИЕ Подразделения
	WITH RECURSIVE "childs" AS (
    SELECT "t"."ID", "t"."ParentID"
    FROM "Roles" as "t"
    WHERE 1=1 
    and ("t"."ID" in (select "ru"."ID" from "RoleUsers" as "ru" where "ru"."UserID" = #param(CurrentUserID) and "ru"."TypeID"=2)
    or
    "t"."ParentID" in (select "ru"."ID" from "RoleUsers" as "ru" where "ru"."UserID" = #param(CurrentUserID) and "ru"."TypeID"=2)
    )
    
   	 UNION 
     SELECT "t"."ID", "t"."ParentID"
     FROM "Roles" as "t"
     INNER JOIN "childs" as "c"
     ON "t"."ParentID" = "c"."ID" or "t"."ID" = "c"."ParentID"
     WHERE 1=1 
 --   and ("t"."ID" in (select "ru"."ID" from "RoleUsers" as "ru" where "ru"."UserID" = #param(CurrentUserID) and "ru"."TypeID"=2)
 --   or
 --   "t"."ParentID" in (select "ru"."ID" from "RoleUsers" as "ru" where "ru"."UserID" = #param(CurrentUserID) and "ru"."TypeID"=2)
 --   )   
	)
SELECT
	#if(Normal) {
	"t"."ID"						AS "NomenclatureID",
	"t"."DepartmentName",
	"t"."Index"						AS "NomenclatureIndex",
	"t"."Name",
	"t"."Article",
	"t"."Duration",
	"t"."Description"				AS "NomenclatureDescription"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
FROM "Nomenclature" AS "t"
WHERE true 
and
"t"."DepartmentName" like '%' || 
(select "pr"."Name" from "Roles" as "pr"
inner join "DepartmentRoles" as "ru" on "ru"."ID"= "pr"."ID"
inner join "RoleUsers" as "ruru" on "ruru"."ID"= "ru"."ID"
where "ruru"."UserID" = #param(CurrentUserID) and "pr"."Name" is not null
limit 1) || '%'
	#param(NomenclatureID, "t"."ID")
	#param(DepartmentName, "t"."DepartmentName")
	#param(NomenclatureIndex, "t"."Index")
	#param(Header, "t"."Name")
	--and (TRUE #param(Name, "t"."Name")) or (TRUE #param(Name, "t"."Index"))
	#param(Article, "t"."Article")
	#param(Duration, "t"."Duration")
	#param(NomenclatureDescription, "t"."Index")
#if(Normal) {
ORDER BY #order_by
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}
