{
  "Alias": "FileCategoriesFilteredNPA",
  "Caption": "Отфильтрованные категории для НПА",
  "Description": " ",
  "GroupName": "System",
  "ID": "47e00286-7da2-40c4-92f1-899f6dead125",
  "JsonMetadataSource::txt": "FileCategoriesFilteredNPA JSONMETA",
  "MsQuerySource::txt": "FileCategoriesFilteredNPA MSSQL",
  "PgQuerySource::txt": "FileCategoriesFilteredNPA PGSQL"
}

[TEXTPART FileCategoriesFilteredNPA JSONMETA]
{
  "Alias": "FileCategoriesFilteredNPA",
  "Caption": "Отфильтрованные категории для НПА",
  "Columns": [
    {
      "Alias": "CategoryID",
      "Hidden": true,
      "Type": "$FileCategories.ID"
    },
    {
      "Alias": "CategoryName",
      "Caption": "$Views_FileCategoriesFiltered_Name",
      "Localizable": true,
      "SortBy": "lName.Value",
      "Type": "$FileCategories.Name"
    },
    {
      "Alias": "rn",
      "Hidden": true,
      "Type": "Int64"
    }
  ],
  "FormatVersion": 5,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_FileCategoriesFiltered_Name_Param",
      "Type": "$FileCategories.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Category",
      "DisplayValueColumn": "CategoryName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "FileCategory"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count"
    }
  ]
}

[TEXTPART FileCategoriesFilteredNPA MSSQL]
SELECT
	[t].*
FROM (
	SELECT
		#if(Normal) {
		[t].[ID]								AS [CategoryID],
		[t].[Name]								AS [CategoryName],
		row_number() OVER (ORDER BY #order_by)	AS [rn]
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM [FileCategories] AS [t] WITH (NOLOCK)
	#if(Name || Normal && request.SortedBy("CategoryName")) {
	CROSS APPLY [Localization]([t].[Name], #param(locale)) AS [lName]
	}
	WHERE 1 = 1
		#param(Name, [lName].[Value])
	) AS [t]
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}

[TEXTPART FileCategoriesFilteredNPA PGSQL]
SELECT
	#if(Normal) {
	"t"."ID"									AS "CategoryID",
	"t"."Name"									AS "CategoryName",
	0::int8										AS "rn"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
FROM "FileCategories" AS "t"
#if(Name || Normal && request.SortedBy("CategoryName")) {
CROSS JOIN "Localization"("t"."Name", #param(locale)) AS "lName"
}
WHERE true
	and "t"."Name" in ('Проект', 'Приложение к проекту', 'Дополнительные материалы', 'Документ')
	#param(Name, "lName"."Value")
#if(Normal) {
ORDER BY "t"."Name" DESC
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}
