[TEXTPART Urgency_NPA MSSQL]


[TEXTPART Urgency_NPA PGSQL]
SELECT
	"pt"."ID"		AS "UrgID",
	CASE WHEN "pt"."Name" = 'Срочно' 		THEN 'Срочно (3 календарных дня)'
		 WHEN "pt"."Name" = 'Весьма срочно' THEN 'Весьма срочно (2 календарных дня)'
		 ELSE "pt"."Name" END		AS "UrgName"
FROM "Urgency" AS "pt"

WHERE true
and "pt"."Name" in ('Обычный приоритет','Срочно','Весьма срочно') 
	#param(Name, "pt"."Name")
ORDER BY 
   CASE "pt"."Name"
      WHEN 'Обычный приоритет' THEN 1
      WHEN 'Срочно' THEN 2
      WHEN 'Весьма срочно' THEN 3
      ELSE 4 --needed only is no IN clause above. eg when = 'b'
   END