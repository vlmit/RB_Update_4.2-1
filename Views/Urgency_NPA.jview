  "PgQuerySource::txt": "Urgency_NPA PGSQL"
}

[TEXTPART Urgency_NPA JSONMETA]
{
  "Alias": "Urgency_NPA",
  "Caption": "Срочность",
  "Columns": [
    {
      "Alias": "UrgID",
      "Hidden": true,
      "Type": "$Urgency.ID"
    },
    {
      "Alias": "UrgName",
      "Caption": "Срочность",
      "Type": "$Urgency.Name"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "UrgID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Multiple": false,
      "Type": "$Urgency.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "CardType": "RB_Urgency",
      "ColPrefix": "Urg",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "Urgency"
      ]
    }
  ]
}

[TEXTPART Urgency_NPA MSSQL]


[TEXTPART Urgency_NPA PGSQL]
SELECT
	"pt"."ID"		AS "UrgID",
	CASE WHEN "pt"."Name" = 'Срочно' 		THEN 'Срочно (3 календарных дня)'
		 WHEN "pt"."Name" = 'Весьма срочно' THEN 'Весьма срочно (2 календарных дня)'
		 ELSE "pt"."Name" END		AS "UrgName"
FROM "Urgency" AS "pt"

WHERE true
and "pt"."Name" in ('Обычный приоритет','Срочно','Весьма срочно') 
	#param(Name, "pt"."Name")
ORDER BY 
   CASE "pt"."Name"
      WHEN 'Обычный приоритет' THEN 1
      WHEN 'Срочно' THEN 2
      WHEN 'Весьма срочно' THEN 3
      ELSE 4 --needed only is no IN clause above. eg when = 'b'
   END
