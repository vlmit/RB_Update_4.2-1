[TEXTPART FileList MSSQL]


[TEXTPART FileList PGSQL]
select
    "t"."ID" as "CardID",
    "t"."Name" as "FileName",
    "t"."RowID" as "FileID",
    "t"."CategoryCaption" as "Category"
from "Files" as "t" 
where 1=1
	#param(FileName, "t"."Name")
    #if(CardID)
    {
    #param(CardID, "t"."ID")
    }
    {
		    #if(CardTaskID)
		    {
		    and "t"."ID" = (select "tsk"."ID" from "TaskHistory" as "tsk" 
		    			where 1=1 #param(CardTaskID, "tsk"."RowID") limit 1)
		    and "t"."CategoryCaption" != 'Документ'
		    }
		    {
		    and 1=0
		    }
    }
