[TEXTPART Tags MSSQL]
SELECT
	#if(Normal) {
		[tt].[ID]			AS [TagID],
		[tt].[Name]			AS [TagName],
		[t].[OwnerID]		AS [TagOwnerID],
		[t].[OwnerName]		AS [TagOwnerName],
		[t].[Background]	AS [TagBackground],
		[t].[IsCommon]		AS [TagIsCommon],
		CAST (CASE WHEN (EXISTS (
			SELECT NULL
			FROM [TagEditors] AS [te]
			INNER JOIN [RoleUsers] AS [ru] WITH (NOLOCK) ON [ru].[ID] = [te].[RoleID]
			WHERE [ru].[UserID] = #param(CurrentUserID) AND [te].[ID] = [t].[ID]))
			OR #param(CurrentUserID) = [t].[OwnerID] THEN (1) ELSE (0) END AS bit) AS [TagCanEdit],
		CAST (CASE WHEN (EXISTS (
			SELECT NULL
			FROM [TagSharedWith] AS [tsw]
			INNER JOIN [RoleUsers] AS [ru] WITH (NOLOCK) ON [ru].[ID] = [tsw].[RoleID]
			WHERE [ru].[UserID] = #param(CurrentUserID) AND [tsw].[ID] = [t].[ID]))
			OR (EXISTS (
			SELECT NULL
			FROM [TagEditors] AS [tsw]
			INNER JOIN [RoleUsers] AS [ru] WITH (NOLOCK) ON [ru].[ID] = [tsw].[RoleID]
			WHERE [ru].[UserID] = #param(CurrentUserID) AND [tsw].[ID] = [t].[ID]))
			OR #param(CurrentUserID) = [t].[OwnerID] THEN (1) ELSE (0) END AS bit) AS [TagCanAddToCard],
		CAST (CASE WHEN (EXISTS (
			SELECT NULL
			FROM [TagSharedWith] AS [tsw]
			INNER JOIN [RoleUsers] AS [ru] WITH (NOLOCK) ON [ru].[ID] = [tsw].[RoleID]
			WHERE [ru].[UserID] = #param(CurrentUserID) AND [tsw].[ID] = [t].[ID]))
			OR (EXISTS (
			SELECT NULL
			FROM [TagReaders] AS [tr]
			INNER JOIN [RoleUsers] AS [ru] WITH (NOLOCK) ON [ru].[ID] = [tr].[RoleID]
			WHERE [ru].[UserID] = #param(CurrentUserID) AND [tr].[ID] = [t].[ID]))
			OR (EXISTS (
			SELECT NULL
			FROM [TagEditors] AS [tsw]
			INNER JOIN [RoleUsers] AS [ru] WITH (NOLOCK) ON [ru].[ID] = [tsw].[RoleID]
			WHERE [ru].[UserID] = #param(CurrentUserID) AND [tsw].[ID] = [t].[ID]))
			OR #param(CurrentUserID) = [t].[OwnerID] THEN (1) ELSE (0) END AS bit) AS [TagCanRead]
	}
	#if(Count) {
	[tt].*
	}
FROM (
	SELECT
		#if(Normal) {
		[t].[ID]
		,[t].[Name]
		#if(Owner) {
			,[t].[OwnerID]
		}
		,row_number() OVER (ORDER BY #order_by) AS [rn]
		}
		#if(Count) {
		count(*)				AS [cnt]
		}
	FROM (
		SELECT
			[t].[ID]
			#if(!Count || Name) {
			,[dbo].[Localize]([t].[Name], #param(locale)) AS [Name]
			}
			#if(Owner) {
			,[t].[OwnerID]
			}
		FROM [Tags] AS [t] WITH (NOLOCK)
		WHERE 1 = 1
		AND [t].[OwnerID] = #param(CurrentUserID)
		#if(!MyTagsOnly) {
			OR (EXISTS (
				SELECT NULL
				FROM [TagSharedWith] AS [tsw] WITH(NOLOCK)
				INNER JOIN [RoleUsers] AS [rutsw] WITH(NOLOCK)
					ON [rutsw].[ID] = [tsw].[RoleID]
				WHERE [rutsw].[UserID] = #param(CurrentUserID)
					AND [tsw].[ID] = [t].[ID]
				))
			OR (EXISTS (
				SELECT NULL
				FROM [TagEditors] AS [te] WITH(NOLOCK)
				INNER JOIN [RoleUsers] AS [rute] WITH(NOLOCK)
					ON [rute].[ID] = [te].[RoleID]
				WHERE [rute].[UserID] = #param(CurrentUserID)
					AND [te].[ID] = [t].[ID]
				))
			#if(!AddToCardDialogMode) {
			OR (EXISTS (
				SELECT NULL
				FROM [TagReaders] AS [tr] WITH(NOLOCK)
				INNER JOIN [RoleUsers] AS [rutr] WITH(NOLOCK)
					ON [rutr].[ID] = [tr].[RoleID]
				WHERE [rutr].[UserID] = #param(CurrentUserID)
					AND [tr].[ID] = [t].[ID]
				))
			}
		}
	) AS [t]
	WHERE 1 = 1
		#param(ID, [t].[ID])
		#param(Name, [t].[Name])
		#param(Owner, [t].[OwnerID])
		#if(IgnoreCardID) {
			AND (SELECT COUNT([lc].[CardID])
				FROM [TagCards] AS [lc] WITH(NOLOCK)
				WHERE [lc].[TagID] = [t].[ID]
					#param(IgnoreCardID, [lc].[CardID])) <> #eval(IgnoreCardID.CriteriaCount)
		}
) AS [tt]
#if(Normal) {
INNER JOIN [Tags] AS [t] WITH(NOLOCK)
	ON [t].[ID] = [tt].[ID]
#if(PageOffset) {
WHERE [tt].[rn] >= #param(PageOffset) AND [tt].[rn] < (#param(PageOffset) + #param(PageLimit))
}
ORDER BY [tt].[rn]
}

[TEXTPART Tags PGSQL]
SELECT
	#if(Normal) {
		"tt"."ID"			AS "TagID",
		"tt"."Name"			AS "TagName",
		"t"."OwnerID"		AS "TagOwnerID",
		"t"."OwnerName"		AS "TagOwnerName",
		"t"."Background"	AS "TagBackground",
		"t"."IsCommon"		AS "TagIsCommon",
		CASE WHEN (EXISTS (
			SELECT NULL
			FROM "TagEditors" AS "te"
			INNER JOIN "RoleUsers" AS "ru" ON "ru"."ID" = "te"."RoleID"
			WHERE "ru"."UserID" = #param(CurrentUserID) AND "te"."ID" = "t"."ID"))
			OR #param(CurrentUserID) = "t"."OwnerID" THEN true ELSE false END AS "TagCanEdit",
		CASE WHEN (EXISTS (
			SELECT NULL
			FROM "TagSharedWith" AS "tsw"
			INNER JOIN "RoleUsers" AS "ru"  ON "ru"."ID" = "tsw"."RoleID"
			WHERE "ru"."UserID" = #param(CurrentUserID) AND "tsw"."ID" = "t"."ID"))
			OR (EXISTS (
			SELECT NULL
			FROM "TagEditors" AS "te"
			INNER JOIN "RoleUsers" AS "ru"  ON "ru"."ID" = "te"."RoleID"
			WHERE "ru"."UserID" = #param(CurrentUserID) AND "te"."ID" = "t"."ID"))
			OR #param(CurrentUserID) = "t"."OwnerID" THEN true ELSE false END AS "TagCanAddToCard",
		CASE WHEN (EXISTS (
			SELECT NULL
			FROM "TagSharedWith" AS "tsw"
			INNER JOIN "RoleUsers" AS "ru"  ON "ru"."ID" = "tsw"."RoleID"
			WHERE "ru"."UserID" = #param(CurrentUserID) AND "tsw"."ID" = "t"."ID"))
			OR (EXISTS (
			SELECT NULL
			FROM "TagReaders" AS "tr"
			INNER JOIN "RoleUsers" AS "ru"  ON "ru"."ID" = "tr"."RoleID"
			WHERE "ru"."UserID" = #param(CurrentUserID) AND "tr"."ID" = "t"."ID"))
			OR (EXISTS (
			SELECT NULL
			FROM "TagEditors" AS "te"
			INNER JOIN "RoleUsers" AS "ru"  ON "ru"."ID" = "te"."RoleID"
			WHERE "ru"."UserID" = #param(CurrentUserID) AND "te"."ID" = "t"."ID"))
			OR #param(CurrentUserID) = "t"."OwnerID" THEN true ELSE false END AS "TagCanRead"
	}
	#if(Count) {
	"tt".* AS "cnt"
	}
FROM (
	SELECT
		#if(Normal) {
		"t"."ID"
		,"t"."Name"
		#if(Owner) {
			,"t"."OwnerID"
		}
		,row_number() OVER (ORDER BY #order_by) AS "rn"
		}
		#if(Count) {
		count(*)				AS "cnt"
		}
	FROM (
		SELECT
			"t"."ID"
			#if(!Count || Name) {
			,"Localize"("t"."Name", #param(locale)) AS "Name"
			}
			#if(Owner) {
			,"t"."OwnerID"
			}
		FROM "Tags" AS "t"
		WHERE 1 = 1
		AND "t"."OwnerID" = #param(CurrentUserID)
		#if(!MyTagsOnly) {
			OR (EXISTS (
				SELECT NULL
				FROM "TagSharedWith" AS "tsw"
				INNER JOIN "RoleUsers" AS "rutsw"
					ON "rutsw"."ID" = "tsw"."RoleID"
				WHERE "rutsw"."UserID" = #param(CurrentUserID)
					AND "tsw"."ID" = "t"."ID"
				))
			OR (EXISTS (
				SELECT NULL
				FROM "TagEditors" AS "te"
				INNER JOIN "RoleUsers" AS "rute"
					ON "rute"."ID" = "te"."RoleID"
				WHERE "rute"."UserID" = #param(CurrentUserID)
					AND "te"."ID" = "t"."ID"
				))
			#if(!AddToCardDialogMode) {
			OR (EXISTS (
				SELECT NULL
				FROM "TagReaders" AS "tr"
				INNER JOIN "RoleUsers" AS "rutr"
					ON "rutr"."ID" = "tr"."RoleID"
				WHERE "rutr"."UserID" = #param(CurrentUserID)
					AND "tr"."ID" = "t"."ID"
				))
			}
		}
	) AS "t"
	WHERE 1 = 1
		#param(ID, "t"."ID")
		#param(Name, "t"."Name")
		#param(Owner, "t"."OwnerID")
		#if(IgnoreCardID) {
			AND (SELECT COUNT("lc"."CardID")
				FROM "TagCards" AS "lc"
				WHERE "lc"."TagID" = "t"."ID"
					#param(IgnoreCardID, "lc"."CardID")) <> #eval(IgnoreCardID.CriteriaCount)
		}
) AS "tt"
#if(Normal) {
INNER JOIN "Tags" AS "t"
	ON "t"."ID" = "tt"."ID"
#if(PageOffset) {
WHERE "tt"."rn" >= #param(PageOffset) AND "tt"."rn" < (#param(PageOffset) + #param(PageLimit))
}
ORDER BY "tt"."rn"
}