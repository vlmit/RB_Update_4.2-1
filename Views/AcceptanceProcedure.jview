[TEXTPART AcceptanceProcedure MSSQL]


[TEXTPART AcceptanceProcedure PGSQL]
SELECT
	"pt"."ID"		AS "APID",
	"pt"."Name"		AS "APName"
FROM "AcceptanceProcedure" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"