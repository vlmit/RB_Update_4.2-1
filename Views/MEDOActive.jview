[TEXTPART MEDOActive MSSQL]


[TEXTPART MEDOActive PGSQL]
SELECT
	"pt"."ID"		AS "ActiveID",
	"pt"."ActiveStatus"		AS "ActiveActiveStatus"
FROM "MEDOActive" AS "pt"

WHERE true
	#param(Name, "pt"."ActiveStatus")
ORDER BY "pt"."ID"