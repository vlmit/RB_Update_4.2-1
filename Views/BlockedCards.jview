[TEXTPART BlockedCards MSSQL]


[TEXTPART BlockedCards PGSQL]
select
	"ID",
	"TypeCaption",
	"WritePending",
	"Readers",
	"ModifiedByName"
from "Instances"
where
	"Readers">0
	or "WritePending" is true