[TEXTPART test3_OutgoingWithPdfNoProcess MSSQL]


[TEXTPART test3_OutgoingWithPdfNoProcess PGSQL]
SELECT
	"dci"."ID"		AS "ID",
	"dci"."FullNumber" as "FullNumber",
	"dci"."DepartmentName" as "DepartmentName",
	"dci"."RegistratorName" as "RegistratorName",
	(SELECT string_agg("f"."Name",'; ')
		FROM "Files" as "f" 
		WHERE "dci"."ID"="f"."ID" and "f"."Name" like '%.pdf%'
		) as "FileList",
		
	(SELECT string_agg("th"."RoleName", '; ')
		FROM "TaskHistory" AS "th" 
		where "th"."ID" = "dci"."ID" and "th"."TypeID" = '2257bff2-1bdd-4f9a-aacd-dd93de844ea6' 
		) as "RoleList"
		
FROM "DocumentCommonInfo" AS "dci"
WHERE true and "dci"."DocTypeID" = '02bd0e1f-d80b-4223-a552-a50f633f17fe' --тип Исходящий
and exists(select null from "TaskHistory" as "th" where "th"."ID" = "dci"."ID" 
			and "th"."TypeID" = '2257bff2-1bdd-4f9a-aacd-dd93de844ea6') -- рассмотрение
and not exists(select null from "TaskHistory" as "th" where "th"."ID" = "dci"."ID" 
			and ("th"."TypeID" = 'e4d7f6bf-fea9-4a3b-8a5a-e1a0a40de74c' or "th"."TypeID" = '968d68b3-a7c5-4b5d-bfa4-bb0f346880b6')) -- нет согласований и утверждений
and exists(select null from "Files" as "f" where "f"."ID" = "dci"."ID" 
			and "f"."Name" like '%.pdf%')

ORDER BY "dci"."CreationDate" desc