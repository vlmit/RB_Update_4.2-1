[TEXTPART test3_Derigister MSSQL]


[TEXTPART test3_Derigister PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"dci"."FullNumber" as "FullNumber",
	"dci"."Subject" as "Subject",
	MAX("pt"."CompletedByName")		AS "CompletedByName",
	"pt"."OptionCaption"		AS "OptionCaption",
	MAX("pt"."Completed") as "Completed"
FROM "TaskHistory" AS "pt"
Inner join "DocumentCommonInfo" as "dci" on "dci"."ID" = "pt"."ID"
WHERE true
and "pt"."OptionID" = '66e0a7e1-484a-40a6-b123-06118ce3b160' --отменить регистрацию
#if(IsGo) 
{
and exists(select null from "TaskHistory" as "th2" where "th2"."ID" = "dci"."ID" 
			and "th2"."TypeID" = '2257bff2-1bdd-4f9a-aacd-dd93de844ea6') 
} 
#if(IsNotGo) 
{
and not exists(select null from "TaskHistory" as "th2" where "th2"."ID" = "dci"."ID" 
			and "th2"."TypeID" = '2257bff2-1bdd-4f9a-aacd-dd93de844ea6') 
}
#if(IsProj) 
{
and ("dci"."FullNumber" is null or "dci"."FullNumber" = '' or "dci"."FullNumber" like '%пр%' or "dci"."FullNumber" like '%ПР%')
}
and "dci"."Subject" not in ('Тест', 'ntcn', 'test', 'тест', 'ТЕСТ')
and "pt"."CompletedByName" != 'Олюнин В.В.'

GROUP BY "pt"."ID","dci"."FullNumber", "dci"."Subject","pt"."OptionCaption"
ORDER BY "Completed" DESC