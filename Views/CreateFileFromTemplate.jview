[TEXTPART CreateFileFromTemplate MSSQL]
-- Псевдо-запрос, нужен чтобы не падали тесты, т.к. колонки и их типы там берутся из QueryResultMetadataProvider, а не из метаданных представления.
SELECT
	CAST('080e76ae-886e-4660-802a-1f947ad6d9a8' AS uniqueidentifier) 	AS [FileTemplateID],
	'FileTemplateName' 													AS [FileTemplateName],
	'FileTemplateFileExtension' 										AS [FileTemplateFileExtension],
	'FileTemplateFileExtensionText' 									AS [FileTemplateFileExtensionText],
	'FileTemplateFileName' 												AS [FileTemplateFileName],
	'FileTemplateGroupName' 											AS [FileTemplateGroupName],
	CAST(0 AS bit)														AS [ConvertToPdf]

[TEXTPART CreateFileFromTemplate PGSQL]
-- Псевдо-запрос, нужен чтобы не падали тесты, т.к. колонки и их типы там берутся из QueryResultMetadataProvider, а не из метаданных представления.
SELECT
	uuid('080e76ae-886e-4660-802a-1f947ad6d9a8') 						AS "FileTemplateID",
	'FileTemplateName'::text 											AS "FileTemplateName",
	'FileTemplateFileExtension'::text 									AS "FileTemplateFileExtension",
	'FileTemplateFileExtensionText'::text 								AS "FileTemplateFileExtensionText",
	'FileTemplateFileName'::text 										AS "FileTemplateFileName",
	'FileTemplateGroupName'::text 										AS "FileTemplateGroupName",
	CAST(0 AS bool)														AS "ConvertToPdf"