[TEXTPART MyPersonalPartnersLists MSSQL]


[TEXTPART MyPersonalPartnersLists PGSQL]
select
#if(Normal) { 
	"ID" as "PPL_ID",
	"Title" as "PPL_Title",
	CASE 
    WHEN "Status" = false 
    	THEN 'Активен'
    	ELSE 'Не активен'
    END as "PPL_Status",
    "OwnerID"
	}
#if(Count) { 
	count(*) as cnt
	}
from
	"PersonalPartnerList" as "ppl"
where
	true
	#param(Title, "Title")
	#param(Status, "Status")
	and "ppl"."OwnerID"=#param(CurrentUserID)
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit);
}