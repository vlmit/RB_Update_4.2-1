[TEXTPART CreateBasedCardList MSSQL]


[TEXTPART CreateBasedCardList PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "CreateBasedCardList" AS "pt"

WHERE true and ("pt"."ID" = 0 or "pt"."ID" = 1)
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
