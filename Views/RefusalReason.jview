{
  "Alias": "RefusalReason",
  "Caption": "Причины отказа",
  "GroupName": "Custom",
  "ID": "62f9564d-8d18-4dbf-a728-5c0206acac69",
  "JsonMetadataSource::txt": "RefusalReason JSONMETA",
  "MsQuerySource::txt": "RefusalReason MSSQL",
  "PgQuerySource::txt": "RefusalReason PGSQL"
}

[TEXTPART RefusalReason JSONMETA]
{
  "Alias": "RefusalReason",
  "Caption": "Причины отказа",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "Guid Null"
    },
    {
      "Alias": "TypeName",
      "Caption": "Причина отказа в регистрации",
      "Type": "$RefusalReason.Name"
    },
    {
      "Alias": "TypeNotes",
      "Caption": "Пояснение по применению",
      "Type": "$RefusalReason.Notes"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$RefusalReason.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "RefusalReasons"
      ]
    }
  ]
}

[TEXTPART RefusalReason MSSQL]


[TEXTPART RefusalReason PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName",
	"pt"."Notes"	AS "TypeNotes"
FROM "RefusalReason" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."Name"
