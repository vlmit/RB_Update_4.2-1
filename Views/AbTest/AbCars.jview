[TEXTPART AbCars MSSQL]
SELECT
	[t].[ID]			AS [CarID],
	[t].[Name]			AS [CarName],
	[t].[MaxSpeed]		AS [CarMaxSpeed],
	[t].[DriverID],
	[t].[DriverName],
	[t].[ReleaseDate]	AS [CarReleaseDate]
FROM [AbCarMainInfo] AS [t] WITH (NOLOCK)
WHERE
	1 = 1
	#param(CarId, [t].[ID])
	#param(CarName, [t].[Name])
	#param(CarMaxSpeed, [t].[MaxSpeed])
	#param(Driver, [t].[DriverID])
	#param(CarReleaseDateFrom, [t].[ReleaseDate])
	#param(CarReleaseDateTo, [t].[ReleaseDate])
	#param(Mileage, [t].[Running])
	#param(Price, [t].[Cost])
ORDER BY #order_by

[TEXTPART AbCars PGSQL]
SELECT
	"t"."ID"			AS "CarID",
	"t"."Name"			AS "CarName",
	"t"."MaxSpeed"		AS "CarMaxSpeed",
	"t"."DriverID",
	"t"."DriverName",
	"t"."ReleaseDate"	AS "CarReleaseDate"
FROM "AbCarMainInfo" AS "t"
WHERE
	true
	#param(CarId, "t"."ID")
	#param(CarName, "t"."Name")
	#param(CarMaxSpeed, "t"."MaxSpeed")
	#param(Driver, "t"."DriverID")
	#param(CarReleaseDateFrom, "t"."ReleaseDate")
	#param(CarReleaseDateTo, "t"."ReleaseDate")
	#param(Mileage, "t"."Running")
	#param(Price, "t"."Cost")
ORDER BY #order_by	