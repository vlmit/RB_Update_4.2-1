[TEXTPART GipFileSignatures MSSQL]
SELECT 
 [t].[ID]				AS [FsID]
,[t].[RowID] 			AS [FsRowID]
,[t].[SubjectName] 	AS [FsUserName]
,[t].[Signed] 		AS [FsSigned]
,[t].[SerialNumber] 	AS [FsSerialNumber]
,[t].[CardID] 		AS [FsCardID]
,[t].[Name] 			AS [FsFileName]
FROM (SELECT 
 fs.[ID]
,fs.[RowID]
,fs.[UserID]
,fs.[SubjectName] 		
,fs.[Signed]
,fs.[SerialNumber]
,f.[ID]				AS [CardID]
,f.[Name]
FROM [FileSignatures] AS [fs]
left join [Files] as f on f.[RowID]= fs.[ID]

where
f.[Name] Like (
select ls.[Value] 
	from [LocalizationStrings] as ls
	left join [LocalizationEntries] as le on ls.[EntryID] = le.[ID]
where le.[Name] = 'GipPrefixDocName'
) + '%'
#param(CardId, f.[ID])
) AS t

[TEXTPART GipFileSignatures PGSQL]
SELECT 
 t."ID"				AS "FsID"
,t."RowID" 			AS "FsRowID"
,t."SubjectName" 	AS "FsUserName"
,t."Signed" 		AS "FsSigned"
,t."SerialNumber" 	AS "FsSerialNumber"
,t."CardID" 		AS "FsCardID"
,t."Name" 			AS "FsFileName"
FROM (SELECT 
 fs."ID"
,fs."RowID"
,fs."UserID"
,fs."SubjectName" 		
,fs."Signed"
,fs."SerialNumber"
,f."ID"				AS "CardID"
,f."Name"
FROM "FileSignatures" AS "fs"
left join "Files" as f on f."RowID"= fs."ID"

where
f."CategoryCaption" = 'Документ'
and fs."UserID" not in ('626e04ba-5bfd-4368-9e3b-a1fbf4c56bcd','2db5c830-b8e5-491a-80b6-146fa218928a',
						'f4aae863-79f8-4fd4-877d-c37796643aad', '6498a1c1-d4c3-4561-a88f-abb9cf718308','95b3705a-ebd3-4427-95b1-d03297c6ab5e')
--and fs."UserID" != '95b3705a-ebd3-4427-95b1-d03297c6ab5e'
--and fs."SerialNumber" != '009F1A7F0BB9D83EF20D98FD7C10F38F29'
-- исключили из списка Башаеву Н.Ю., Гостяеву Е.С,, Таволгину С.Н., Билык И.Н., Цыбикова Ю.С.//
#param(CardId, f."ID")
) AS t
--where t."SerialNumber" != '009F1A7F0BB9D83EF20D98FD7C10F38F29'
Order by t."Signed" desc
LIMIT 1
--WHERE (1=1 #param(FileID, t."ID"))