[TEXTPART MEDOFormat MSSQL]


[TEXTPART MEDOFormat PGSQL]
SELECT
	"pt"."ID"		AS "FormatID",
	"pt"."Format"		AS "FormatFormat"
FROM "MEDOFormat" AS "pt"

WHERE true
	#param(Name, "pt"."Format")
ORDER BY "pt"."ID"