[TEXTPART test2 MSSQL]


[TEXTPART test2 PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"pt"."Name"		AS "DeputyName",
	"pt"."EDSCertificateInfo"		AS "DeputizedName"
FROM "PersonalRoles" AS "pt"

WHERE true --and "pt"."AccessLevelID" = 1
and "pt"."EDSCertificateInfo" is not null
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"