[TEXTPART test2 JSONMETA]
{
  "Alias": "test2",
  "Caption": "Ставка ДНС",
  "Columns": [
    {
      "Alias": "NdsID",
      "Hidden": true,
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "DeputyName",
      "Caption": "DeputyName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "DeputizedName",
      "Caption": "DeputizedName",
      "Type": "$NDSRate.Rate"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "NdsID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "QuickSearchParam": "Rate"
}

[TEXTPART test2 MSSQL]


[TEXTPART test2 PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"pt"."Name"		AS "DeputyName",
	"pt"."EDSCertificateInfo"		AS "DeputizedName"
FROM "PersonalRoles" AS "pt"

WHERE true --and "pt"."AccessLevelID" = 1
and "pt"."EDSCertificateInfo" is not null
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
