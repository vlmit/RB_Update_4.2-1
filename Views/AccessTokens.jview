[TEXTPART AccessTokens MSSQL]
#if(Administrator && (ID || Scope || Description || Created || Expires || CreatedByID || RefID || UserID || Hash)) {
SELECT
  [tk].[MaskedID] AS [ID],
  [t].[Description],
  [t].[Scope],
  [t].[Created],
  [t].[Expires],
  [tk].[CreatedByName],
  [t].[RefID],
  [tk].[UserName],
  [tk].[Hash]
FROM (
  SELECT 
    [tk].[ID],
    CONCAT(SUBSTRING([tk].[ID],1,3), '...', SUBSTRING([tk].[ID],LEN([tk].[ID])-2,3)) AS [MaskedID],
    CONVERT([VARCHAR](MAX), [tk].[TokenHash], 2) AS [Hash],
    [pr].[FullName] AS [CreatedByName],
    [pr2].[FullName] AS [UserName],
    row_number() OVER (ORDER BY #order_by) AS [rn]
  FROM [Tokens] AS [tk] WITH (NOLOCK)
  LEFT JOIN [PersonalRoles] AS [pr] WITH (NOLOCK)
    ON [pr].[ID] = [tk].[CreatedByID]
  LEFT JOIN [PersonalRoles] AS [pr2] WITH (NOLOCK)
    ON [pr2].[ID] = [tk].[UserID]
  WHERE 1=1
    #param(ID, CONCAT(SUBSTRING([tk].[ID],1,3), '...', SUBSTRING([tk].[ID],LEN([tk].[ID])-2,3)))
    #param(Scope, [tk].[Scope])
    #param(Description, [tk].[Description])
    #param(Created, [tk].[Created])
    #param(Expires, [tk].[Expires])
    #param(CreatedByID, [tk].[CreatedByID])
    #param(RefID, [tk].[RefID])
    #param(UserID, [tk].[UserID])
    #param(Hash, CONVERT([VARCHAR](MAX), [tk].[TokenHash], 2))
) AS [tk]
INNER JOIN [Tokens] AS [t] WITH (NOLOCK)
  ON [t].[ID] = [tk].[ID]
#if(PageOffset) {
WHERE [tk].[rn] >= #param(PageOffset) AND [tk].[rn] < (#param(PageOffset) + #param(PageLimit))
}
ORDER BY [tk].[rn]
} {
-- no parameters given
SELECT
  '' AS [ID],
  '' AS [Description],
  '' AS [Scope],
  SYSDATETIME() AS [Created],
  SYSDATETIME() AS [Expires],
  '' AS [CreatedByName],
  CAST(NULL AS UNIQUEIDENTIFIER) AS [RefID],
  '' AS [UserName],
  '' AS [Hash]
WHERE 1=0
}

[TEXTPART AccessTokens PGSQL]
#if(Administrator && (ID || Scope || Description || Created || Expires || CreatedByID || RefID || UserID || Hash)) {
SELECT 
  (substring("tk"."ID" from 1 for 3) || '...' || substring("tk"."ID" from length("tk"."ID")-2 for 3)) AS "ID",
  "tk"."Description",
  "tk"."Scope",
  "tk"."Created",
  "tk"."Expires",
  "pr"."FullName" AS "CreatedByName",
  "tk"."RefID",
  "pr2"."FullName" AS "UserName",
  encode("tk"."TokenHash", 'hex') AS "Hash"
FROM "Tokens" AS "tk"
LEFT JOIN "PersonalRoles" AS "pr"
  ON "pr"."ID" = "tk"."CreatedByID"
LEFT JOIN "PersonalRoles" AS "pr2"
  ON "pr2"."ID" = "tk"."UserID"
WHERE 1=1
  #param(ID, (substring("tk"."ID" from 1 for 3) || '...' || substring("tk"."ID" from length("tk"."ID")-2 for 3)))
  #param(Scope, lower("tk"."Scope"))
  #param(Description, lower("tk"."Description"))
  #param(Created, "tk"."Created")
  #param(Expires, "tk"."Expires")
  #param(CreatedByID, "tk"."CreatedByID")
  #param(RefID, "tk"."RefID")
  #param(UserID, "tk"."UserID")
  #param(Hash, encode("tk"."TokenHash", 'hex') )
ORDER BY #order_by
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
}
} {
-- no parameters given
SELECT
  '' AS "ID",
  '' AS "Description",
  '' AS "Scope",
  now() AS "Created",
  now() AS "Expires",
  '' AS "CreatedByName",
  NULL::uuid AS "RefID",
  '' AS "UserName",
  '' AS "Hash"
WHERE 1=0
}