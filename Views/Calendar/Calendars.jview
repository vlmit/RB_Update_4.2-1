[TEXTPART Calendars MSSQL]
SELECT
#if(Normal) {
	[t].[ID] 			as CalendarID,
	[t].[CalendarID]	as CalendarCalendarID,
	[t].[Name] 			as CalendarName,
	[t].[CalendarTypeID],
	[t].[CalendarTypeCaption],
	[t].[Description]
	}	
#if(Count) {
		[t].[cnt]
	}
FROM (
	SELECT
	#if(Normal) {
		[cs].[ID],
		[cs].[CalendarID],
		[cs].[Name],
		[cs].[Description],
		[cs].[CalendarTypeID],
		[cs].[CalendarTypeCaption],
		row_number() OVER (ORDER BY #order_by) AS [rn]
		}	
	#if(Count) {
			count(*) AS [cnt]
		}
	FROM [CalendarSettings] as [cs] with(nolock)
	WHERE (1 = 1)
	#param(Name, cs.Name)) as [t]

#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}


[TEXTPART Calendars PGSQL]
SELECT
#if(Normal) {
	"t"."ID" 			as CalendarID,
	"t"."CalendarID"	as CalendarCalendarID,
	"t"."Name" 			as CalendarName,
	"t"."CalendarTypeID",
	"t"."CalendarTypeCaption",
	"t"."Description"
	}	
#if(Count) {
		"t"."cnt"
	}
FROM (
	SELECT
	#if(Normal) {
		"cs"."ID",
		"cs"."CalendarID",
		"cs"."Name",
		"cs"."Description",
		"cs"."CalendarTypeID",
		"cs"."CalendarTypeCaption"
	}
	#if(Count) {
		count(*) AS "cnt"
	}
	from "CalendarSettings" AS cs 
	where (1=1)
	#param(Name, "cs"."Name")
	#if(Normal) {
		ORDER BY #order_by
	}
	
	) as t

#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
}