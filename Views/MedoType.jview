}

[TEXTPART MedoType JSONMETA]
{
  "Alias": "MedoType",
  "Caption": "Типы в МЭДО",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "Int32 Null"
    },
    {
      "Alias": "TypeName",
      "Caption": "Наименование",
      "Type": "$Partners.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$PartnersTypes.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "RefSection": [
        "MedoTypes"
      ]
    }
  ]
}

[TEXTPART MedoType MSSQL]


[TEXTPART MedoType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "MedoType" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
