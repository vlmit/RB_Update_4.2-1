[TEXTPART test3_{d6204354-6c87-4883-ad37-6cc2ab56e24b}(copy) PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"pt"."Name" 		as "Name",
	"pt"."CreatedByName"		AS "CreatedByName",
	"pt"."Created"		AS "Created"
	
FROM "Files" AS "pt"
Where --"pt"."CreatedByID" = '4f554fdf-f9d7-485c-a037-54b464354692'
"pt"."Name" = 'image27220.pdf'

ORDER BY "pt"."Created" desc
