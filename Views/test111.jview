[TEXTPART test111 MSSQL]


[TEXTPART test111 PGSQL]
select "dci"."ID" as "DocID",
"dci"."FullNumber" as "DocFullNumber",
"dci"."CreationDate",
"dci"."ParentDescription"

from "DocumentCommonInfo" as "dci"
where "dci"."CardTypeID" = '01ad498e-5f8e-417a-bd28-942739dbf342'
and "dci"."CategoryID" = '30f938ba-3db0-42e7-8dba-0f0d492e5726'
and "dci"."RegistratorID" = '1d701dbe-717e-4a7d-878c-084e2e9f8a14' -- мельников создатель
--and "dci"."AuthorID" = 'f641cbb0-996a-4c34-aadb-2e3d3f733146'
order by "dci"."CreationDate" desc