{
  "Alias": "ControlTask_History_(copy)",
  "Caption": "История изменений",
  "GroupName": "Custom",
  "ID": "7960f1e9-1b2e-473c-9a19-cd0cd2053d0b",
  "JsonMetadataSource::txt": "ControlTask_History_(copy) JSONMETA",
  "MsQuerySource::txt": "ControlTask_History_(copy) MSSQL",
  "PgQuerySource::txt": "ControlTask_History_(copy) PGSQL"
}

[TEXTPART ControlTask_History_(copy) JSONMETA]
{
  "Alias": "ControlTask_History_(copy)",
  "Caption": "История изменений",
  "Columns": [
    {
      "Alias": "Modified",
      "Caption": "Дата",
      "Type": "$ActionHistory.Modified"
    },
    {
      "Alias": "Request",
      "Caption": "Поручение",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Request2",
      "Caption": "Содержание поручения",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Reguest3",
      "Caption": "Плановая дата",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Performer1",
      "Caption": "Исполнитель 1",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Performer2",
      "Caption": "Исполнитель 2",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "Performer3",
      "Caption": "Исполнитель 3",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "ModifiedByName",
      "Caption": "Сотрудник",
      "Type": "$ActionHistory.ModifiedByName"
    },
    {
      "Alias": "Request3",
      "Type": "$ActionHistory.Request"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "CardID",
      "Caption": "Card ID",
      "Multiple": false,
      "Type": "$DocumentCommonInfo.ID"
    }
  ]
}

[TEXTPART ControlTask_History_(copy) MSSQL]


[TEXTPART ControlTask_History_(copy) PGSQL]
select
	"Modified",
	
	"Request"::json#>>'{Card,Sections,DocumentCommonInfo,Fields,CommissionTemplateText}' as "Request",
	"Request"::json#>>'{Card,Sections,DocumentCommonInfo,Fields,ExpandTextTask}' as "Request2",
	"Request"::json#>>'{Card,Sections,DocumentCommonInfo,Fields,TaskDeadline::dtm}' as "Request3",
	--"Request"::json#>>'{Card,Sections,ControlTaskPerformers,Rows,0,UserName}'  as "Performer1",
	(select string_agg(value->>'UserName', ', ') 
		from (select json_array_elements("Request"::json#>'{Card,Sections,ControlTaskPerformers,Rows}') as value) as s) as "Performer2",
	(select string_agg("UserName",',')
		from json_to_recordset("Request"::json#>'{Card,Sections,ControlTaskPerformers,Rows}') 
		as s ("UserName" text, "RowID::uid" text,".state::int" int, "UserID::uid" text, "ParentRowID::uid" text)  
		where ".state::int"=2)
	as "Performer1",
	(select string_agg("RowID::uid",',')
		from json_to_recordset("Request"::json#>'{Card,Sections,ControlTaskPerformers,Rows}') 
		as s ("RowID::uid" text,".state::int" int)  
		where ".state::int"=3)::text as "Performer3",
	"ModifiedByName",
	"Request" as "Request3"
from
	"ActionHistory" as "ah"
	left join "ActionTypes" as "at"
		on "ah"."ActionID"="at"."ID"
where
	true
	and "ah"."ID"='aacda7a3-c3a3-40ef-adcf-8cb09e0bf901' -- КП-184441
	--and "ah"."ID"='28c07d76-bb62-45d6-bbc1-729d12473133'  --КП-452878
	--"ah"."ID"='8c60c01f-9bd4-4a10-b449-8f2eecc9c015'
	--"ah"."ID"='89b6a01f-85dd-42b0-b04f-c12cb5257c8e'
	and ("ActionID"=1 or "ActionID"=3)
	#param(CardID, "ah"."ID")
order by "Modified" desc
