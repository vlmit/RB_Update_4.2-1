[TEXTPART TaskHistorySearch PGSQL]
select
	"t"."ID",
	"ParentRowID",
	"RowID",
	"t"."TypeCaption",
	"OptionCaption",
	"Created",
	"t"."AuthorName",
	"RoleName",
	"UserName"
from "TaskHistory" as "t"
where 
	"ID"='a936fd25-5a48-4b86-93ea-f1982c7f118b'
	--"ParentID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
	--"RowID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
