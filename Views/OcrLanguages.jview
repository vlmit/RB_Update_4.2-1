[TEXTPART OcrLanguages JSONMETA]
{
  "Alias": "OcrLanguages",
  "Caption": "$Views_Names_OcrLanguages",
  "Columns": [
    {
      "Alias": "LanguageID",
      "Hidden": true,
      "SortBy": "ID",
      "Type": "$OcrLanguages.ID"
    },
    {
      "Alias": "LanguageCaption",
      "Caption": "$Views_OcrLanguages_Caption",
      "DisableGrouping": true,
      "FilterParameter": "Caption",
      "FilterType": "Parameter",
      "Localizable": true,
      "SortBy": "Caption",
      "Type": "$OcrLanguages.Caption"
    },
    {
      "Alias": "LanguageISO",
      "Caption": "$Views_OcrLanguages_ISO",
      "DisableGrouping": true,
      "FilterParameter": "ISO",
      "FilterType": "Parameter",
      "SortBy": "ISO",
      "Type": "$OcrLanguages.ISO"
    },
    {
      "Alias": "LanguageCode",
      "Caption": "$Views_OcrLanguages_Code",
      "FilterParameter": "Code",
      "FilterType": "Parameter",
      "Hidden": true,
      "SortBy": "Code",
      "Type": "$OcrLanguages.Code"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "LanguageCaption",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "MultiSelect": true,
  "Parameters": [
    {
      "Alias": "ISO",
      "Caption": "$Views_OcrLanguages_ISO_Param",
      "Multiple": false,
      "Type": "$OcrLanguages.ISO"
    },
    {
      "Alias": "Code",
      "Caption": "$Views_OcrLanguages_Code_Param",
      "Hidden": true,
      "Multiple": false,
      "Type": "$OcrLanguages.Code"
    },
    {
      "Alias": "Caption",
      "Caption": "$Views_OcrLanguages_Caption_Param",
      "Multiple": false,
      "Type": "$OcrLanguages.Caption"
    }
  ],
  "QuickSearchParam": "Caption",
  "References": [
    {
      "ColPrefix": "Language",
      "DisplayValueColumn": "LanguageCaption",
      "RefSection": [
        "OcrLanguages"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count"
    }
  ],
  "TreatAsSingleQuery": true
}

[TEXTPART OcrLanguages MSSQL]
SELECT
#if(Normal) {
	[ID]				AS [LanguageID],
	[Caption]			AS [LanguageCaption],
	[ISO]				AS [LanguageISO],
	[Code]				AS [LanguageCode]
}
#if(Count) {
	COUNT(*) 			AS [Count]
}
FROM [OcrLanguages] WITH (NOLOCK)
WHERE [ID] >= 0
	#param(ISO, [ISO])
	#param(Code, [Code])
	#param(Caption, [Caption])
#if(Normal) {
ORDER BY #order_by
}

[TEXTPART OcrLanguages PGSQL]
SELECT
#if(Normal) {
	"ID"				AS "LanguageID",
	"Caption"			AS "LanguageCaption",
	"ISO"				AS "LanguageISO",
	"Code"				AS "LanguageCode"
}
#if(Count) {
	COUNT(*) 			AS "Count"
}
FROM "OcrLanguages"
WHERE "ID" >= 0
	#param(ISO, "ISO")
	#param(Code, "Code")
	#param(Caption, "Caption")
#if(Normal) {
ORDER BY #order_by
}