[TEXTPART Partners_PersonalList MSSQL]
SELECT
	#if(Normal) {
	[t].[ID]			AS [PartnerID],
	[tt].[Name]			AS [PartnerName],
	[tt].[FullName],
	[tt].[TypeID],
	[tt].[TypeName],
	[tt].[INN],
	[tt].[KPP],
	[tt].[OGRN],
	[tt].[Comment]
	}
	#if(Count) {
	[t].*
	}
FROM (
	SELECT
		#if(Normal) {
		[t].[ID],
		row_number() OVER (ORDER BY #order_by) AS [rn]
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM [Partners] AS [t] WITH (NOLOCK)
	WHERE 1 = 1
		#param(PartnerID, [t].[ID])
		#param(Name, [t].[Name])
		#param(FullName, [t].[FullName])
		#param(Type, [t].[TypeID])
		#param(INN, [t].[INN])
		#param(KPP, [t].[KPP])
		#param(OGRN, [t].[OGRN])
		#param(Comment, [t].[Comment])
	) AS [t]
#if(Normal) {
INNER JOIN [Partners] AS [tt] WITH (NOLOCK)
	ON [tt].[ID] = [t].[ID]
}
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}

[TEXTPART Partners_PersonalList PGSQL]
SELECT 
	#if(Normal) {
	"t"."ID"			AS "PartnerID",
	"t"."Name"			AS "PartnerName",
	"t"."MedoID"		AS "PartnerMedoID",
	"t"."MedoAddress"   AS "PartnerMedoAddress",
	"t"."FullName",
	"t"."TypeID",
	"t"."TypeName",
	"t"."INN",
	"t"."KPP",
	"t"."OGRN",
	"t"."Comment",
	"pple"."SortN"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
	#if(ByList) { 
		"ppl"."ID" as "ListID",
		"ppl"."Title" as "ListTitle"
	} 
FROM "Partners" AS "t", "PersonalPartnerListEntry" as "pple", "PersonalPartnerList" as "ppl"
WHERE true
	and "t"."ID"="pple"."PartnerID"
	and "ppl"."ID"="pple"."ID"
	and "ppl"."OwnerID"=#param(CurrentUserID)
	#if(!ListID) { and "ppl"."Status"=false }
	#param(ListID, "ppl"."ID")
#if(MedoAddress) {
and
	"t"."MedoAddress" is not null
	}
#if(CardID) {
and exists(
	select null from "Correspondents" as "co"
	inner join "Tasks" as "tsk" on "tsk"."ID" = "co"."ID"
	where "t"."ID"="co"."PartnersID"
	#param(CardID, "tsk"."RowID")
	)
	}
and "t"."ID" in (SELECT distinct on ("t2"."Name") "t2"."ID"  FROM "Partners" as "t2" Order BY "t2"."Name", "t2"."ID")
	#param(PartnerID, "t"."ID")
	#param(Name, "t"."Name")
	#param(FullName, "t"."FullName")
	#param(Type, "t"."TypeID")
	#param(INN, "t"."INN")
	#param(KPP, "t"."KPP")
	#param(OGRN, "t"."OGRN")
	#param(Comment, "t"."Comment")
#if(Normal) {
ORDER BY "pple"."SortN" desc nulls last, #order_by
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}