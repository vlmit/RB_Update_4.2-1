      "Caption": "$Views_SmartRoleMembers_Name_Param",
      "Type": "$Roles.Name"
    },
    {
      "Alias": "SmartRole",
      "AutoCompleteInfo": {
        "ParamAlias": "Name",
        "ViewAlias": "SmartRoles"
      },
      "Caption": "$Views_SmartRoleMembers_SmartRole_Param",
      "Hidden": true,
      "IgnoreCase": false,
      "Multiple": false,
      "RefSection": [
        "SmartRoles"
      ],
