[TEXTPART SmartRoleMembers JSONMETA]
{
  "Alias": "SmartRoleMembers",
  "Caption": "$Views_Names_SmartRoleMembers",
  "Columns": [
    {
      "Alias": "SmartRoleMemberID",
      "Hidden": true,
      "Type": "$SmartRoleMembers.RoleID"
    },
    {
      "Alias": "SmartRoleMemberName",
      "Caption": "$Views_SmartRoleMembers_Name",
      "FilterParameter": "Name",
      "FilterType": "Parameter",
      "Localizable": true,
      "SortBy": "r.Name",
      "Type": "$Roles.Name"
    },
    {
      "Alias": "SmartRoleMemberTypeName",
      "Caption": "$Views_SmartRoleMembers_Type",
      "Localizable": true,
      "Type": "$RoleTypes.Name"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "SmartRoleMemberName",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "MultiSelect": true,
  "Paging": "Always",
  "Parameters": [
    {
