  "Subsets": [
    {
      "Alias": "Count"
    }
  ],
  "TreatAsSingleQuery": true
}

[TEXTPART SmartRoleMembers MSSQL]
SELECT
	#if(Normal) {
	[t].[SmartRoleMemberID],
	[t].[SmartRoleMemberName],
	[rt].[Name] 					AS [SmartRoleMemberTypeName]
	}
	#if(Count) {
	[t].*
	}
FROM (
	SELECT
		#if(Normal) {
		[t].[RoleID]							AS [SmartRoleMemberID],
		[r].[Name]								AS [SmartRoleMemberName],
		[r].[TypeID],
		row_number() OVER (ORDER BY #order_by)	AS [rn]
		}
		#if(Count) {
		count(*)								AS [cnt]
		}
	FROM [SmartRoleMembers] AS [t] WITH (NOLOCK)
	INNER JOIN [Roles] AS [r] WITH (NOLOCK)
		ON [t].[RoleID] = [r].[ID]

	WHERE 1 = 1
		#param(Name, [r].[Name])
		#param(SmartRole, [t].[ID])
	) AS [t]
#if(Normal) {
INNER JOIN [RoleTypes] AS [rt] WITH(NOLOCK)
	ON [rt].[ID] = [t].[TypeID]
}
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}

[TEXTPART SmartRoleMembers PGSQL]
SELECT
	#if(Normal) {
	"t"."SmartRoleMemberID",
	"t"."SmartRoleMemberName",
	"rt"."Name" 					AS "SmartRoleMemberTypeName"
	}
	#if(Count) {
	"t".*
	}
FROM (
	SELECT
		#if(Normal) {
		"t"."RoleID"							AS "SmartRoleMemberID",
		"r"."Name"								AS "SmartRoleMemberName",
		"r"."TypeID",
		row_number() OVER (ORDER BY #order_by)	AS "rn"
		}
		#if(Count) {
		count(*)								AS "cnt"
		}
	FROM "SmartRoleMembers" AS "t"
	INNER JOIN "Roles" AS "r"
		ON "t"."RoleID" = "r"."ID"

	WHERE true
		#param(Name, "r"."Name")
		#param(SmartRole, "t"."ID")
		
	#if(Normal) {
	ORDER BY #order_by
	}
	#if(PageOffset) {
	OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
	}
	) AS "t"
#if(Normal) {
INNER JOIN "RoleTypes" AS "rt"
	ON "rt"."ID" = "t"."TypeID"
}
#if(Normal) {
ORDER BY "t"."rn"
}