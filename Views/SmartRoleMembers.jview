    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "SmartRoleMember",
      "DisplayValueColumn": "SmartRoleMemberName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
