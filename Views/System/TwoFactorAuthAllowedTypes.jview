[TEXTPART TwoFactorAuthAllowedTypes MSSQL]
SELECT
	[t].[TypeID]	AS [TypeID],
	[t].[TypeName]	AS [TypeName]
FROM [TwoFactorAuthAllowedTypes] AS [t] WITH (NOLOCK)
#if(Name || request.SortedBy("TypeName")) {
CROSS APPLY [Localization]([t].[TypeName], #param(locale)) AS [lName]
}
WHERE 1 = 1
	#param(Name, [lName].[Value])
ORDER BY #order_by


[TEXTPART TwoFactorAuthAllowedTypes PGSQL]
SELECT
	"t"."TypeID"	AS "TypeID",
	"t"."TypeName"	AS "TypeName"
FROM "TwoFactorAuthAllowedTypes" AS "t"
#if(Name || request.SortedBy("TypeName")) {
CROSS JOIN "Localization"("t"."TypeName", #param(locale)) AS "lName"
}
WHERE true
	#param(Name, "lName"."Value")
ORDER BY #order_by