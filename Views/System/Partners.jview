[TEXTPART Partners MSSQL]
SELECT
	#if(Normal) {
	[t].[ID]			AS [PartnerID],
	[tt].[Name]			AS [PartnerName],
	[tt].[FullName],
	[tt].[TypeID],
	[tt].[TypeName],
	[tt].[INN],
	[tt].[KPP],
	[tt].[OGRN],
	[tt].[Comment]
	}
	#if(Count) {
	[t].*
	}
FROM (
	SELECT
		#if(Normal) {
		[t].[ID],
		row_number() OVER (ORDER BY #order_by) AS [rn]
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM [Partners] AS [t] WITH (NOLOCK)
	WHERE 1 = 1
		#param(PartnerID, [t].[ID])
		#param(Name, [t].[Name])
		#param(FullName, [t].[FullName])
		#param(Type, [t].[TypeID])
		#param(INN, [t].[INN])
		#param(KPP, [t].[KPP])
		#param(OGRN, [t].[OGRN])
		#param(Comment, [t].[Comment])
	) AS [t]
#if(Normal) {
INNER JOIN [Partners] AS [tt] WITH (NOLOCK)
	ON [tt].[ID] = [t].[ID]
}
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}


[TEXTPART Partners PGSQL]
SELECT
	#if(Normal) {
	"t"."ID"			AS "PartnerID",
	"t"."Name"			AS "PartnerName",
	"t"."FullName",
	"t"."TypeID",
	"t"."TypeName",
	"t"."INN",
	"t"."KPP",
	"t"."OGRN",
	"t"."Comment"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
FROM "Partners" AS "t"
WHERE true
	#param(PartnerID, "t"."ID")
	#param(Name, "t"."Name")
	#param(FullName, "t"."FullName")
	#param(Type, "t"."TypeID")
	#param(INN, "t"."INN")
	#param(KPP, "t"."KPP")
	#param(OGRN, "t"."OGRN")
	#param(Comment, "t"."Comment")
#if(Normal) {
ORDER BY #order_by
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
}