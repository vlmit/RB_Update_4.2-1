[TEXTPART ReportPermissionsMyTasks JSONMETA]
{
  "Alias": "ReportPermissionsMyTasks",
  "AutoSelectFirstRow": false,
  "Caption": "$Views_Names_ReportPermissionsMyTasks",
  "Columns": [
    {
      "Alias": "HasPermission",
      "Caption": "HasPermission",
      "Type": "Boolean Not Null"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "User",
      "AllowedOperands": [
        "Equality"
      ],
