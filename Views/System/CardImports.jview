[TEXTPART CardImports MSSQL]
SELECT *
FROM
(
	SELECT 
	#if(Normal)
		{
			[ci].[CardID],
			[ci].[Created],
			[ci].[CreatedByID],
			[ci].[StateID],
			CASE 
				WHEN [ci].[StateID] = 1 THEN '$Enum_CardImportStates_Import'
				WHEN [ci].[StateID] = 2 THEN '$Enum_CardImportStates_Cancelled'
				WHEN [ci].[StateID] = 3 THEN '$Enum_CardImportStates_FinishedWithErrors'
				WHEN [ci].[StateID] = 4 THEN '$Enum_CardImportStates_Finished' 
				ELSE '$Enum_CardImportStates_Created'
				END AS [StateName],
			[ci].[TotalCount],
			[ci].[ImportedCount],
			[ci].[WarningCount],
			[ci].[SkippedCount],
			[ci].[ErrorCount],
			ROW_NUMBER() OVER (ORDER BY #order_by) as [rn]
		}
		{
			COUNT(*) as [Count]
		}
	FROM
	(
		SELECT
			[ci].[ID] as [CardID],
			[i].[Created],
			[i].[CreatedByID],
			[ci].[StateID],
			[ci].[TotalCount],
			[ci].[ImportedCount],
			[ci].[WarningCount],
			[ci].[SkippedCount],
			[ci].[ErrorCount]
		FROM [CardImports] as [ci] WITH(NOLOCK)
		INNER JOIN [Instances] as [i] WITH(NOLOCK)
		ON [ci].[ID] = [i].[ID]
		WHERE 1 = 1
		#param(Created, [i].[Created])
		#param(CreatedBy, [i].[CreatedByID])
		#param(State, [ci].[StateID])
		#if(HasErrors) 
		{
			#if(HasErrors.CriteriaName == "IsTrue") 
			{ 
		AND [ci].[ErrorCount] > 0
			} 
			{
		AND [ci].[ErrorCount] = 0
			}
		}
		#if(HasWarnings) 
		{
			#if(HasWarnings.CriteriaName == "IsTrue") 
			{ 
		AND [ci].[WarningCount] > 0
			} 
			{
		AND [ci].[WarningCount] = 0
			}
		}
	) as [ci]
) as [ci]
#if(PageOffset)
{
WHERE [ci].[rn] >= #param(PageOffset) AND [ci].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal)
{
ORDER BY [ci].[rn]
}


[TEXTPART CardImports PGSQL]
SELECT
	#if(Normal)
	{
		"ci"."CardID",
		"ci"."Created",
		"ci"."CreatedByID",
		"ci"."StateID",
		"ci"."StateName",
		"ci"."TotalCount",
		"ci"."ImportedCount",
		"ci"."WarningCount",
		"ci"."SkippedCount",
		"ci"."ErrorCount"
	}
	{
		*
	}
FROM
(
	SELECT
	#if(Normal)
	{
		"ci"."ID" as "CardID",
		"i"."Created",
		"i"."CreatedByID",
		"ci"."StateID",
		CASE 
			WHEN "ci"."StateID" = 1 THEN '$Enum_CardImportStates_Import'
			WHEN "ci"."StateID" = 2 THEN '$Enum_CardImportStates_Cancelled'
			WHEN "ci"."StateID" = 3 THEN '$Enum_CardImportStates_FinishedWithErrors'
			WHEN "ci"."StateID" = 4 THEN '$Enum_CardImportStates_Finished' 
			ELSE '$Enum_CardImportStates_Created'
			END AS "StateName",
		"ci"."TotalCount",
		"ci"."ImportedCount",
		"ci"."WarningCount",
		"ci"."SkippedCount",
		"ci"."ErrorCount"
	}
	{
		COUNT(*) as "Count"
	}
	FROM "CardImports" as "ci"
	INNER JOIN "Instances" as "i"
	ON "ci"."ID" = "i"."ID"
	WHERE true
	#param(Created, "i"."Created")
	#param(CreatedBy, "i"."CreatedByID")
	#param(State, "ci"."StateID")
	#if(HasErrors) 
	{
		#if(HasErrors.CriteriaName == "IsTrue") 
		{ 
	AND "ci"."ErrorCount" > 0
		} 
		{
	AND "ci"."ErrorCount" = 0
		}
	}
	#if(HasWarnings) 
	{
		#if(HasWarnings.CriteriaName == "IsTrue") 
		{ 
	AND "ci"."WarningCount" > 0
		} 
		{
	AND "ci"."WarningCount" = 0
		}
	}
) as "ci"
#if(Normal)
{
ORDER BY #order_by
}
#if(PageOffset)
{
OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
}