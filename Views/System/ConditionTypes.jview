[TEXTPART ConditionTypes JSONMETA]
{
  "Alias": "ConditionTypes",
  "Caption": "$Views_Names_ConditionTypes",
  "Columns": [
    {
      "Alias": "ConditionTypeID",
      "Hidden": true,
      "Type": "$ConditionTypes.ID"
    },
    {
      "Alias": "ConditionTypeName",
      "Caption": "$Views_ConditionTypes_Name",
      "FilterParameter": "Name",
      "FilterType": "Parameter",
      "Localizable": true,
      "SortBy": "lName.Value",
      "Type": "$ConditionTypes.Name"
    },
    {
      "Alias": "ConditionTypeDescription",
      "Caption": "$Views_ConditionTypes_Description",
      "Localizable": true,
      "SortBy": "lDescription.Value",
      "Type": "$ConditionTypes.Description"
    },
    {
      "Alias": "rn",
      "Hidden": true,
      "Type": "Int64 Null"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "ConditionTypeName",
      "SortDirection": "Ascending"
    }
  ],
  "FormatVersion": 5,
  "MultiSelect": true,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_ConditionTypes_Name_Param",
      "Type": "$ConditionTypes.Name"
    },
    {
      "Alias": "UsePlace",
      "AllowedOperands": [
        "Equality"
      ],
      "Caption": "$Views_ConditionTypes_UsePlace_Param",
      "Hidden": true,
      "RefSection": [
        "ConditionUsePlaces"
      ],
      "Type": "$ConditionUsePlaces.ID"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "ConditionType",
      "DisplayValueColumn": "ConditionTypeName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "ConditionTypes"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count"
    }
  ],
  "TreatAsSingleQuery": true
}

[TEXTPART ConditionTypes MSSQL]
SELECT
	[t].*
FROM (
	SELECT
		#if(Normal) {
		[t].[ID]								AS [ConditionTypeID],
		[t].[Name]								AS [ConditionTypeName],
		[t].[Description]						AS [ConditionTypeDescription],
		row_number() OVER (ORDER BY #order_by)	AS [rn]
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM [ConditionTypes] AS [t] WITH (NOLOCK)
	#if(Name || Normal && request.SortedBy("ConditionTypeName")) {
	CROSS APPLY [Localization]([t].[Name], #param(locale)) AS [lName]
	}
	#if(Name || Normal && request.SortedBy("ConditionTypeDescription")) {
	CROSS APPLY [Localization]([t].[Description], #param(locale)) AS [lDescription]
	}
	#if(UsePlace) { 
	CROSS APPLY (
		SELECT TOP 1 1 AS [tmp] FROM [ConditionTypeUsePlaces] AS [ctup] WITH(NOLOCK)
		WHERE [ctup].[ID] = [t].[ID]
			#param(UsePlace, [ctup].[UsePlaceID])
	) AS [U]
	}
	WHERE 1 = 1
		#param(Name, [lName].[Value])
	) AS [t]
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}


[TEXTPART ConditionTypes PGSQL]
SELECT
	#if(Normal) {
	"t"."ID"			AS "ConditionTypeID",
	"t"."Name"			AS "ConditionTypeName",
	"t"."Description"	AS "ConditionTypeDescription",
	0::int8				AS "rn"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
FROM "ConditionTypes" AS "t"
#if(Name || Normal && request.SortedBy("ConditionTypeName")) {
CROSS JOIN "Localization"("t"."Name", #param(locale)) AS "lName"
}
#if(Name || Normal && request.SortedBy("ConditionTypeDescription")) {
CROSS JOIN "Localization"("t"."Description", #param(locale)) AS "lDescription"
}
#if(UsePlace) {
INNER JOIN LATERAL (
	SELECT true
	FROM "ConditionTypeUsePlaces" AS "ctup"
	WHERE "ctup"."ID" = "t"."ID"
		#param(UsePlace, "ctup"."UsePlaceID")
	LIMIT 1
	) AS "U"("Value") ON true
}
WHERE true
	#param(Name, "lName"."Value")
#if(Normal) {
ORDER BY #order_by
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
}