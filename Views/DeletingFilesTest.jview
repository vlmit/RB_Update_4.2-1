[TEXTPART DeletingFilesTest MSSQL]


[TEXTPART DeletingFilesTest PGSQL]
SELECT 
		"fv"."ID" as "FileID", 
		"fv"."RowID" as "VersionID"
FROM "FileVersions" as "fv"
WHERE true
		#param(VersionID, "fv"."RowID")
		#param(FileID, "fv"."ID")