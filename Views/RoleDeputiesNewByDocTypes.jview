[TEXTPART RoleDeputiesNewByDocTypes MSSQL]
SELECT 
	#if(Normal) {
	[rdnmu].[PersonalRoleID]		AS [RoleDeputyID],
	[rdnmu].[PersonalRoleName]		AS [RoleDeputyName],
	[r].[ID]						AS [RoleDeputizedID],
	[r].[Name]						AS [RoleDeputizedName],
	STUFF((
		SELECT N'; ' + [lCaption].[Value]
		FROM [RoleDeputiesNestedManagementTypes] AS [rdnmt] WITH (NOLOCK)
		CROSS APPLY [Localization]([rdnmt].[TypeCaption], N'ru') AS [lCaption]
		WHERE [rdnmt].[ParentRowID] = [rdnm].[RowID]
		FOR XML PATH('')), 1, 2, N'')
									AS [RoleDeputyTypes],
	[rdnm].[MinDate]				AS [RoleDeputyFrom],
	[rdnm].[MaxDate]				AS [RoleDeputyTo],
	CAST(0 as bit) 					AS [RoleDeputyIsPermanent],
	[rdnm].[IsEnabled]				AS [RoleDeputyIsEnabled],			
	[rdnm].[IsActive]				AS [RoleDeputyIsActive],
	[t].[rn]
	}
	#if(Count) {
		count(*)					AS [cnt]
	}
FROM (
	SELECT 
		[rdnmu].[RowID]
		#if(Normal){
		, ROW_NUMBER() OVER (ORDER BY #order_by) AS [rn]
		}

		FROM (
		SELECT [ru].[UserID]
		FROM [RoleUsers] AS [ru] WITH(NOLOCK)
		INNER JOIN [Roles] AS [r] WITH(NOLOCK) ON [r].[ID] = [ru].[ID]
		WHERE [ru].[IsDeputy] = 0
			AND [r].[DisableDeputies] = 0
			#param(Role, [ru].[ID])

		#if(!DeputiesSettings.UseDeputyRoleSeparation)
		{
		UNION

		SELECT [rdnmu].[PersonalRoleID] AS [UserID]
		FROM [RoleUsers] AS [ru] WITH(NOLOCK)
		INNER JOIN [Roles] AS [r] WITH(NOLOCK) ON [r].[ID] = [ru].[ID]
		INNER JOIN [RoleDeputiesNestedManagementUsers] AS [rdnmu] WITH (NOLOCK) ON [ru].[UserID] = [rdnmu].[ID]

		WHERE [ru].[IsDeputy] = 0
			AND [r].[DisableDeputies] = 0
			#param(Role, [ru].[ID])
		}
		) AS [ru]

	INNER JOIN [RoleDeputiesNestedManagementUsers] AS [rdnmu] WITH (NOLOCK) ON [ru].[UserID] = [rdnmu].[ID]
	INNER JOIN [RoleDeputiesNestedManagement] AS [rdnm] WITH (NOLOCK) ON [rdnmu].[ParentRowID] = [rdnm].[RowID]
	INNER JOIN [Roles] AS [r] WITH (NOLOCK) ON [rdnmu].[PersonalRoleID] = [r].[ID]

	WHERE 1 = 1
		#param(Deputized, [ru].[UserID])
		#param(Deputy, [rdnmu].[PersonalRoleID])
		#param(IsEnabled, [rdnm].[IsEnabled])
		#param(IsActive, [rdnm].[IsActive])
		#if(AvailableOnDate) { AND #param(AvailableOnDate) BETWEEN [rdnm].[MinDate] AND [rdnm].[MaxDate] }

	#if(TypeID) {
		AND EXISTS (
			SELECT NULL
			FROM [RoleDeputiesNestedManagementTypes] AS [rdnmt] WITH (NOLOCK)
			WHERE [rdnm].[RowID] = [rdnmt].[ParentRowID]
				#param(TypeID, [rdnmt].[TypeID])
			)
	}

	) AS [t]
INNER JOIN [RoleDeputiesNestedManagementUsers] AS [rdnmu] WITH (NOLOCK) ON [t].[RowID] = [rdnmu].[RowID]
INNER JOIN [RoleDeputiesNestedManagement] AS [rdnm] WITH (NOLOCK) ON [rdnmu].[ParentRowID] = [rdnm].[RowID]
INNER JOIN [Roles] AS [r] WITH (NOLOCK) ON [rdnm].[ID] = [r].[ID]

#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}

[TEXTPART RoleDeputiesNewByDocTypes PGSQL]
SELECT 
	#if(Normal) {
	"rdnmu"."PersonalRoleID"		AS "RoleDeputyID",
	"rdnmu"."PersonalRoleName"		AS "RoleDeputyName",
	"r"."ID"						AS "RoleDeputizedID",
	"r"."Name"						AS "RoleDeputizedName",
	(
		SELECT string_agg("lCaption"."Value", '; ')
		FROM "RoleDeputiesNestedManagementTypes" AS "rdnmt"
		CROSS JOIN "Localization"("rdnmt"."TypeCaption", 'ru') AS "lCaption"
		WHERE "rdnmt"."ParentRowID" = "rdnm"."RowID"
	)
									AS "RoleDeputyTypes",
	"rdnm"."MinDate"				AS "RoleDeputyFrom",
	"rdnm"."MaxDate"				AS "RoleDeputyTo",
	CAST(0 as bit) 					AS "RoleDeputyIsPermanent",
	"rdnm"."IsEnabled"				AS "RoleDeputyIsEnabled",			
	"rdnm"."IsActive"				AS "RoleDeputyIsActive",
	0::int8							AS "rn"
	}
	#if(Count) {
	count(*)					AS "cnt"
	}
FROM (
	SELECT 
		"rdnmu"."RowID"

		FROM (
		SELECT "ru"."UserID"
		FROM "RoleUsers" AS "ru"
		INNER JOIN "Roles" AS "r" ON "r"."ID" = "ru"."ID"
		WHERE NOT "ru"."IsDeputy"
			AND NOT "r"."DisableDeputies"
			#param(Role, "ru"."ID")

		#if(!DeputiesSettings.UseDeputyRoleSeparation)
		{
		UNION

		SELECT "rdnmu"."PersonalRoleID" AS "UserID"
		FROM "RoleUsers" AS "ru"
		INNER JOIN "Roles" AS "r" ON "r"."ID" = "ru"."ID"
		INNER JOIN "RoleDeputiesNestedManagementUsers" AS "rdnmu" ON "ru"."UserID" = "rdnmu"."ID"

		WHERE NOT "ru"."IsDeputy"
			AND NOT "r"."DisableDeputies"
			#param(Role, "ru"."ID")
		}
		) AS "ru"
		
	INNER JOIN "RoleDeputiesNestedManagementUsers" AS "rdnmu" ON "ru"."UserID" = "rdnmu"."ID"
	INNER JOIN "RoleDeputiesNestedManagement" AS "rdnm" ON "rdnmu"."ParentRowID" = "rdnm"."RowID"
	INNER JOIN "Roles" AS "r" ON "rdnmu"."PersonalRoleID" = "r"."ID"

	WHERE true
		#param(Deputized, "ru"."UserID")
		#param(Deputy, "rdnmu"."PersonalRoleID")
		#param(IsEnabled, "rdnm"."IsEnabled")
		#param(IsActive, "rdnm"."IsActive")
		#if(AvailableOnDate) { AND #param(AvailableOnDate) BETWEEN "rdnm"."MinDate" AND "rdnm"."MaxDate" }

	#if(TypeID) {
		AND EXISTS (
			SELECT NULL
			FROM "RoleDeputiesNestedManagementTypes" AS "rdnmt"
			WHERE "rdnm"."RowID" = "rdnmt"."ParentRowID"
				#param(TypeID, "rdnmt"."TypeID")
			)
	}
		

	) AS "t"
INNER JOIN "RoleDeputiesNestedManagementUsers" AS "rdnmu" ON "t"."RowID" = "rdnmu"."RowID"
INNER JOIN "RoleDeputiesNestedManagement" AS "rdnm" ON "rdnmu"."ParentRowID" = "rdnm"."RowID"
INNER JOIN "Roles" AS "r" ON "rdnm"."ID" = "r"."ID"

#if(Normal) {
ORDER BY #order_by
}
#if(PageOffset) {
	OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
}