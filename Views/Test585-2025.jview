[TEXTPART Test585-2025 MSSQL]


[TEXTPART Test585-2025 PGSQL]
select "dci"."FullNumber", "dci"."ParentID" from "DocumentCommonInfo" as "dci"
JOIN "Instances" as "i"
ON "i"."ID" = "dci"."ID"
WHERE "i"."TypeID" = '01ad498e-5f8e-417a-bd28-942739dbf342'
and "dci"."ParentID" IN (select "i"."ID"
from "Instances" as "i"
JOIN "Correspondents" as "cr"
ON "cr"."ID" = "i"."ID"
where "cr"."PartnersName" like '%Тест.Не использоватьтт%')