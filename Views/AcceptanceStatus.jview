[TEXTPART AcceptanceStatus MSSQL]


[TEXTPART AcceptanceStatus PGSQL]
SELECT
	"pt"."ID"		AS "ASID",
	"pt"."Name"		AS "ASName"
FROM "AcceptanceStatus" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"