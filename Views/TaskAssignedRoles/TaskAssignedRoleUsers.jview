[TEXTPART TaskAssignedRoleUsers MSSQL]
SELECT
	#if(Normal) {
	[t].[ID]					AS [UserID],
	[pr].[Name]					AS [UserName],
	[pr].[Email],
	[pr].[Position],
	STUFF((
		SELECT N', ' + [r].[Name]
		FROM [RoleUsers] AS [ru] WITH (NOLOCK)
		INNER JOIN [Roles] AS [r] WITH (NOLOCK)
			ON [r].[ID] = [ru].[ID]
		WHERE [ru].[UserID] = [t].[ID]
			AND [ru].[TypeID] = 2
		ORDER BY [r].[Name]
		FOR XML PATH('')
	), 1, 2, N'') 				AS [Departments],
	STUFF((
		SELECT N', ' + [r].[Name]
		FROM [RoleUsers] AS [ru] WITH (NOLOCK)
		INNER JOIN [Roles] AS [r] WITH (NOLOCK)
			ON [r].[ID] = [ru].[ID]
		WHERE [ru].[UserID] = [t].[ID]
			AND [ru].[TypeID] = 0
		ORDER BY [r].[Name]
		FOR XML PATH('')
	), 1, 2, N'') 				AS [StaticRoles],
	[pr].[FullName]				AS [FullName]
	} {
	[t].*
	}
FROM (
	SELECT
		#if(Normal) {
		[t].[ID],
		row_number() OVER (ORDER BY #order_by) AS [rn]
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM [Roles] AS [t] WITH (NOLOCK)
	WHERE
			[t].[TypeID] = 1
			#param(Name, [t].[Name])
			#if(RoleExclusionID) {
			-- кроме роли
			AND NOT EXISTS (
				SELECT NULL
				FROM [RoleUsers] AS [ru] WITH (NOLOCK)
				WHERE [ru].[UserID] = [t].[ID]
					#param(RoleExclusionID, [ru].[ID]))
			}
			
			AND [t].[ID] in (
				SELECT [child_tar].[RoleID]
					FROM [TaskAssignedRoles] as [parent_tar]
				INNER JOIN [TaskAssignedRoles] as [child_tar]
					ON [child_tar].[ParentRowID] = [parent_tar].[RowID]
				INNER JOIN [RoleUsers] AS [ru] WITH (NOLOCK) -- заместители
					ON [ru].[UserID] = [t].[ID]
				WHERE [child_tar].[RoleType]  = 1 -- константный ID типа "персональная роль"
				AND [ru].[UserID] = [child_tar].[RoleID] -- заместители
				#param(TaskAssignedRoleRowID, [parent_tar].[RowID]) -- пробрасываемый параметр TaskAssignedRoleRowID
				)
			
			#if(!ShowHidden || ShowHidden.CriteriaName != "IsTrue") {
			--не отображать скрытые
			AND [t].[Hidden] = 0
			}
	) AS [t]
#if(Normal) {
INNER JOIN [PersonalRoles] AS [pr] WITH (NOLOCK)
	ON [pr].[ID] = [t].[ID]
}
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}

[TEXTPART TaskAssignedRoleUsers PGSQL]
SELECT
	#if(Normal) {
	"t"."ID"					AS "UserID",
	"pr"."Name"					AS "UserName",
	"pr"."Email",
	"pr"."Position",
	STRING_AGG("r1"."Name", ', ' ORDER BY "r1"."Name") AS "Departments",
    STRING_AGG("r2"."Name", ', ' ORDER BY "r2"."Name") AS "StaticRoles",
    "pr"."FullName"				AS "FullName"
	} {
	"t".*
	}
FROM (
	SELECT
		#if(Normal) {
		"t"."ID"
		}
		#if(Count) {
		count(*) AS "cnt"
		}
	FROM "Roles" AS "t"
	WHERE
			"t"."TypeID" = 1
			#param(Name, "t"."Name")
			#if(RoleExclusionID) {
			-- кроме роли
			AND NOT EXISTS (
				SELECT NULL
				FROM "RoleUsers" AS "ru"
				WHERE "ru"."UserID" = "t"."ID"
					#param(RoleExclusionID, "ru"."ID"))
			}
			
			AND "t"."ID" in (
				SELECT "child_tar"."RoleID"
					FROM "TaskAssignedRoles" as "parent_tar"
				INNER JOIN "TaskAssignedRoles" as "child_tar"
					ON "child_tar"."ParentRowID" = "parent_tar"."RowID"
				INNER JOIN "RoleUsers" AS "ru" -- заместители
					ON "ru"."UserID" = "t"."ID"
				WHERE "child_tar"."RoleType"  = 1 -- константный ID типа "персональная роль"
				AND "ru"."UserID" = "child_tar"."RoleID" -- заместители
				#param(TaskAssignedRoleRowID, "parent_tar"."RowID") -- пробрасываемый параметр TaskAssignedRoleRowID
				)
			
			#if(!ShowHidden || ShowHidden.CriteriaName != "IsTrue") {
			--не отображать скрытые
			AND "t"."Hidden" = false
			#if(Normal) {
				ORDER BY #order_by
			}
			}
	) AS "t"
#if(Normal) {
INNER JOIN "PersonalRoles" AS "pr"
	ON "pr"."ID" = "t"."ID"
	
LEFT JOIN (
    SELECT "ru"."UserID", "r1"."Name"
    FROM "RoleUsers" AS "ru"
    INNER JOIN "Roles" AS "r1" ON "r1"."ID" = "ru"."ID"
    WHERE "ru"."TypeID" = 2
) AS "r1" ON "t"."ID" = "r1"."UserID"

LEFT JOIN (
    SELECT "ru"."UserID", "r2"."Name"
    FROM "RoleUsers" AS "ru"
    INNER JOIN "Roles" AS "r2" ON "r2"."ID" = "ru"."ID"
    WHERE "ru"."TypeID" = 0
) AS "r2" ON "t"."ID" = "r2"."UserID"

group by "t"."ID", "pr"."Name", "pr"."FullName", "pr"."Email", "pr"."Position"
}
#if(PageOffset) {
	OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
}