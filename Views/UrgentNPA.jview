{
  "Alias": "UrgentNPA",
  "Caption": "Кол-во срочных НПА",
  "GroupName": "Testing",
  "ID": "680827b8-36cf-4e34-8915-af9824ec9355",
  "JsonMetadataSource::txt": "UrgentNPA JSONMETA",
  "MsQuerySource::txt": "UrgentNPA MSSQL",
  "PgQuerySource::txt": "UrgentNPA PGSQL"
}

[TEXTPART UrgentNPA JSONMETA]
{
  "Alias": "UrgentNPA",
  "Caption": "Кол-во срочных НПА",
  "Columns": [
    {
      "Alias": "Projects",
      "Caption": "Проектов НПА",
      "Type": "Int64 Null"
    },
    {
      "Alias": "Documents",
      "Caption": "Документов НПА",
      "Type": "Int64 Null"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART UrgentNPA MSSQL]


[TEXTPART UrgentNPA PGSQL]
select 
(select count(*) from "DocumentCommonInfo" as "dci"
where "dci"."CardTypeID"='4e8d39ac-381e-4111-bc3a-66179ace7ecb'
and "dci"."CreationDate" > '2023-12-13 23:59:59' 
and "dci"."UrgencyNPAID" is not null
) as "Projects",
(select count(*) from "DocumentCommonInfo" as "dci"
where "dci"."CardTypeID"='0fadf560-bd34-4c41-b24e-e63d3b15bd74'
and "dci"."CreationDate" > '2023-12-13 23:59:59' 
and "dci"."UrgencyNPAID" is not null) as "Documents"

