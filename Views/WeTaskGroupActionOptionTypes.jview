[TEXTPART WeTaskGroupActionOptionTypes JSONMETA]
{
  "Alias": "WeTaskGroupActionOptionTypes",
  "Caption": "$Views_Names_WeTaskGroupActionOptionTypes",
  "Columns": [
    {
