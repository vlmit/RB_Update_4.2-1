[TEXTPART TaskKinds JSONMETA]
{
  "Alias": "TaskKinds",
  "Caption": "$Views_Names_TaskKinds",
  "Columns": [
    {
      "Alias": "KindID",
      "FilterParameter": "ID",
      "FilterType": "Parameter",
      "Hidden": true,
      "Type": "$TaskKinds.ID"
    },
    {
      "Alias": "KindCaption",
      "Caption": "$Views_TaskKinds_Caption",
      "FilterParameter": "Caption",
      "FilterType": "Parameter",
      "Localizable": true,
      "SortBy": "lCaption.Value",
      "Type": "$TaskKinds.Caption"
    },
    {
      "Alias": "rn",
      "Hidden": true,
      "Type": "Int64 Null"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "KindCaption",
      "SortDirection": "Ascending"
    }
  ],
  "FormatVersion": 5,
  "MultiSelect": true,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "ID",
      "Caption": "$Views_TaskKinds_ID_Param",
      "Hidden": true,
      "Multiple": false,
      "Type": "$TaskKinds.ID"
    },
    {
      "Alias": "Caption",
      "Caption": "$Views_TaskKinds_Caption_Param",
      "Type": "String(Max) Null"
    }
  ],
  "QuickSearchParam": "Caption",
  "References": [
    {
      "ColPrefix": "Kind",
      "DisplayValueColumn": "KindCaption",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "TaskKinds"
      ]
