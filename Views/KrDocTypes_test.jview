{
  "Alias": "KrDocTypes_test",
  "Caption": "Типы документов (подтипы)",
  "GroupName": "Kr Wf",
  "ID": "75924f99-9f35-4b52-9ab0-eb49f9eb98a4",
  "JsonMetadataSource::txt": "KrDocTypes_test JSONMETA",
  "MsQuerySource::txt": "KrDocTypes_test MSSQL",
  "PgQuerySource::txt": "KrDocTypes_test PGSQL"
}

[TEXTPART KrDocTypes_test JSONMETA]
{
  "Alias": "KrDocTypes_test",
  "Caption": "Типы документов (подтипы)",
  "Columns": [
    {
      "Alias": "KrDocTypeID",
      "Type": "$KrDocType.ID"
    },
    {
      "Alias": "KrDocTypeTitle",
      "Caption": "$Views_KrDocTypes_Name",
      "Localizable": true,
      "SortBy": "lTitle.Value",
      "Type": "$KrDocType.Title"
    },
    {
      "Alias": "KrDocCardTypeCaption",
      "Caption": "$Views_KrDocTypes_CardType",
      "Localizable": true,
      "SortBy": "lCardTypeCaption.Value",
      "Type": "$KrDocType.CardTypeCaption"
    },
    {
      "Alias": "ExternalID",
      "Caption": "Группа документов (EOS)",
      "Localizable": true,
      "SortBy": "lTitle.Value",
      "Type": "$KrDocType.Title"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "KrDocTypeTitle",
      "SortDirection": "Ascending"
    }
  ],
  "FormatVersion": 5,
  "MultiSelect": true,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_KrDocTypes_Name_Param",
      "Multiple": false,
      "Type": "String"
    },
    {
      "Alias": "TypeCaption",
      "Hidden": true,
      "Multiple": false,
      "Type": "$KrDocType.CardTypeCaption"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "KrDocType",
      "DisplayValueColumn": "KrDocTypeTitle",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "KrDocType"
      ]
    }
  ]
}

[TEXTPART KrDocTypes_test MSSQL]
SELECT
	[t].[ID]				AS [KrDocTypeID],
	[t].[Title]				AS [KrDocTypeTitle],
	[t].[CardTypeCaption]	AS [KrDocCardTypeCaption]
FROM [KrDocType] AS [t] WITH (NOLOCK)
#if(Name || request.SortedBy("KrDocTypeTitle")) {
CROSS APPLY [Localization]([t].[Title], #param(locale)) AS [lTitle]
}
#if(request.SortedBy("KrDocCardTypeCaption")) {
CROSS APPLY [Localization]([t].[CardTypeCaption], #param(locale)) AS [lCardTypeCaption]
}
WHERE 1 = 1
	#param(Name, [lTitle].[Value])
ORDER BY #order_by

[TEXTPART KrDocTypes_test PGSQL]
SELECT
	"t"."ID"				AS "KrDocTypeID",
	"t"."Title"				AS "KrDocTypeTitle",
	"t"."CardTypeCaption"	AS "KrDocCardTypeCaption",
	"t"."ExternalID"	AS "ExternalID"
FROM "KrDocType" AS "t"
#if(Name || request.SortedBy("KrDocTypeTitle")) {
CROSS JOIN "Localization"("t"."Title", #param(locale)) AS "lTitle"
}
#if(request.SortedBy("KrDocCardTypeCaption")) {
CROSS JOIN "Localization"("t"."CardTypeCaption", #param(locale)) AS "lCardTypeCaption"
}
WHERE true and "t"."UseAutoApprove" = true
	#param(Name, "lTitle"."Value")
	#param(TypeCaption, "t"."CardTypeCaption")
ORDER BY #order_by
