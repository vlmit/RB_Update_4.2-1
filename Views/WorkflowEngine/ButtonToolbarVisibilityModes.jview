[TEXTPART ButtonToolbarVisibilityModes MSSQL]
SELECT
	[a].[ID]		AS [ModeID],
	[a].[Name]		AS [ModeName]
FROM [BusinessProcessButtonToolbarVisibilityModes] AS [a] WITH (NOLOCK)
#if(Name) {
CROSS APPLY [Localization]([a].[Name], #param(locale)) AS [l]
}
WHERE 1 = 1
	#param(Name, [l].[Value])
ORDER BY [a].[ID]


[TEXTPART ButtonToolbarVisibilityModes PGSQL]
SELECT
	"a"."ID"		AS "ModeID",
	"a"."Name"		AS "ModeName"
FROM "BusinessProcessButtonToolbarVisibilityModes" AS "a"
#if(Name) {
CROSS JOIN "Localization"("a"."Name", #param(locale)) AS "l"
}
WHERE true
	#param(Name, "l"."Value")
ORDER BY "a"."ID"