[TEXTPART ButtonToolbarVisibilityModes JSONMETA]
{
  "Alias": "ButtonToolbarVisibilityModes",
  "Caption": "$Views_Names_ButtonToolbarVisibilityModes",
  "Columns": [
    {
      "Alias": "ModeID",
      "Hidden": true,
      "Type": "$BusinessProcessButtonToolbarVisibilityModes.ID"
    },
    {
      "Alias": "ModeName",
      "Caption": "$Views_ButtonToolbarVisibilityModes_Name_Param",
      "Localizable": true,
      "Type": "$BusinessProcessButtonToolbarVisibilityModes.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_ButtonToolbarVisibilityModes_Name_Param",
      "Type": "String(Max) Null"
    }
  ],
  "References": [
    {
      "ColPrefix": "Mode",
      "DisplayValueColumn": "ModeName",
      "RefSection": [
        "ButtonToolbarVisibilityModes"
      ]
    }
  ],
  "TreatAsSingleQuery": true
