{
  "Alias": "User_PersonalList_test_22",
  "Caption": "Пользователи в личном списке",
  "GroupName": "System",
  "ID": "27664673-7f44-4990-8f6c-6e1a8f3561e6",
  "JsonMetadataSource::txt": "User_PersonalList_test_22 JSONMETA",
  "MsQuerySource::txt": "User_PersonalList_test_22 MSSQL",
  "PgQuerySource::txt": "User_PersonalList_test_22 PGSQL"
}

[TEXTPART User_PersonalList_test_22 JSONMETA]
{
  "Alias": "User_PersonalList_test_22",
  "Caption": "Пользователи в личном списке",
  "Columns": [
    {
      "Alias": "UserID",
      "Hidden": true,
      "Type": "$PersonalRoles.ID"
    },
    {
      "Alias": "UserName",
      "Type": "$PersonalRoles.Name"
    },
    {
      "Alias": "Departments",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "StaticRoles",
      "Hidden": true,
      "Type": "String(Max) Null"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "LinkedStaticRoleID",
      "Caption": "LinkedStaticRoleID",
      "Multiple": false,
      "Type": "Guid Not Null"
    },
    {
      "Alias": "Name",
      "Caption": "Сотрудник",
      "Multiple": false,
      "Type": "$PersonalRoles.Name"
    },
    {
      "Alias": "SortByN",
      "Caption": "Сортировать по №",
      "Multiple": false,
      "Type": "Boolean Null"
    }
  ],
  "References": [
    {
      "ColPrefix": "User",
      "DisplayValueColumn": "UserName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "UserPersonal"
      ]
    }
  ]
}

[TEXTPART User_PersonalList_test_22 MSSQL]


[TEXTPART User_PersonalList_test_22 PGSQL]
SELECT 
	#if(Normal) {
	 "t"."ID"				AS "UserID",
	concat("t"."Name",' - ',"t"."Position") AS "UserName",
	(
		SELECT string_agg("Name", ', ')
		FROM (
			SELECT "r"."Name"
			FROM "RoleUsers" AS "ru"
			INNER JOIN "Roles" AS "r"
				ON "r"."ID" = "ru"."ID"
			WHERE "ru"."UserID" = "t"."ID"
				AND "ru"."TypeID" = 2
			ORDER BY "r"."Name") AS "names"
	)						AS "Departments",
	(
		SELECT string_agg("Name", ', ')
		FROM (
			SELECT "r"."Name"
			FROM "RoleUsers" AS "ru"
			INNER JOIN "Roles" AS "r"
				ON "r"."ID" = "ru"."ID"
			WHERE "ru"."UserID" = "t"."ID"
				AND "ru"."TypeID" = 0
			ORDER BY "r"."Name") AS "names"
	)						AS "StaticRoles"
	}
FROM
	"PersonalRoles" as "t"
	inner join "RoleUsers" as "ru" on "ru"."UserID"="t"."ID"
	inner join "Roles" as "r" on "ru"."ID"="r"."ID"
	inner join "PersonalListRoles" as "plr" on "plr"."RoleID"="t"."ID"
	inner join "PersonalList" as "pl" on "pl"."ID"="plr"."ID"


	
WHERE
	true
	and "r"."Hidden"=false and "pl"."Status"=false and "pl"."OwnerID" = #param(CurrentUserID)
	#param(LinkedStaticRoleID, "pl"."LinkedStaticRoleID")

#if(SortByN && SortByN.Value=true) 
{ group by "t"."ID","t"."Name","plr"."SortN"
order by "plr"."SortN" nulls last, "t"."Name" } 
{group by "t"."ID", "t"."Name"
order by "t"."Name" }

