}

[TEXTPART NDSRate JSONMETA]
{
  "Alias": "NDSRate",
  "Caption": "Ставка ДНС",
  "Columns": [
    {
      "Alias": "NdsID",
      "Hidden": true,
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "NdsRate",
      "Caption": "Ставка НДС",
      "Type": "$NDSRate.Rate"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "NdsID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Rate",
      "Multiple": false,
      "Type": "$NDSRate.Rate"
    }
  ],
  "QuickSearchParam": "Rate",
  "References": [
    {
      "CardType": "RB_NDSRate",
      "ColPrefix": "NDS",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "NDSRate"
      ]
    }
  ]
}

[TEXTPART NDSRate MSSQL]


[TEXTPART NDSRate PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"pt"."Rate"		AS "NdsRate"
FROM "NDSRate" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
