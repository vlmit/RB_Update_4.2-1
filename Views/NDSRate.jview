[TEXTPART NDSRate MSSQL]


[TEXTPART NDSRate PGSQL]
SELECT
	"pt"."ID"		AS "NdsID",
	"pt"."Rate"		AS "NdsRate"
FROM "NDSRate" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"