  "Subsets": [
    {
      "Alias": "Count"
    }
  ],
  "TreatAsSingleQuery": true
}

[TEXTPART SmartRoles MSSQL]
SELECT
	#if(Normal) {
	[t].[SmartRoleID],
	[t].[SmartRoleName],
	[t].[SmartRoleOwner]
	}
	#if(Count) {
	[t].*
	}
FROM (
	SELECT
		#if(Normal) {
		[t].[ID]								AS [SmartRoleID],
		[r].[Name]								AS [SmartRoleName],
		[t].[OwnerName]							AS [SmartRoleOwner],
		row_number() OVER (ORDER BY #order_by)	AS [rn]
		}
		#if(Count) {
		count(*)								AS [cnt]
		}
	FROM [SmartRoles] AS [t] WITH (NOLOCK)
	INNER JOIN [Roles] AS [r] WITH (NOLOCK)
		ON [t].[ID] = [r].[ID]
	#if(request.SortedBy("SmartRoleOwner")) {
	CROSS APPLY [Localization]([t].[OwnerName], #param(locale)) AS [lOwnerName]
	}
	WHERE 1 = 1
		#param(Name, [r].[Name])
		#param(Generator, [t].[RuleID])
	) AS [t]
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}

[TEXTPART SmartRoles PGSQL]
SELECT
	#if(Normal) {
	"t"."SmartRoleID",
	"t"."SmartRoleName",
	"t"."SmartRoleOwner"
	}
	#if(Count) {
	"t".*
	}
FROM (
	SELECT
		#if(Normal) {
		"t"."ID"								AS "SmartRoleID",
		"r"."Name"								AS "SmartRoleName",
		"t"."OwnerName"							AS "SmartRoleOwner",
		row_number() OVER (ORDER BY #order_by)	AS "rn"
		}
		#if(Count) {
		count(*)								AS "cnt"
		}
	FROM "SmartRoles" AS "t"
	INNER JOIN "Roles" AS "r"
		ON "t"."ID" = "r"."ID"
	#if(request.SortedBy("SmartRoleOwner")) {
	CROSS JOIN "Localization"("t"."OwnerName", #param(locale)) AS "lOwnerName"
	}
	WHERE true
		#param(Name, "r"."Name")
		#param(Generator, "t"."RuleID")
	#if(Normal) {
	ORDER BY #order_by
	}
	#if(PageOffset) {
	OFFSET #param(PageOffset) - 1 LIMIT #eval(PageLimit.Value)
	}
	) AS "t"