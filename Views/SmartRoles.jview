{
  "Alias": "SmartRoles",
  "Caption": "$Views_Names_SmartRoles",
  "Columns": [
    {
      "Alias": "SmartRoleID",
      "Hidden": true,
      "Type": "$Roles.ID"
    },
    {
      "Alias": "SmartRoleName",
      "Caption": "$Views_SmartRoles_Name",
      "FilterParameter": "Name",
      "FilterType": "Parameter",
      "Localizable": true,
      "SortBy": "r.Name",
      "Type": "$Roles.Name"
    },
    {
      "Alias": "SmartRoleOwner",
      "Caption": "$Views_SmartRoles_Owner",
      "Localizable": true,
      "SortBy": "lOwnerName.Value",
      "Type": "$SmartRoles.OwnerName"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "SmartRoleName",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "MultiSelect": true,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_SmartRoles_Name_Param",
      "Type": "$Roles.Name"
    },
    {
      "Alias": "Generator",
      "AutoCompleteInfo": {
        "ParamAlias": "Name",
        "ViewAlias": "SmartRoleGenerators"
      },
      "Caption": "$Views_SmartRoles_Generator_Param",
      "IgnoreCase": false,
      "Multiple": false,
      "RefSection": [
        "SmartRoleGenerators"
      ],
      "Type": "$SmartRoles.RuleID"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "SmartRole",
      "DisplayValueColumn": "SmartRoleName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
