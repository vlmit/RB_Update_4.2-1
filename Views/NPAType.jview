[TEXTPART NPAType MSSQL]


[TEXTPART NPAType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Index"		AS "TypeIndex",
	"pt"."Name"		AS "TypeName"
FROM "NPAType" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"