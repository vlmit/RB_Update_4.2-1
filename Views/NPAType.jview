{
  "Alias": "NPAType",
  "Caption": "Вид НПА",
  "GroupName": "Custom",
  "ID": "a6387d04-e541-4ee4-9c1f-185b3900a887",
  "JsonMetadataSource::txt": "NPAType JSONMETA",
  "MsQuerySource::txt": "NPAType MSSQL",
  "PgQuerySource::txt": "NPAType PGSQL"
}

[TEXTPART NPAType JSONMETA]
{
  "Alias": "NPAType",
  "Caption": "Вид НПА",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$NPAType.ID"
    },
    {
      "Alias": "Index",
      "Caption": "Индекс",
      "Type": "$NPAType.Index"
    },
    {
      "Alias": "TypeName",
      "Caption": "Вид НПА",
      "Type": "$NPAType.Name"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "TypeID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Название",
      "Multiple": false,
      "Type": "$NPAType.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "CardType": "NPAType",
      "ColPrefix": "Type",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "NPAType"
      ]
    }
  ]
}

[TEXTPART NPAType MSSQL]


[TEXTPART NPAType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Index"		AS "TypeIndex",
	"pt"."Name"		AS "TypeName"
FROM "NPAType" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
