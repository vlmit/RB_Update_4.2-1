  "GroupName": "Custom",
  "ID": "9a4777b0-1c2d-49b7-83a5-f1e4361e0c4d",
  "JsonMetadataSource::txt": "test111_npa_urgency JSONMETA",
  "MsQuerySource::txt": "test111_npa_urgency MSSQL",
  "PgQuerySource::txt": "test111_npa_urgency PGSQL"
}

[TEXTPART test111_npa_urgency JSONMETA]
{
  "Alias": "test111_npa_urgency",
  "Caption": "test",
  "Columns": [
    {
      "Alias": "DocID",
      "Caption": "ID",
      "Type": "Guid Null"
    },
    {
      "Alias": "DocFullNumber",
      "Caption": "FullNumber",
      "Type": "String(Max) Null"
    },
    {
      "Alias": "CreationDate",
      "Caption": "CreationDate",
      "Type": "DateTime Null"
    },
    {
      "Alias": "UrgencyNPAName",
      "Caption": "UrgencyNPAName",
      "Type": "String(Max) Null"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "References": [
    {
      "ColPrefix": "Doc",
      "DisplayValueColumn": "DocFullNumber",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "DocumentCommonInfo",
        "DocRefsSection"
      ]
    }
  ]
}

[TEXTPART test111_npa_urgency MSSQL]


[TEXTPART test111_npa_urgency PGSQL]
select "dci"."ID" as "DocID",
"dci"."FullNumber" as "DocFullNumber",
"dci"."CreationDate",
"dci"."UrgencyNPAName"

from "DocumentCommonInfo" as "dci"
where "dci"."CardTypeID" = '4e8d39ac-381e-4111-bc3a-66179ace7ecb'
and 
"dci"."UrgencyNPAID" is not null

order by "dci"."CreationDate" desc
limit 100
