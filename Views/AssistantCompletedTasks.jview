[TEXTPART AssistantCompletedTasks MSSQL]
DECLARE @NoName			nvarchar(max);
#if(TypeParam) {
DECLARE @CardTypeID		uniqueidentifier;
}

SET @NoName = [dbo].[GetString](N'Views_CompletedTasks_NoName_Sql', #param(locale));

#if(TypeParam) {
-- индексы в DocumentCommonInfo устроены так, что нам быстрее сначала найти тип карточки по CardType, а потом тип документа
SET @CardTypeID = #param(TypeParam);

SELECT @CardTypeID = [CardTypeID]
FROM [KrDocType] WITH (NOLOCK)
WHERE [ID] = #param(TypeParam);
}

SELECT
	[th].[ID]											AS [CardID],
	COALESCE([dci].[FullNumber], @NoName)				AS [CardName],
	[dci].[DocTypeTitle]								AS [CardTypeCaption],
	[dci].[Subject],
	[th].[TypeID],
	COALESCE([th].[KindCaption], [th].[TypeCaption])	AS [TypeCaption],
	[th].[OptionID],
	[th].[OptionCaption],
	[th].[Result],
	[th].[RoleID],
	[th].[RoleName],
	[th].[AuthorID],
	[th].[AuthorName],
	[th].[Completed],
	[t].[rn]
FROM (
	SELECT
		[th].[RowID],
		row_number() OVER (ORDER BY #order_by) AS [rn]
	FROM [TaskHistory] AS [th] WITH (NOLOCK)
	#if(TypeParam) {
	LEFT JOIN [DocumentCommonInfo] AS [dci] WITH (NOLOCK)
		ON [dci].[ID] = [th].[ID]
	}
	WHERE [th].[Completed] IS NOT NULL
		#param(CompletionDate, [th].[Completed])
		#param(TaskType, [th].[TypeID])
		#param(SelUser, [th].[UserID])
		#param(Option, [th].[OptionID])

		#if(FromMeMode && FromMeMode.Value == 1) {
		AND [th].[AuthorID] = #param(CurrentUserID)
		} {
		AND [th].[UserID] = #param(CurrentUserID)
		}

		#if(Role) {
		AND EXISTS (
			SELECT NULL
			FROM [RoleUsers] AS [ru] WITH (NOLOCK)
			WHERE [ru].[UserID] = [th].[UserID] #param(Role, [ru].[ID])
			)
		}

		#if(TypeParam) {
		AND [dci].[CardTypeID] = @CardTypeID
		AND COALESCE([dci].[DocTypeID], [dci].[CardTypeID]) = #param(TypeParam)
		}
	) AS [t]
INNER JOIN [TaskHistory] AS [th] WITH (NOLOCK)
	ON [th].[RowID] = [t].[RowID]
LEFT JOIN [DocumentCommonInfo] AS [dci] WITH (NOLOCK)
	ON [dci].[ID] = [th].[ID]
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}
;

[TEXTPART AssistantCompletedTasks PGSQL]
DECLARE
	"no_name"		text;
	#if(TypeParam) {
	"card_type_id"	uuid;
	}
BEGIN
	"no_name" = "GetString"('Views_CompletedTasks_NoName_Sql', #param(locale));

	#if(TypeParam) {
	-- индексы в DocumentCommonInfo устроены так, что нам быстрее сначала найти тип карточки по CardType, а потом тип документа

	SELECT "CardTypeID"
	INTO "card_type_id"
	FROM "KrDocType"
	WHERE "ID" = #param(TypeParam);
	
	IF "card_type_id" IS NULL THEN
		"card_type_id" = #param(TypeParam);
	END IF;
	}

	RETURN QUERY
	SELECT
		#if(ByCompletedByName) {
		"th"."CompletedByID",
		"th"."CompletedByName"			AS "RoleName"
		} 
		#if(Normal){
		"th"."ID"											AS "CardID",
		COALESCE("dci"."FullNumber", "no_name")				AS "CardName",
		"dci"."DocTypeTitle"								AS "CardTypeCaption",
		"dci"."Subject",
		"th"."TypeID",
		COALESCE("th"."KindCaption", "th"."TypeCaption")	AS "TypeCaption",
		"th"."OptionID",
		"th"."OptionCaption",
		"th"."Result",
		"th"."RoleID",
		"th"."RoleName",
		"th"."AuthorID",
		"th"."AuthorName",
		"th"."CompletedByID",
		"th"."CompletedByName",
		"th"."Completed",
		0::int8												AS "rn"
		}
		#if(Count) {
			"t".*
			}
	FROM (
		SELECT
		#if(Normal || ByCompletedByName){
			"th"."RowID"
			}
		#if(Count) {
				count(*) AS "cnt"
				}
		
		FROM "TaskHistory" AS "th"
		#if(TypeParam) {
		LEFT JOIN "DocumentCommonInfo" AS "dci"
			ON "dci"."ID" = "th"."ID"
		}
		WHERE "th"."Completed" IS NOT NULL
			#param(CompletionDate, "th"."Completed")
			#if(ForHeadHistory)
			{
				and extract(day from current_timestamp - "th"."Completed") <= 14
			}
			#param(TaskType, "th"."TypeID")
			#param(SelUser, "th"."UserID")
			#param(Option, "th"."OptionID")
			#param(CompletedBy, "th"."CompletedByID")
			#if(Number) 
				{ and exists (select null from "DocumentCommonInfo" as "dci" where "th"."ID" = "dci"."ID" #param(Number, "dci"."FullNumber"))}
			#if(Subject) 
			{ and exists (select null from "DocumentCommonInfo" as "dci" where "th"."ID" = "dci"."ID" #param(Subject, "dci"."Subject"))}

			#if(FromMeMode && FromMeMode.Value == 1) {
			AND "th"."AuthorID" = #param(CurrentUserID)
			} {
			AND "th"."UserID" IN (Select "d2"."DeputyID" from "RoleDeputies" as "d2" where  "d2"."IsActive" = true AND "d2"."DeputizedID" IN (Select "d"."DeputizedID" from "RoleDeputies" as "d" where "d"."IsActive" = true and "d"."DeputyID" = #param(CurrentUserID))) -- берем пользователей, кто замещает вместе с нами
			AND "th"."UserID" IN (Select "ru"."UserID" from "RoleUsers" as "ru" where "ru"."ID" = '63b38597-d7cb-4de2-9f7e-f2dadf925239' ) -- пользователь входит в роль Все помощники
			AND "th"."UserID" != '2694f9ae-2d72-4dfc-baa0-798934c72335' AND 
				"th"."UserID" != '75b5c834-ab9d-4bd8-a7f0-bfe07f1725c9' AND -- исключили админов
				"th"."UserID" != '4eed2a64-e881-4e85-802f-3708dc3b9cab'
			#if(CompletedByAssistant)
			{
			AND "th"."RoleID"!="th"."CompletedByID" --завершено помощником
			}
			}

			#if(Role) {
			AND EXISTS (
				SELECT NULL
				FROM "RoleUsers" AS "ru"
				WHERE "ru"."UserID" = "th"."UserID" #param(Role, "ru"."ID")
				)
			}

			#if(TypeParam) {
			AND "dci"."CardTypeID" = "card_type_id"
			AND COALESCE("dci"."DocTypeID", "dci"."CardTypeID") = #param(TypeParam)
			}
		#if(Normal) {
		ORDER BY #order_by
		}
		#if(PageOffset) {
		OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
		}
		) AS "t"
	#if(Normal) {	
	INNER JOIN "TaskHistory" AS "th"
		ON "th"."RowID" = "t"."RowID"
	LEFT JOIN "DocumentCommonInfo" AS "dci"
		ON "dci"."ID" = "th"."ID"
	
	ORDER BY #order_by
	}
	#if(ByCompletedByName) {
		/* Сабсет по роли */
		INNER JOIN "TaskHistory" AS "th"
		ON "th"."RowID" = "t"."RowID"
		GROUP BY "th"."CompletedByID", "th"."CompletedByName"
		ORDER BY "th"."CompletedByName"
		};
END;