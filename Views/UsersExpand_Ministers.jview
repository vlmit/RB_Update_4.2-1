}

[TEXTPART UsersExpand_Ministers JSONMETA]
{
  "Alias": "UsersExpand_Ministers",
  "Caption": "Министры",
  "Columns": [
    {
      "Alias": "ID",
      "Hidden": true,
      "Type": "$DepartmentRoles.ID"
    },
    {
      "Alias": "DepID",
      "Hidden": true,
      "Type": "$Roles.ID"
    },
    {
      "Alias": "DepName",
      "Caption": "Министерство",
      "SortBy": "DepName",
      "Type": "$Roles.Name"
    },
    {
      "Alias": "UserID",
      "Hidden": true,
      "Type": "$DepartmentRoles.HeadUserID"
    },
    {
      "Alias": "UserName",
      "Caption": "Министр",
      "Type": "$DepartmentRoles.HeadUserName"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "DepName",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "MultiSelect": true,
  "References": [
    {
      "CardType": "Roles",
      "ColPrefix": "Dep",
      "RefSection": [
        "Roles"
      ]
    },
    {
      "ColPrefix": "User",
      "IsCard": true,
      "RefSection": [
        "UsersExpand",
        "MyPersonalLists"
      ]
    }
  ]
}

[TEXTPART UsersExpand_Ministers MSSQL]


[TEXTPART UsersExpand_Ministers PGSQL]

SELECT 
	"dr"."ID",
	"r"."ID" as "DepID",
	"r"."Name" as "DepName",
	"dr"."HeadUserID" as "UserID",
	COALESCE("dr"."HeadUserName",'') as "UserName"
	
FROM
	"DepartmentRoles" as "dr"
LEFT JOIN "Roles" as "r" on "r"."ID" = "dr"."ID"
WHERE
	"r"."ParentID" is null 
	and ("r"."Name" like 'Министерство %' or "r"."Name" like 'Министр %')
	
order by #order_by
