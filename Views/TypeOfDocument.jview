}

[TEXTPART TypeOfDocument JSONMETA]
{
  "Alias": "TypeOfDocument",
  "Caption": "Вид документа",
  "Columns": [
    {
      "Alias": "TypeID",
      "Type": "$TypeOfDocument.ID"
    },
    {
      "Alias": "TypeName",
      "Caption": "Вид документа",
      "Type": "$TypeOfDocument.Name"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "TypeID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Multiple": false,
      "Type": "$TypeOfDocument.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "CardType": "RB_TypeOfDocument",
      "ColPrefix": "Type",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "TypeOfDocument"
      ]
