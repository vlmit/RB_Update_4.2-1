[TEXTPART TypeOfDocument MSSQL]


[TEXTPART TypeOfDocument PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "TypeOfDocument" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
