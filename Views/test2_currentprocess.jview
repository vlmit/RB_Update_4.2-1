{
  "Alias": "test2_currentprocess",
  "Caption": "текущие задачи по документу",
  "GroupName": "Custom",
  "ID": "74a8537a-6388-4de9-b243-395243fbbbc0",
  "JsonMetadataSource::txt": "test2_currentprocess JSONMETA",
  "MsQuerySource::txt": "test2_currentprocess MSSQL",
  "PgQuerySource::txt": "test2_currentprocess PGSQL"
}

[TEXTPART test2_currentprocess JSONMETA]
{
  "Alias": "test2_currentprocess",
  "Caption": "текущие задачи по документу",
  "Columns": [
    {
      "Alias": "NdsID",
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "MainCardID",
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "CurrentApprovalStageRowID",
      "Type": "$NDSRate.ID"
    },
    {
      "Alias": "ProcessOwnerName",
      "Caption": "RoleName",
      "Type": "$NDSRate.Rate"
    },
    {
      "Alias": "AuthorName",
      "Caption": "UserName",
      "Type": "$NDSRate.Rate"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "NdsID",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "QuickSearchParam": "Rate"
}

[TEXTPART test2_currentprocess MSSQL]


[TEXTPART test2_currentprocess PGSQL]
SELECT
	"pt"."ID"		AS "ID",
	"pt"."MainCardID"		AS "MainCardID",
	"pt"."CurrentApprovalStageRowID"		AS "CurrentApprovalStageRowID",
	"pt"."ProcessOwnerName"		AS "ProcessOwnerName",
	"pt"."AuthorName"		AS "AuthorName"
FROM "KrApprovalCommonInfo" AS "pt"

WHERE true --and "pt"."AccessLevelID" = 1
and "pt"."MainCardID"= 'b22ba403-dfa9-474e-b9fb-fc3185873640'

ORDER BY "pt"."ID"
