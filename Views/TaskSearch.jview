[TEXTPART TaskSearch MSSQL]


[TEXTPART TaskSearch PGSQL]
select
	"t"."ID",
	"ParentID",
	"RowID",
	"t"."TypeCaption",
	"Digest",
	"Created",
	"t"."AuthorName",
	"RoleName",
	"UserName"
from "Tasks" as "t"
where 
	"ID"='ef8a9b4b-a9a0-48df-914d-2171bc6f15fd'
	--"ParentID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
	--"RowID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
order by #order_by