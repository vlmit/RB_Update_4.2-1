{
  "Alias": "TaskSearch",
  "Caption": "Активные задачи документа",
  "GroupName": "Testing",
  "ID": "f71bc549-9041-4112-8398-955b43486550",
  "JsonMetadataSource::txt": "TaskSearch JSONMETA",
  "MsQuerySource::txt": "TaskSearch MSSQL",
  "PgQuerySource::txt": "TaskSearch PGSQL"
}

[TEXTPART TaskSearch JSONMETA]
{
  "Alias": "TaskSearch",
  "Caption": "Активные задачи документа",
  "Columns": [
    {
      "Alias": "ID",
      "Type": "$Tasks.ID"
    },
    {
      "Alias": "ParentID",
      "Type": "$Tasks.ParentID"
    },
    {
      "Alias": "RowID",
      "Type": "$Tasks.RowID"
    },
    {
      "Alias": "TypeCaption",
      "Localizable": true,
      "Type": "$Tasks.TypeCaption"
    },
    {
      "Alias": "Digest",
      "Localizable": true,
      "Type": "$Tasks.Digest"
    },
    {
      "Alias": "Created",
      "SortBy": "Created",
      "Type": "$Tasks.Created"
    },
    {
      "Alias": "AuthorName",
      "Type": "$Tasks.AuthorName"
    },
    {
      "Alias": "RoleName",
      "Caption": "Кому назначено",
      "Localizable": true,
      "Type": "$Tasks.RoleName"
    },
    {
      "Alias": "UserName",
      "Caption": "Кто взял в работу",
      "Type": "$Tasks.UserName"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "Created",
      "SortDirection": "Descending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5
}

[TEXTPART TaskSearch MSSQL]


[TEXTPART TaskSearch PGSQL]
select
	"t"."ID",
	"ParentID",
	"RowID",
	"t"."TypeCaption",
	"Digest",
	"Created",
	"t"."AuthorName",
	"RoleName",
	"UserName"
from "Tasks" as "t"
where 
	"ID"='ef8a9b4b-a9a0-48df-914d-2171bc6f15fd'
	--"ParentID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
	--"RowID"='0f6c9bff-eb97-4cae-a66f-3e14c0a5e166'
order by #order_by
