  "JsonMetadataSource::txt": "SubStateType JSONMETA",
  "MsQuerySource::txt": "SubStateType MSSQL",
  "PgQuerySource::txt": "SubStateType PGSQL"
}

[TEXTPART SubStateType JSONMETA]
{
  "Alias": "SubStateType",
  "Caption": "Подсостояния",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "Int16 Not Null"
    },
    {
      "Alias": "TypeName",
      "Caption": "Наименование",
      "Type": "$Partners.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$PartnersTypes.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "RefSection": [
        "SubStateTypes"
      ]
    }
  ]
}

[TEXTPART SubStateType MSSQL]


[TEXTPART SubStateType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "SubState" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
