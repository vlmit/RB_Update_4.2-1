{
  "Alias": "RBFiles",
  "Caption": "Список файлов",
  "Description": " ",
  "GroupName": "CustomFileList",
  "ID": "4d61d6bf-309e-4648-98dd-744e20ec4261",
  "JsonMetadataSource::txt": "RBFiles JSONMETA",
  "MsQuerySource::txt": "RBFiles MSSQL",
  "PgQuerySource::txt": "RBFiles PGSQL"
}

[TEXTPART RBFiles JSONMETA]
{
  "Alias": "RBFiles",
  "Caption": "Список файлов",
  "Columns": [
    {
      "Alias": "CardID",
      "Hidden": true,
      "Type": "String"
    },
    {
      "Alias": "FileName",
      "Caption": "Название файла",
      "Type": "String"
    },
    {
      "Alias": "FileID",
      "Caption": "ID файла",
      "Hidden": true,
      "SortBy": "t.Name",
      "Type": "String"
    },
    {
      "Alias": "Category",
      "Caption": "Категория",
      "Type": "String"
    },
    {
      "Alias": "Created",
      "Caption": "Добавлен",
      "Type": "String"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "Category",
      "SortDirection": "Descending"
    }
  ],
  "FormatVersion": 5,
  "MultiSelect": true,
  "Parameters": [
    {
      "Alias": "FileName",
      "Caption": "Имя файла",
      "Type": "nvarchar"
    },
    {
      "Alias": "CardID",
      "Caption": "CardID",
      "Hidden": true,
      "Type": "$Files.ID"
    },
    {
      "Alias": "CardTaskID",
      "Caption": "CardTaskID",
      "Hidden": true,
      "Type": "$Files.ID"
    }
  ],
  "QuickSearchParam": "FileName",
  "References": [
    {
      "ColPrefix": "File",
      "DisplayValueColumn": "FileName",
      "OpenOnDoubleClick": true,
      "RefSection": [
        "Files"
      ]
    }
  ]
}

[TEXTPART RBFiles MSSQL]


[TEXTPART RBFiles PGSQL]
select
    "t"."ID" as "CardID",
    "t"."Name" as "FileName",
    "t"."RowID" as "FileID",
    "t"."ModifiedByName" as "ModifiedBy",
    "t"."CategoryCaption" as "Category"
from "Files" as "t" 
where 1=1 
    #param_expr(FileName, "t"."Name")
    #if(CardID)
    {
    #param(CardID, "t"."ID")
    }
    {
		    #if(CardTaskID)
		    {
		    and "t"."ID" = (select "tsk"."ID" from "TaskHistory" as "tsk" 
		    			where 1=1 #param(CardTaskID, "tsk"."RowID") limit 1)
		    }
		    {
		    and 1=0
		    }
    }
order by "t"."CategoryCaption" desc, "t"."Name"
