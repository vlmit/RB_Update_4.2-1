[TEXTPART ControlStatusType MSSQL]


[TEXTPART ControlStatusType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "ControlStatus" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"