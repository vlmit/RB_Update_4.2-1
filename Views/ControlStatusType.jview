  "PgQuerySource::txt": "ControlStatusType PGSQL"
}

[TEXTPART ControlStatusType JSONMETA]
{
  "Alias": "ControlStatusType",
  "Caption": "Статус контроля",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "Int16 Not Null"
    },
    {
      "Alias": "TypeName",
      "Caption": "Наименование",
      "Type": "$Partners.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$PartnersTypes.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "RefSection": [
        "ControlStatusTypes"
      ]
    }
  ]
}

[TEXTPART ControlStatusType MSSQL]


[TEXTPART ControlStatusType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "ControlStatus" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
