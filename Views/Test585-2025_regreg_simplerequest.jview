[TEXTPART Test585-2025_regreg_simplerequest MSSQL]


[TEXTPART Test585-2025_regreg_simplerequest PGSQL]
SELECT
		"mi"."ID"																		AS "DocID",
		"mi"."FullNumber"																AS "DocNumber",
		
		CAST("mi"."DocDate" AS date)													AS "DocDate",
		
		(select "dci"."OutgoingNumber"
		from "DocumentCommonInfo" as "dci"
		JOIN "Instances" as "i"
		on "i"."ID" = "dci"."ID"
		where "i"."ID" = "mi"."ParentID")												AS "DocParent",
		
		(select "dci"."DocTypeTitle"
		from "DocumentCommonInfo" as "dci"
		JOIN "Instances" as "i"
		on "i"."ID" = "dci"."ID"
		where "i"."ID" = "mi"."ParentID")												AS "DocParentType",
		
		(select CAST("dci"."DocDate" as date)
		from "DocumentCommonInfo" as "dci"
		JOIN "Instances" as "i"
		on "i"."ID" = "dci"."ID"
		where "i"."ID" = "mi"."ParentID")												AS "DateParent",
		
		"mi"."Subject"																	AS "DocSubject",
		COALESCE("mi"."FullNumber", '') || ', ' || COALESCE("mi"."Subject", '')			AS "DocDescription",		
		
		"mi"."AuthorID"																			AS "AuthorID",
		
		"mi"."AuthorName"																			AS "AuthorName",
		'03'																			AS "regionid",
		
		(select "dci"."SignedT"
		from "DocumentCommonInfo" as "dci"
		JOIN "Instances" as "i"
		on "i"."ID" = "dci"."ID"
		where "i"."ID" = "mi"."ParentID")												AS "DocSignedT",
		
		"mi"."RegistratorID",
		"mi"."RegistratorName",
		"kr"."StateName"																AS "KrState",
		CAST(COALESCE("kr"."StateChangedDateTimeUTC", "mi"."CreationDate") AS date)		AS "KrStateModified",
		"mi"."PartnerName",
		
		(select "cr"."PartnersName"
		from "Correspondents" as "cr"
		JOIN "Instances" as "i"
		on "i"."ID" = "cr"."ID"
		JOIN "DocumentCommonInfo" as "dci"
		on "dci"."ID" = "i"."ID"
		where "i"."ID" = "mi"."ParentID")												AS "Correspondents",
		
        (SELECT string_agg("Performers"."UserName", ', ')
            FROM "Performers"
            WHERE "Performers"."ID" = "mi"."ID"
            ORDER BY string_agg ASC
        )                                                                                AS "Performers",
        (SELECT string_agg("Recipients"."UserName", ', ')
            FROM "Recipients"
            WHERE "Recipients"."ID" = "mi"."ID"
            ORDER BY string_agg ASC
        )                                                                                AS "Recipients",
        "mi"."DeliveryTypeID",
        "mi"."DeliveryTypeName",
		CAST("mi"."CreationDate" AS date)												AS "CreationDate",
		"mi"."TaskDeadline"																AS "TaskDeadline",
		"mi"."TaskFact"																	AS "TaskFact",
		"mi"."DepartmentName"															AS "Department",
		"mi"."DocTypeTitle",
		"kr"."ApprovedBy",
		"kr"."DisapprovedBy",
		'#appearance(Background: ' || CASE
			WHEN ("kr"."StateID" = 1 OR "kr"."StateID" = 10) AND "kr"."DisapprovedBy" IS NOT NULL AND "kr"."DisapprovedBy" <> ''	
				THEN '#70FF0000'
			WHEN "kr"."StateID" = 2 OR "kr"."StateID" = 6 OR "kr"."StateID" = 8														
				THEN '#7000FF00'
			WHEN "kr"."StateID" = 4																									
				THEN '#70FFFF00'
			ELSE '#00000000'																										
		END || ')'																		AS "Background",
		0::int8																			AS "rn"
		
		
	FROM (
		SELECT
			
			"t"."ID"
			
		FROM (
			SELECT "ID"
			FROM "DocumentCommonInfo" AS "mi"
			where "mi"."ID" != '1826344c-904c-48d7-b604-e46bbb318175'
			) AS "t"
			
		INNER JOIN "DocumentCommonInfo" AS "mi"
			ON "mi"."ID" = "t"."ID"
		
		LEFT JOIN "KrApprovalCommonInfo" AS "kr"
			ON "kr"."MainCardID" = "t"."ID"
		
		
				LEFT JOIN "DocumentCommonInfo" as "dci"
				ON "dci"."ID" = "t"."ID"
				LEFT JOIN "Instances" AS "i"
			ON "i"."ID" = "t"."ID"
		WHERE true
		AND (( "mi"."AuthorID" = '3d728b5d-7ac3-4beb-8bd1-879f2de55624' ))
			
		ORDER BY "mi"."DocDate" desc 
		) AS "t"
INNER JOIN "DocumentCommonInfo" AS "mi"
	ON "mi"."ID" = "t"."ID"
INNER JOIN "Types" AS "tt"
	ON "tt"."ID" = "mi"."CardTypeID"
LEFT JOIN "KrApprovalCommonInfo" AS "kr"
	ON "kr"."MainCardID" = "t"."ID"
ORDER BY "mi"."DocDate" desc 
LIMIT 100;
