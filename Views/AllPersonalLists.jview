[TEXTPART AllPersonalLists MSSQL]


[TEXTPART AllPersonalLists PGSQL]
SELECT
#if(Normal) {
	pl."ID" as "PLID",
    pl."Title" as "PLTitle",
    pl."OwnerID" as "PLOwnerID",
    pl."OwnerName" as "PLOwnerName",
    CASE 
    WHEN "Status" = false 
    	THEN 'Активна'
    	ELSE 'Не активна'
    END AS "PLStatus"
}
#if(Count) { 
	COUNT(*) as cnt
}

FROM "PersonalList" as pl
WHERE 1=1
#param(Title, pl."Title")
#param(Owner, pl."OwnerID")
#if(CheckLinkedStatic) { 
	AND pl."LinkedStaticRoleID" is null
}

#if(!Status) { 
	AND "Status" = false --OR "Status" = true
}
#if(Normal) { 
order by #order_by} 

#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit);
}