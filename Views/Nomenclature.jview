[TEXTPART Nomenclature MSSQL]


[TEXTPART Nomenclature PGSQL]
SELECT
	#if(Normal) {
	"t"."ID"						AS "NomenclatureID",
	"t"."DepartmentName",
	"t"."Index"						AS "NomenclatureIndex",
	"t"."Name" 						AS "NomenclatureName",
	"t"."Article",
	"t"."Duration",
	"t"."Year",
	"t"."Name"				AS "NomenclatureDescription"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
FROM "Nomenclature" AS "t"
WHERE true 
and
("t"."DepartmentName" like '%' || 
(select "pr"."Name" from "Roles" as "pr"
inner join "DepartmentRoles" as "ru" on "ru"."ID"= "pr"."ID"
inner join "RoleUsers" as "ruru" on "ruru"."ID"= "ru"."ID"
where "ruru"."UserID" = #param(CurrentUserID) 
and "pr"."Name" is not null 
and "ruru"."IsDeputy" = false
and ("pr"."HeadID" = 'ea098516-6c1d-4e2f-a28d-f5251e758bda' or
	 "pr"."HeadID" = 'fe61bbb1-183f-4ceb-b227-2c4de8c0f318')
limit 1) || '%'
or
"t"."DepartmentName" like '%' || 
(select "pr"."HeadName" from "Roles" as "pr"
inner join "DepartmentRoles" as "ru" on "ru"."ID"= "pr"."ID"
inner join "RoleUsers" as "ruru" on "ruru"."ID"= "ru"."ID"
where "ruru"."UserID" = #param(CurrentUserID) 
and "pr"."Name" is not null 
and "ruru"."IsDeputy" = false
and "pr"."HeadID" != 'ea098516-6c1d-4e2f-a28d-f5251e758bda'
and "pr"."HeadID" != 'fe61bbb1-183f-4ceb-b227-2c4de8c0f318'
limit 1) || '%')
	#param(NomenclatureID, "t"."ID")
	#param(DepartmentName, "t"."DepartmentName")
	#param(NomenclatureIndex, "t"."Index")
	#param(Header, "t"."Name")
	--and (TRUE #param(Name, "t"."Name")) or (TRUE #param(Name, "t"."Index"))
	#param(Article, "t"."Article")
	#param(Duration, "t"."Duration")
	#if(Year) {AND (true #param(Year, "t"."Year"))} {AND "t"."Year" = EXTRACT('YEAR' FROM CURRENT_DATE)}
	#param(NomenclatureDescription, "t"."Index")
#if(Normal) {
ORDER BY #order_by
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}