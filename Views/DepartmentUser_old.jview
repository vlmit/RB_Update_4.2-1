[TEXTPART DepartmentUser_old MSSQL]


[TEXTPART DepartmentUser_old PGSQL]
--версия с рекурсивным проходом подразделений
with recursive par_nam("ID", "Name") as (
	select "ID", "Name" from "Roles" where "ParentID" is null
	union all
	select "r"."ID","p"."Name" || '/' || "r"."Name"
	from "Roles" as "r", par_nam as "p" 
	where "r"."ParentID"="p"."ID" 	
),
dep_nam("ID", "ParentID", "HeadID") as (
	select "ID", "ParentID", "HeadID" from "Roles" --where "ParentID" is null
	#if(DeptID) { where 
	("ID"=#param(DeptID) or "ParentID"=#param(DeptID) or "HeadID"=#param(DeptID))
	}
	union 
	select "r"."ID", "r"."ParentID", "r"."HeadID" from "Roles" as "r", dep_nam as "d"
	where ("r"."ParentID"="d"."ID" or "r"."HeadID"="d"."ID") 
	
)

select
	#if(Normal) {   
	"r"."ID",
	"r"."HeadID",
	"r"."HeadName",
	"r"."ParentID",
	(select "Name" from par_nam as "pn" where "pn"."ID"="r"."ParentID"),
	"r"."Name",
	"pr"."FullName",
	"pr"."Login",
	"pr"."Position"
	}
	#if(Count) {
	Count(*)
	} 
from
	"PersonalRoles" as "pr",
	"Roles" as "r",
	"RoleUsers" as "ru"
where
	"r"."ID"="ru"."ID"
	and "pr"."ID"="ru"."UserID"
	and "r"."Hidden"=false
	and "pr"."Blocked"=false
	and "pr"."Login" is not null
	#if(DeptID) { 
	and "r"."ID" in (select "ID" from dep_nam )
	}
	{and "r"."ID" is null}
	--#param(DepID, "r"."ID")
	#param(ParentDepID, "r"."ParentID")
#if(Normal) { 
order by #order_by --"r"."HeadName", "r"."ParentName", "r"."Name", "pr"."FullName"
}
 

