[TEXTPART MEDODSP PGSQL]
SELECT
	"pt"."ID"		AS "DSPID",
	"pt"."DSP"		AS "DSPDSP"
FROM "MEDODSP" AS "pt"

WHERE true
	#param(Name, "pt"."DSP")
ORDER BY "pt"."ID"