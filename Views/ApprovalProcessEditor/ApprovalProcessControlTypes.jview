[TEXTPART ApprovalProcessControlTypes JSONMETA]
{
  "Alias": "ApprovalProcessControlTypes",
  "Caption": "$Views_Names_ApprovalProcessControlTypes",
  "Columns": [
    {
      "Alias": "ControlTypeID",
      "Hidden": true,
      "Type": "$ApprovalProcessControlTypes.ID"
    },
    {
      "Alias": "ControlTypeName",
      "Caption": "$Views_ApprovalProcessControlTypes_Name",
      "FilterParameter": "Name",
      "FilterType": "Parameter",
      "Localizable": true,
      "SortBy": "lName.Value",
      "Type": "$ApprovalProcessControlTypes.Name"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "ControlTypeName",
      "SortDirection": "Ascending"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "$Views_ApprovalProcessControlTypes_Name_Param",
      "Multiple": false,
      "Type": "$ApprovalProcessControlTypes.Name"
    }
  ],
  "References": [
    {
      "ColPrefix": "ControlType",
      "DisplayValueColumn": "ControlTypeName",
      "RefSection": [
        "ApprovalProcessControlTypes"
      ]
    }
  ],
  "TreatAsSingleQuery": true
}

[TEXTPART ApprovalProcessControlTypes MSSQL]
SELECT
	[ct].[ID] AS [ControlTypeID],
	[ct].[Name] AS [ControlTypeName]
FROM [ApprovalProcessControlTypes] AS [ct] WITH(NOLOCK)
#if(Name || request.SortedBy("ControlTypeName")) {
CROSS APPLY [Localization]([ct].[Name], #param(locale)) AS [lName]
}
WHERE 1 = 1
	#param(Name, [lName].[Value])
ORDER BY #order_by


[TEXTPART ApprovalProcessControlTypes PGSQL]
SELECT
	"ct"."ID" 	AS "ControlTypeID",
	"ct"."Name" AS "ControlTypeName"
FROM "ApprovalProcessControlTypes" AS "ct"
#if(Name || request.SortedBy("ControlTypeName")) {
CROSS JOIN "Localization"("ct"."Name", #param(locale)) AS "lName"
}
WHERE true
	#param(Name, "lName"."Value")
ORDER BY #order_by