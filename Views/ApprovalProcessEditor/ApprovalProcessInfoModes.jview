[TEXTPART ApprovalProcessInfoModes JSONMETA]
{
  "Alias": "ApprovalProcessInfoModes",
  "Caption": "$Views_Names_ApprovalProcessInfoModes",
  "Columns": [
    {
      "Alias": "InfoModeID",
      "Hidden": true,
      "Type": "$ApprovalProcessInfoModes.ID"
    },
    {
      "Alias": "InfoModeName",
      "Caption": "$Views_ApprovalProcessInfoModes_Name",
      "FilterParameter": "Name",
