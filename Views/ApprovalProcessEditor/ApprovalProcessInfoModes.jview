[TEXTPART ApprovalProcessInfoModes MSSQL]
SELECT
	[ct].[ID]	AS [InfoModeID],
	[ct].[Name]	AS [InfoModeName]
FROM [ApprovalProcessInfoModes] AS [ct] WITH(NOLOCK)
#if(Name || request.SortedBy("InfoModeName")) {
CROSS APPLY [Localization]([ct].[Name], #param(locale)) AS [lName]
}
WHERE 1 = 1
	#param(Name, [lName].[Value])
ORDER BY #order_by

[TEXTPART ApprovalProcessInfoModes PGSQL]
SELECT
	"ct"."ID"	AS "InfoModeID",
	"ct"."Name"	AS "InfoModeName"
FROM "ApprovalProcessInfoModes" AS "ct"
#if(Name || request.SortedBy("InfoModeName")) {
CROSS JOIN "Localization"("ct"."Name", #param(locale)) AS "lName"
}
WHERE true
	#param(Name, "lName"."Value")
ORDER BY #order_by