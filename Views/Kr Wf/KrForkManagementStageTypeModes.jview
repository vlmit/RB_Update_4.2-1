[TEXTPART KrForkManagementStageTypeModes MSSQL]
SELECT
	[a].[ID]		AS [RefID],
	[a].[Name]		AS [RefName]
FROM [KrForkManagementModes] AS [a] WITH (NOLOCK)
#if(Name) {
CROSS APPLY [Localization]([a].[Name], #param(locale)) AS [l]
}
WHERE 1 = 1
	#param(Name, [l].[Value])
ORDER BY [a].[ID]


[TEXTPART KrForkManagementStageTypeModes PGSQL]
SELECT
	"a"."ID"		AS "RefID",
	"a"."Name"		AS "RefName"
FROM "KrForkManagementModes" AS "a"
#if(Name) {
CROSS JOIN "Localization"("a"."Name", #param(locale)) AS "l"
}
WHERE true
	#param(Name, "l"."Value")
ORDER BY "a"."ID"