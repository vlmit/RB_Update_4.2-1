  "PgQuerySource::txt": "KrTypes PGSQL"
}

[TEXTPART KrTypes JSONMETA]
{
  "Alias": "KrTypes",
  "Caption": "$Views_Names_KrTypes",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$Types.ID"
    },
    {
      "Alias": "DocTypeID",
      "Hidden": true,
      "Type": "$KrDocType.ID"
    },
    {
      "Alias": "DocTypeCaption",
      "Hidden": true,
      "Type": "$KrDocType.Title"
    },
    {
      "Alias": "TypeCaption",
      "Caption": "$Views_KrTypes_Name",
      "FilterParameter": "Caption",
