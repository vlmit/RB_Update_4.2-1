[TEXTPART KrFilteredStageTypes JSONMETA]
{
  "Alias": "KrFilteredStageTypes",
  "Caption": "$Views_Names_KrFilteredStageTypes",
  "Columns": [
    {
      "Alias": "StageTypeID",
      "Hidden": true,
      "Type": "$KrProcessStageTypes.ID"
