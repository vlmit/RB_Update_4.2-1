[TEXTPART KrFilteredStageTypes MSSQL]
SELECT
	[t].[ID] AS [StageTypeID],
	[t].[Caption] AS [StageTypeCaption],
	[t].[DefaultStageName] AS [StageTypeDefaultStageName]
FROM [KrProcessStageTypes] AS [t] WITH (NOLOCK)
#if (request.SortedBy("StageTypeCaption")) {
CROSS APPLY [Localization]([t].[Caption], #param(locale)) AS [locCaption]
}
#if(!IsTemplate) {
WHERE EXISTS (
	SELECT NULL
	FROM [KrSettingsRouteRoles] AS [r] WITH (NOLOCK)
	INNER JOIN [KrSettingsRouteStageGroups] AS [asg] WITH (NOLOCK) ON [asg].[ParentRowID] = [r].[ParentRowID] #param(StageGroupIDParam, [asg].[StageGroupID])
	INNER JOIN [KrSettingsRouteDocTypes] AS [act] WITH(NOLOCK) ON [act].[ParentRowID] = [r].[ParentRowID] #param(TypeId, [act].[CardTypeID])
	INNER JOIN [KrSettingsRouteStageTypes] AS [ast] WITH(NOLOCK) ON [ast].[ParentRowID] = [r].[ParentRowID] AND [ast].[StageTypeID] = [t].[ID]
	LEFT JOIN  [NestedRoles] AS [nr] WITH (NOLOCK) ON [nr].[ParentID] = [r].[StageRolesID] #param(TypeId, [nr].[ContextID])
	INNER JOIN [RoleUsers] AS [ru] WITH (NOLOCK) ON ([ru].[ID] = [r].[StageRolesID] OR [ru].[ID] = [nr].[ID]) #param(CurrentUserID, [ru].[UserID]))
}
ORDER BY #order_by


[TEXTPART KrFilteredStageTypes PGSQL]
SELECT
	"t"."ID" AS "StageTypeID",
	"t"."Caption" AS "StageTypeCaption",
	"t"."DefaultStageName" AS "StageTypeDefaultStageName"
FROM "KrProcessStageTypes" AS "t"
#if (request.SortedBy("StageTypeCaption")) {
CROSS JOIN "Localization"("t"."Caption", #param(locale)) AS "locCaption"
}
 #if(!IsTemplate) {
WHERE EXISTS (
	SELECT NULL
	FROM "KrSettingsRouteRoles" AS "r"
	INNER JOIN "KrSettingsRouteStageGroups" AS "asg" ON "asg"."ParentRowID" = "r"."ParentRowID" #param(StageGroupIDParam, "asg"."StageGroupID")
	INNER JOIN "KrSettingsRouteDocTypes" AS "act" ON "act"."ParentRowID" = "r"."ParentRowID" #param(TypeId, "act"."CardTypeID")
	INNER JOIN "KrSettingsRouteStageTypes" AS "ast" ON "ast"."ParentRowID" = "r"."ParentRowID" AND "ast"."StageTypeID" = "t"."ID"
	LEFT JOIN  "NestedRoles" AS "nr" ON "nr"."ParentID" = "r"."StageRolesID" #param(TypeId, "nr"."ContextID")
	INNER JOIN "RoleUsers" AS "ru" ON ("ru"."ID" = "r"."StageRolesID" OR "ru"."ID" = "nr"."ID") #param(CurrentUserID, "ru"."UserID"))
}
ORDER BY #order_by