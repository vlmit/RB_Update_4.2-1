[TEXTPART MyPersonalLists MSSQL]


[TEXTPART MyPersonalLists PGSQL]
SELECT
#if(Normal) {
	pl."ID" as "PLID",
    pl."Title" as "PLTitle",
    CASE 
    WHEN "Status" = false 
    	THEN 'Активен'
    	ELSE 'Не активен'
    END AS "PLStatus",
    "LinkedStaticRoleID"
    }
#if(Count) { 
	COUNT(*) as cnt
}

FROM "PersonalList" as pl
WHERE 1=1
and pl."LinkedStaticRoleID" is not null
#param(Title, pl."Title")
#param(Status, pl."Status")
--and "LinkedStaticRoleID" != null
AND "OwnerID" = #param(CurrentUserID)
