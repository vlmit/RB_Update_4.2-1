[TEXTPART Control Tasks - Tasks MSSQL]


[TEXTPART Control Tasks - Tasks PGSQL]
select
	"dci"."ID" as "ID",
	"FullNumber",
	"CategoryName",
	"ManualStateID",
	"ManualStateName",
	"dci"."ParentID" as "ParentID",
	"ParentDescription",
	"TypeCaption",
	"StateID",
	"ts"."Name" as "StateName",
	"Digest",
	"RoleName"
from
	"DocumentCommonInfo" as "dci",
	"Tasks" as "t",
	"TaskStates" as "ts"
where
	"CardTypeID"='01ad498e-5f8e-417a-bd28-942739dbf342'
	and "dci"."ParentID"="t"."ID"
	and "t"."StateID"="ts"."ID"
	--and "dci"."ParentID"='c53782bd-5b3d-4910-8fe5-516d56a3b5c1'
	#param(ManualStateID, "ManualStateID")
limit 30