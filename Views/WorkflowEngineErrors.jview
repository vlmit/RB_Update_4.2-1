[TEXTPART WorkflowEngineErrors JSONMETA]
{
  "Alias": "WorkflowEngineErrors",
  "Caption": "$Views_Names_WorkflowEngineErrors",
  "Columns": [
    {
      "Alias": "ProcessErrorID",
      "Hidden": true,
      "Type": "$WorkflowEngineErrors.ErrorCardID"
    },
    {
      "Alias": "ProcessErrorAdded",
      "Caption": "$Views_WorkflowEngineErrors_Added",
      "FilterParameter": "Added",
      "FilterType": "Parameter",
      "SortBy": "wee.Added",
      "Type": "$WorkflowEngineErrors.Added"
    },
    {
      "Alias": "ProcessErrorText",
      "Caption": "$Views_WorkflowEngineErrors_ErrorText",
      "Type": "$Errors.Text"
    },
    {
      "Alias": "ProcessNodeInstanceID",
      "Hidden": true,
      "Type": "$WorkflowEngineErrors.NodeRowID"
    },
    {
      "Alias": "ProcessNodeID",
      "Hidden": true,
      "Type": "$WorkflowEngineNodes.NodeID"
    },
    {
      "Alias": "ProcessIsAsync",
      "Hidden": true,
      "Type": "$WorkflowEngineErrors.IsAsync"
    },
    {
      "Alias": "ProcessResumable",
      "Hidden": true,
      "Type": "$WorkflowEngineErrors.Resumable"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "ProcessErrorAdded",
      "SortDirection": "Ascending"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Added",
      "Caption": "$Views_WorkflowEngineErrors_Added_Param",
      "Type": "$WorkflowEngineErrors.Added"
    },
    {
      "Alias": "ProcessInstance",
      "Caption": "$Views_WorkflowEngineErrors_Process_Param",
      "Hidden": true,
      "Multiple": false,
      "Type": "$WorkflowEngineNodes.ProcessRowID"
    },
