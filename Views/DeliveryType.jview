{
  "Alias": "DeliveryType",
  "Caption": "Тип доставки",
  "GroupName": "Custom",
  "ID": "97a90280-5df4-4456-9c8d-ed46a33a0469",
  "JsonMetadataSource::txt": "DeliveryType JSONMETA",
  "MsQuerySource::txt": "DeliveryType MSSQL",
  "PgQuerySource::txt": "DeliveryType PGSQL"
}

[TEXTPART DeliveryType JSONMETA]
{
  "Alias": "DeliveryType",
  "Caption": "Тип доставки",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$Partners.ID"
    },
    {
      "Alias": "TypeName",
      "Caption": "Наименование",
      "Type": "$Partners.Name"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$PartnersTypes.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "DeliveryTypes"
      ]
    }
  ]
}

[TEXTPART DeliveryType MSSQL]


[TEXTPART DeliveryType PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName"
FROM "DeliveryType" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"
