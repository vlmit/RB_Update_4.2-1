[TEXTPART ProjectQuality MSSQL]


[TEXTPART ProjectQuality PGSQL]
SELECT
	"pt"."ID"		AS "RID",
	"pt"."Name"		AS "RName"
FROM "ProjectQuality" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."ID"