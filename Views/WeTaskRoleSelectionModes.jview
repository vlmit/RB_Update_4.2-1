[TEXTPART WeTaskRoleSelectionModes MSSQL]
SELECT
	[sm].[ID] as [SelectionModeID]
	,[sm].[Name] as [SelectionModeName]
FROM [WeTaskRoleSelectionModes] [sm] WITH(NOLOCK)
#if(Name || request.SortedBy("SelectionModeName")) {
CROSS APPLY [Localization]([sm].[Name], #param(locale)) AS [lName]
}
WHERE 1 = 1
	#param(Name, [lName].[Value])


[TEXTPART WeTaskRoleSelectionModes PGSQL]
SELECT
	"sm"."ID" as "SelectionModeID"
	,"sm"."Name" as "SelectionModeName"
FROM "WeTaskRoleSelectionModes" "sm"
#if(Name || request.SortedBy("SelectionModeName")) {
CROSS JOIN "Localization"("sm"."Name", #param(locale)) AS "lName"
}
WHERE true
	#param(Name, "lName"."Value")