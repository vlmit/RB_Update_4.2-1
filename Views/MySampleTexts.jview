{
  "Alias": "MySampleTexts",
  "Caption": "Мои типовые тексты",
  "GroupName": "Junicsoft",
  "ID": "284034f7-ea99-41fa-82d6-8d9161f34d17",
  "JsonMetadataSource::txt": "MySampleTexts JSONMETA",
  "MsQuerySource::txt": "MySampleTexts MSSQL",
  "PgQuerySource::txt": "MySampleTexts PGSQL"
}

[TEXTPART MySampleTexts JSONMETA]
{
  "Alias": "MySampleTexts",
  "Caption": "Мои типовые тексты",
  "Columns": [
    {
      "Alias": "STID",
      "Hidden": true,
      "Type": "$SampleText.ID"
    },
    {
      "Alias": "STText",
      "Caption": "Текст",
      "MaxLength": 255,
      "Type": "$SampleText.Text"
    },
    {
      "Alias": "STAuthorID",
      "Hidden": true,
      "Type": "$SampleText.AuthorID"
    },
    {
      "Alias": "STAuthorName",
      "Caption": "Автор",
      "Type": "$SampleText.AuthorName"
    },
    {
      "Alias": "STStatus",
      "Caption": "Статус",
      "Type": "String(Max) Not Null"
    }
  ],
  "EnableAutoWidth": true,
  "Extensions": [
    {
      "Data": {
        "CardCreationKind": "ByTypeAlias",
        "CardOpeningKind": "ApplicationTab",
        "DocTypeIdentifier": null,
        "IDParam": null,
        "TypeAlias": "SampleText"
      },
      "Order": 0,
      "TypeName": "Tessa.Extensions.Default.Client.Views.CreateCardExtension"
    }
  ],
  "FormatVersion": 5,
  "Paging": "Always",
  "Parameters": [
    {
      "Alias": "Text",
      "Caption": "Текст",
      "Multiple": false,
      "Type": "$SampleText.Text"
    }
  ],
  "QuickSearchParam": "Text",
  "References": [
    {
      "ColPrefix": "ST",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "SampleText"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count",
      "CountColumn": "cnt",
      "HideZeroCount": true
    }
  ]
}

[TEXTPART MySampleTexts MSSQL]


[TEXTPART MySampleTexts PGSQL]
SELECT
#if(Normal) {
	st."ID" as "STID",
    st."Text" as "STText",
    st."AuthorID" as "STAuthorID",
    st."AuthorName" as "STAuthorName",
    CASE 
    WHEN "Status" = false 
    	THEN 'Активен'
    	ELSE 'Не активен'
    END AS "STStatus"
    }
#if(Count) { 
	COUNT(*) as cnt
}

FROM "SampleText" as st
WHERE 1=1
AND
st."AuthorID" = #param(CurrentUserID)
#param(Text, st."Text")
