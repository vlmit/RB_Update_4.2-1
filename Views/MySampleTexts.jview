[TEXTPART MySampleTexts MSSQL]


[TEXTPART MySampleTexts PGSQL]
SELECT
#if(Normal) {
	st."ID" as "STID",
    st."Text" as "STText",
    st."AuthorID" as "STAuthorID",
    st."AuthorName" as "STAuthorName",
    CASE 
    WHEN "Status" = false 
    	THEN 'Активен'
    	ELSE 'Не активен'
    END AS "STStatus"
    }
#if(Count) { 
	COUNT(*) as cnt
}

FROM "SampleText" as st
WHERE 1=1
AND
st."AuthorID" = #param(CurrentUserID)
#param(Text, st."Text")