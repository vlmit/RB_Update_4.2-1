  "JsonMetadataSource::txt": "DocTypeMEDO JSONMETA",
  "MsQuerySource::txt": "DocTypeMEDO MSSQL",
  "PgQuerySource::txt": "DocTypeMEDO PGSQL"
}

[TEXTPART DocTypeMEDO JSONMETA]
{
  "Alias": "DocTypeMEDO",
  "Caption": "Вид документа МЭДО",
  "Columns": [
    {
      "Alias": "TypeID",
      "Hidden": true,
      "Type": "$Partners.ID"
    },
    {
      "Alias": "TypeName",
      "Caption": "Наименование",
      "SortBy": "\"pt\".\"Name\"",
      "Type": "$Partners.Name"
    },
    {
      "Alias": "TypeIndex",
      "Caption": "Индекс",
      "SortBy": "\"pt\".\"Index\"",
      "Type": "$Partners.Name"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "TypeName",
      "SortDirection": "Descending"
    }
  ],
  "FormatVersion": 5,
  "Parameters": [
    {
      "Alias": "Name",
      "Caption": "Наименование",
      "Multiple": false,
      "Type": "$PartnersTypes.Name"
    }
  ],
  "QuickSearchParam": "Name",
  "References": [
    {
      "ColPrefix": "Type",
      "DisplayValueColumn": "TypeName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "DocTypesMEDO"
      ]
    }
  ]
}

[TEXTPART DocTypeMEDO MSSQL]


[TEXTPART DocTypeMEDO PGSQL]
SELECT
	"pt"."ID"		AS "TypeID",
	"pt"."Name"		AS "TypeName",
	"pt"."Index"	AS "TypeIndex"
FROM "DocTypeMEDO" AS "pt"

WHERE true
	#param(Name, "pt"."Name")
ORDER BY "pt"."Name"
