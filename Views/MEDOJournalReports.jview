[TEXTPART MEDOJournalReports MSSQL]


[TEXTPART MEDOJournalReports PGSQL]
SELECT
	"pt"."ID"					AS "ReportID",
	"pt"."CardID"				AS "CardID",
	"pt"."PartnersID"			AS "PartnersID",
	"pt"."PartnersName"			AS "PartnersName",
	"pt"."DateOfReceiving"		AS "DateOfReceiving",
	"pt"."Comment"				AS "Comment",
	"pt"."Status"				AS "Status",
	"pt"."RegNum"				AS "RegNum"
	
FROM "MEDOJournalReports" AS "pt"

WHERE true
	#param(CardID, "pt"."CardID")
order by #order_by
