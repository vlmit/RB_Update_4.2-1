  "JsonMetadataSource::txt": "AllActiveSessions-Licenses JSONMETA",
  "MsQuerySource::txt": "AllActiveSessions-Licenses MSSQL",
  "PgQuerySource::txt": "AllActiveSessions-Licenses PGSQL"
}

[TEXTPART AllActiveSessions-Licenses JSONMETA]
{
  "Alias": "AllActiveSessions-Licenses",
  "Caption": "все сессии использующие лицензии",
  "Columns": [
    {
      "Alias": "UserName",
      "Caption": "Пользователь",
      "Type": "$Sessions.UserName"
    }
  ],
  "DefaultSortColumns": [
    {
      "Alias": "UserName",
      "SortDirection": "Ascending"
    }
  ],
  "EnableAutoWidth": true,
  "FormatVersion": 5,
  "Paging": "Always",
  "References": [
    {
      "ColPrefix": "User",
      "DisplayValueColumn": "UserName",
      "IsCard": true,
      "OpenOnDoubleClick": true,
      "RefSection": [
        "MultiSessions"
      ]
    }
  ],
  "RowCountSubset": "Count",
  "Subsets": [
    {
      "Alias": "Count",
      "CountColumn": "count"
    }
  ]
}

[TEXTPART AllActiveSessions-Licenses MSSQL]


[TEXTPART AllActiveSessions-Licenses PGSQL]
select
	#if(Normal) { 
	 
	"UserName"}
	#if(Count) { 
	count(*)  as "cnt"} 
	
from
	"Sessions"
where
	"IsActive"=true
 and "LastActivity" > now()-interval '1 hour'
 
#if(Normal) { 
group by  "UserName"
order by  "UserName"}

#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}
