<UserControl x:Class="Tessa.Extensions.Default.Client.AbTest.AbCustomFolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tuim="Tessa.UI.Markup"
             xmlns:tuiv="Tessa.UI.Views"
             d:DesignHeight="300"
             d:DesignWidth="300"
             Background="{tuim:ThemeResource WorkplaceTreeBackground,
                                             ConvertTo=Brush}"
             mc:Ignorable="d">
    <tuiv:CompositeContentControl HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Items="{Binding Header.Content,
                                                  Mode=OneWay,
                                                  UpdateSourceTrigger=PropertyChanged}">
        <tuiv:CompositeContentControl.LayoutTransform>
            <ScaleTransform CenterX="0" CenterY="0" ScaleX="5" ScaleY="5" />
        </tuiv:CompositeContentControl.LayoutTransform>
    </tuiv:CompositeContentControl>
</UserControl>
