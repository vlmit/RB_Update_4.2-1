<UserControl x:Class="Tessa.Extensions.Default.Client.UI.TaskHistory.TaskHistoryViewDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tuim="Tessa.UI.Markup"
             AutomationProperties.AutomationId="TaskHistoryViewDetails"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="23" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{tuim:ThemeResource CardDisabledBackground, ConvertTo=Brush}" />
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ItemsControl Grid.Row="0"
                          Grid.Column="0"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding LeftRow,
                                                Mode=OneTime}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="5,2,5,2"
                                       AutomationProperties.AutomationId="{Binding AutomationId,
                                                                                   StringFormat={}{0}:Header}"
                                       Foreground="{tuim:ThemeResource CardControlCaption}"
                                       Text="{Binding Caption,
                                                      Mode=OneTime}"
                                       TextWrapping="Wrap" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="5,2,25,2"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="{Binding AutomationId,
                                                                                 StringFormat={}{0}:Value}"
                                     Text="{Binding Text,
                                                    Mode=OneTime}"
                                     TextWrapping="Wrap" />
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl Grid.Row="0"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          ItemsSource="{Binding RightRow,
                                                Mode=OneTime}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="25,2,5,2"
                                       AutomationProperties.AutomationId="{Binding AutomationId,
                                                                                   StringFormat={}{0}:Header}"
                                       Foreground="{tuim:ThemeResource CardControlCaption}"
                                       Text="{Binding Caption,
                                                      Mode=OneTime}"
                                       TextWrapping="Wrap" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="5,2,5,2"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="{Binding AutomationId,
                                                                                 StringFormat={}{0}:Value}"
                                     Text="{Binding Text,
                                                    Mode=OneTime}"
                                     TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ItemsControl Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top"
                          VerticalContentAlignment="Top"
                          ItemsSource="{Binding BottomElements,
                                                Mode=OneTime}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Margin="5,12,5,2"
                                       AutomationProperties.AutomationId="{Binding AutomationId,
                                                                                   StringFormat={}{0}:Header}"
                                       Foreground="{tuim:ThemeResource CardControlCaption}"
                                       Text="{Binding Caption,
                                                      Mode=OneTime}" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="0"
                                     Height="Auto"
                                     Margin="5,2,5,2"
                                     Padding="2"
                                     HorizontalAlignment="Stretch"
                                     AutomationProperties.AutomationId="{Binding AutomationId,
                                                                                 StringFormat={}{0}:Value}"
                                     Text="{Binding Text,
                                                    Mode=OneTime}"
                                     TextWrapping="Wrap" />
                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
