<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tedcuith="clr-namespace:Tessa.Extensions.Default.Client.UI.TaskHistory"
                    xmlns:views="clr-namespace:Tessa.Extensions.Default.Client.Views"
                    xmlns:viewsss="clr-namespace:Tessa.Extensions.Default.Client.Views.StageSelector">

    <DataTemplate DataType="{x:Type views:CreateCardExtensionViewModel}">
        <views:CreateCardExtensionView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type views:CreateCardCopyExtensionViewModel}">
        <views:CreateCardCopyExtensionView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewsss:StageSelectorViewModel}">
        <viewsss:StageSelectorView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type views:AddTagButtonViewExtensionViewModel}">
        <views:AddTagButtonViewExtensionView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type views:HelpViewExtensionViewModel}">
        <views:HelpViewExtensionView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tedcuith:TaskHistoryViewDetailsViewModel}">
        <tedcuith:TaskHistoryViewDetailsView />
    </DataTemplate>

</ResourceDictionary>
